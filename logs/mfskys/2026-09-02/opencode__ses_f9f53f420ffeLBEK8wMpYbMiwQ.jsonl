{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":34,"role":"tool","ts":"2026-09-02T05:54:15.197Z","tool_name":"read","tool_call_id":"call_6757b6c001264ede8c508d3d","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\web\\index.html"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\web\\index.html</path>\n<type>file</type>\n<content>\n1: <!DOCTYPE html>\n2: <html lang=\"zh-CN\">\n3: <head>\n4: <meta charset=\"UTF-8\">\n5: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6: <title>登录 · AI 眼睛助手</title>\n7: <style>\n8: *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\n9: body{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f8fafc;-webkit-font-smoothing:antialiased}\n10: .wrap{width:100%;max-width:380px;padding:20px}\n11: .card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 1px 3px rgba(0,0,0,.04),0 4px 20px rgba(0,0,0,.03);padding:40px 32px 32px}\n12: .logo{text-align:center;margin-bottom:28px}\n13: .logo-icon{width:44px;height:44px;border-radius:11px;background:#f1f5f9;border:1px solid #e2e8f0;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px}\n14: .logo-icon svg{width:22px;height:22px;color:#475569}\n15: .logo h1{font-size:18px;font-weight:700;color:#0f172a;letter-spacing:-.3px;margin-bottom:4px}\n16: .logo p{font-size:13px;color:#94a3b8}\n17: .form-area{position:relative;overflow:hidden}\n18: .form{transition:opacity .2s,transform .2s}\n19: .form.hide{opacity:0;transform:translateX(16px);position:absolute;top:0;left:0;right:0;pointer-events:none}\n20: .form.show{opacity:1;transform:translateX(0)}\n21: .field{margin-bottom:14px}\n22: .field label{display:block;font-size:13px;font-weight:500;color:#64748b;margin-bottom:5px}\n23: .field input{width:100%;height:42px;padding:0 12px;border:1px solid #e2e8f0;border-radius:9px;font-size:14px;color:#0f172a;background:#fff;outline:none;transition:border-color .15s,box-shadow .15s}\n24: .field input::placeholder{color:#cbd5e1}\n25: .field input:focus{border-color:#94a3b8;box-shadow:0 0 0 3px rgba(148,163,184,.1)}\n26: .err{font-size:13px;color:#ef4444;min-height:20px;text-align:center;margin-bottom:2px}\n27: .btn{width:100%;height:42px;border:none;border-radius:9px;font-size:14px;font-weight:600;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center}\n28: .btn-primary{background:#0f172a;color:#fff}\n29: .btn-primary:hover{background:#1e293b}\n30: .btn-primary:active{background:#0f172a}\n31: .btn-primary:disabled{opacity:.4;cursor:not-allowed}\n32: .sw{text-align:center;margin-top:16px;font-size:13px;color:#94a3b8}\n33: .sw a{color:#475569;font-weight:600;cursor:pointer;text-decoration:none}\n34: .sw a:hover{color:#0f172a}\n35: .footer{text-align:center;margin-top:20px;font-size:12px;color:#cbd5e1}\n36: .hidden{display:none}\n37: @media(max-width:480px){.card{padding:28px 20px 24px}.wrap{padding:16px}}\n38: </style>\n39: </head>\n40: <body>\n41: <div class=\"wrap\">\n42: <div class=\"card\">\n43:   <div class=\"logo\">\n44:     <div class=\"logo-icon\">\n45:       <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n46:     </div>\n47:     <h1>AI 眼睛助手</h1>\n48:     <p>OpenVela 设备管理控制台</p>\n49:   </div>\n50:   <div class=\"form-area\">\n51:     <div id=\"loginForm\" class=\"form show\">\n52:       <div class=\"field\"><label>用户名</label><input type=\"text\" id=\"lu\" placeholder=\"请输入用户名\" autocomplete=\"username\"></div>\n53:       <div class=\"field\"><label>密码</label><input type=\"password\" id=\"lp\" placeholder=\"请输入密码\" autocomplete=\"current-password\"></div>\n54:       <p class=\"err\" id=\"le\"></p>\n55:       <button class=\"btn btn-primary\" id=\"loginBtn\" onclick=\"login()\">登 录</button>\n56:       <p class=\"sw\">还没有账号？<a onclick=\"showForm('register')\">立即注册</a></p>\n57:     </div>\n58:     <div id=\"registerForm\" class=\"form hide hidden\">\n59:       <div class=\"field\"><label>用户名</label><input type=\"text\" id=\"ru\" placeholder=\"请输入用户名\" autocomplete=\"username\"></div>\n60:       <div class=\"field\"><label>密码</label><input type=\"password\" id=\"rp\" placeholder=\"至少 4 位\" autocomplete=\"new-password\"></div>\n61:       <p class=\"err\" id=\"re\"></p>\n62:       <button class=\"btn btn-primary\" id=\"regBtn\" onclick=\"register()\">注 册</button>\n63:       <p class=\"sw\">已有账号？<a onclick=\"showForm('login')\">返回登录</a></p>\n64:     </div>\n65:   </div>\n66: </div>\n67: <div class=\"footer\">Team 193 FirstNext · OpenVela AI 眼睛助手</div>\n68: </div>\n69: <script>\n70: const API='/api';\n71: function showForm(f){\n72:   const a=document.getElementById('loginForm'),b=document.getElementById('registerForm');\n73:   document.getElementById('le').textContent='';document.getElementById('re').textContent='';\n74:   if(f==='register'){a.classList.remove('show');a.classList.add('hide');setTimeout(()=>{a.classList.add('hidden');b.classList.remove('hidden');b.classList.remove('hide');b.classList.add('show')},150)}\n75:   else{b.classList.remove('show');b.classList.add('hide');setTimeout(()=>{b.classList.add('hidden');a.classList.remove('hidden');a.classList.remove('hide');a.classList.add('show')},150)}\n76: }\n77: async function login(){\n78:   const u=document.getElementById('lu').value.trim(),p=document.getElementById('lp').value;\n79:   document.getElementById('le').textContent='';\n80:   if(!u||!p){document.getElementById('le').textContent='请输入用户名和密码';return}\n81:   const btn=document.getElementById('loginBtn');btn.disabled=true;btn.textContent='登录中...';\n82:   try{const r=await fetch(API+'/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});const j=await r.json();if(!r.ok){document.getElementById('le').textContent=j.error||'登录失败';return}localStorage.setItem('token',j.token);localStorage.setItem('user',JSON.stringify({username:j.username,role:j.role}));location.href='dashboard.html'}catch(e){document.getElementById('le').textContent='网络错误'}finally{btn.disabled=false;btn.textContent='登 录'}\n83: }\n84: async function register(){\n85:   const u=document.getElementById('ru').value.trim(),p=document.getElementById('rp').value;\n86:   document.getElementById('re').textContent='';\n87:   if(!u||p.length<4){document.getElementById('re').textContent='用户名和密码（≥4位）必填';return}\n88:   const btn=document.getElementById('regBtn');btn.disabled=true;btn.textContent='注册中...';\n89:   try{const r=await fetch(API+'/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});const j=await r.json();if(!r.ok){document.getElementById('re').textContent=j.error||'注册失败';return}localStorage.setItem('token',j.token);localStorage.setItem('user',JSON.stringify({username:j.username,role:j.role}));location.href='dashboard.html'}catch(e){document.getElementById('re').textContent='网络错误'}finally{btn.disabled=false;btn.textContent='注 册'}\n90: }\n91: document.getElementById('lp').addEventListener('keydown',e=>{if(e.key==='Enter')login()});\n92: document.getElementById('rp').addEventListener('keydown',e=>{if(e.key==='Enter')register()});\n93: </script>\n94: </body>\n95: </html>\n\n(End of file - total 95 lines)\n</content>"}
