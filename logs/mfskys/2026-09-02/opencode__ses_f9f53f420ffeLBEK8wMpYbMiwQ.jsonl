1:   <!-- Config -->\n182:   <div class=\"pane\" id=\"pane-config\">\n183:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-gear\"/></svg> 设备配置</h2><p>配置持久化到云端，板端联网后自动应用</p></div></div>\n184:     <div class=\"card bind-bar\">\n185:       <div class=\"f\"><label>选择设备</label><select id=\"cfgDev\" onchange=\"loadConfig()\"></select></div>\n186:       <button class=\"btn btn-g\" onclick=\"loadConfig()\"><svg><use href=\"#i-refresh\"/></svg> 读取</button>\n187:     </div>\n188:     <div id=\"cfgBox\" style=\"display:none\">\n189:       <div class=\"card prof-card\">\n190:         <h3><svg><use href=\"#i-display\"/></svg> 显示</h3>\n191:         <div class=\"fr\">\n192:           <div class=\"fc\"><label>亮度</label><div class=\"rng\"><input type=\"range\" min=\"0\" max=\"100\" value=\"80\" id=\"cfgBright\" oninput=\"document.getElementById('vB').textContent=this.value+'%'\"><span class=\"v\" id=\"vB\">80%</span></div></div>\n193:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgInvert\"> 反色</label></div>\n194:         </div>\n195:       </div>\n196:       <div class=\"card prof-card\">\n197:         <h3><svg><use href=\"#i-robot\"/></svg> 眼睛</h3>\n198:         <div class=\"fr\">\n199:           <div class=\"fc\"><label>默认表情</label><select id=\"cfgExpr\"></select></div>\n200:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgBlink\" checked> 自动眨眼</label></div>\n201:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgFollow\" checked> 触摸跟随</label></div>\n202:         </div>\n203:       </div>\n204:       <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px\">\n205:         <button class=\"btn btn-g\" onclick=\"loadConfig()\">重置</button>\n206:         <button class=\"btn btn-p\" onclick=\"saveConfig()\"><svg><use href=\"#i-check\"/></svg> 保存配置</button>\n207:       </div>\n208:     </div>\n209:     <div class=\"card empty\" id=\"cfgEmpty\"><div class=\"empty-icon\"><svg><use href=\"#i-gear\"/></svg></div><p>请先在「设备」页绑定设备</p></div>\n210:   </div>\n211: \n212:   <!-- Voice -->\n213:   <div class=\"pane\" id=\"pane-voice\">\n214:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-mic\"/></svg> AI 语音</h2><p>配置语音交互参数（后端 /voice 链路建设中）</p></div></div>\n215:     <div class=\"card prof-card\">\n216:       <h3><svg><use href=\"#i-mic\"/></svg> 语音设置</h3>\n217:       <div class=\"fr\">\n218:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgVoiceOn\"> 启用语音</label></div>\n219:         <div class=\"fc\"><label>唤醒词</label><input id=\"cfgWake\" value=\"小薇\"></div>\n220:         <div class=\"fc\"><label>音色风格</label><select id=\"cfgStyle\"><option>友好亲切</option><option>专业正式</option><option>幽默风趣</option><option>简洁高效</option></select></div>\n221:       </div>\n222:       <div style=\"display:flex;justify-content:flex-end\"><button class=\"btn btn-p\" onclick=\"saveVoice()\"><svg><use href=\"#i-check\"/></svg> 保存语音配置</button></div>\n223:     </div>\n224:   </div>\n225: \n226:   <!-- Settings -->\n227:   <div class=\"pane\" id=\"pane-settings\">\n228:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-gear\"/></svg> 设置</h2><p>管理账号信息</p></div></div>\n229:     <div class=\"card prof-card\">\n230:       <h3><svg><use href=\"#i-person\"/></svg> 个人信息</h3>\n231:       <div class=\"fr\">\n232:         <div class=\"fc\"><label>昵称</label><input placeholder=\"在设备上显示的名称\"></div>\n233:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><button class=\"btn btn-p\" onclick=\"t('已保存')\">保存</button></div>\n234:       </div>\n235:       <div class=\"divider\"></div>\n236:       <h3 style=\"font-size:13px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:7px\"><svg style=\"color:var(--tx2)\" width=\"14\" height=\"14\"><use href=\"#i-key\"/></svg> 修改密码</h3>\n237:       <div class=\"fr\">\n238:         <div class=\"fc\"><label>当前密码</label><input type=\"password\" placeholder=\"当前密码\"></div>\n239:         <div class=\"fc\"><label>新密码</label><input type=\"password\" placeholder=\"至少 4 位\"></div>\n240:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><button class=\"btn btn-p\" onclick=\"t('已修改')\">修改</button></div>\n241:       </div>\n242:     </div>\n243:     <div class=\"card prof-card\">\n244:       <h3><svg><use href=\"#i-info\"/></svg> 关于</h3>\n245:       <div style=\"font-size:13px;color:var(--tx2);line-height:2\">\n246:         <div><strong style=\"color:var(--tx)\">AI 眼睛助手</strong> · Team 193 FirstNext</div>\n247:         <div>后端：Flask · 前端：HTML / CSS / JS</div>\n248:         <div>截止：<strong style=\"color:var(--warn)\">2026-09-20</strong></div>\n249:       </div>\n250:     </div>\n251:     <div class=\"card adm-card\" id=\"admZone\" style=\"display:none\">\n252:       <h3><svg><use href=\"#i-shield\"/></svg> 管理员</h3>\n253:       <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:12px\">\n254:         <button class=\"btn btn-g btn-s\" onclick=\"togReg()\"><svg><use href=\"#i-toggle\"/></svg> 注册开关</button>\n255:         <span style=\"font-size:12px\" id=\"regSt\"></span>\n256:       </div>\n257:       <div style=\"font-size:12px;font-weight:600;color:var(--tx3);margin-bottom:6px\">用户</div>\n258:       <div id=\"userList\"></div>\n259:     </div>\n260:   </div>\n261: \n262: </div>\n263: \n264: <div class=\"tw\" id=\"tw\"><div class=\"ts\" id=\"ts\"></div></div>\n265: \n266: <script>\n267: let T=localStorage.getItem('token')||'';\n268: const U=JSON.parse(localStorage.getItem('user')||'{}');\n269: if(!T)location.href='index.html';\n270: document.getElementById('avatarEl').textContent=(U.username||'?')[0].toUpperCase();\n271: if(U.role==='admin')document.getElementById('admZone').style.display='';\n272: \n273: let _tt=null;function t(m){const e=document.getElementById('tw');document.getElementById('ts').innerHTML='<svg><use href=\"#i-check\"/></svg> '+m;e.classList.add('show');clearTimeout(_tt);_tt=setTimeout(()=>e.classList.remove('show'),2000)}\n274: \n275: document.querySelectorAll('.nav-tab[data-tab]').forEach(b=>{b.addEventListener('click',()=>{document.querySelectorAll('.nav-tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');const s=b.dataset.tab;document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('active',p.id==='pane-'+s));if(s==='settings')loadAdm()})});\n276: \n277: async function api(m,p,body){const h={'Content-Type':'application/json'};if(T)h['Authorization']='Bearer '+T;const r=await fetch('/api'+p,{method:m,headers:h,body:body?JSON.stringify(body):undefined});const j=await r.json();if(r.status===401){localStorage.clear();location.href='index.html';return null}return{ok:r.ok,data:j}}\n278: function logout(){localStorage.clear();location.href='index.html'}\n279: function ago(iso){if(!iso)return'从未';const s=Math.floor((Date.now()-new Date(iso).getTime())/1000);if(s<60)return s+'秒前';if(s<3600)return(s/60|0)+'分钟前';if(s<86400)return(s/3600|0)+'小时前';return(s/86400|0)+'天前'}\n280: \n281: const EXPRS=['平静','开心','大笑','眯眼','喜欢','惊讶','惊恐','难过','哭泣','生气','思考','疑惑','得意','无语','困倦','睡觉','聆听','说话','扫描','加载'];\n282: function populateExpr(){const s=document.getElementById('cfgExpr');s.innerHTML=EXPRS.map(e=>'<option value=\"'+e+'\">'+e+'</option>').join('')}\n283: \n284: async function bindDev(){const c=document.getElementById('codeInput').value.trim();if(!c){t('请输入设备码');return}const r=await api('POST','/devices/bind',{device_code:c,name:c.slice(0,8)});if(!r)return;if(!r.ok){t(r.data.error);return}document.getElementById('codeInput').value='';t('绑定成功');loadDev()}\n285: async function unbindDev(c){if(!confirm('解绑 '+c.slice(0,8)+'？'))return;const r=await api('DELETE','/devices/'+c+'/unbind');if(!r?.ok){t(r?.data?.error||'失败');return}t('已解绑');loadDev()}\n286: function cpCode(c){navigator.clipboard.writeText(c).then(()=>t('已复制'))}\n287: function openCfg(c){const sel=document.getElementById('cfgDev');sel.value=c;document.querySelector('.nav-tab[data-tab=\"config\"]').click();loadConfig()}\n288: \n289: async function loadDev(){const r=await api('GET','/devices');const l=r?.data?.devices||[];const el=document.getElementById('devList');const em=document.getElementById('devEmpty');const sel=document.getElementById('cfgDev');sel.innerHTML='<option value=\"\">— 请选择已绑定设备 —</option>'+l.map(d=>'<option value=\"'+d.device_code+'\">'+(d.name||d.device_code.slice(0,8))+'</option>').join('');if(!l.length){el.innerHTML='';em.style.display='';return}em.style.display='none';el.innerHTML=l.map(d=>'<div class=\"card dev-card\"><div class=\"dev-top\"><div class=\"dev-info\"><div class=\"dev-ic\"><svg><use href=\"#i-display\"/></svg></div><div><div class=\"dev-nm\">'+(d.name||d.device_code.slice(0,8))+'</div><div class=\"dev-cd\">'+d.device_code+'</div></div></div><div class=\"badge '+(d.online?'on':'off')+'\"><span class=\"dot\" style=\"animation-duration:'+(d.online?'2s':'0s')+';opacity:'+(d.online?1:.3)+'\"></span>'+(d.online?'在线':'离线')+'</div></div><div class=\"dev-rows\"><div class=\"r\"><b>眼睛</b><span>模式</span></div><div class=\"r\"><b>—</b><span>配置</span></div><div class=\"r\"><b>'+(d.online?'在线':ago(d.last_seen))+'</b><span>状态</span></div></div><div class=\"dev-act\"><button class=\"btn btn-g btn-s\" onclick=\"openCfg(\\''+d.device_code+'\\')\"><svg><use href=\"#i-gear\"/></svg> 配置</button><button class=\"btn btn-d btn-s\" onclick=\"unbindDev(\\''+d.device_code+'\\')\"><svg><use href=\"#i-x\"/></svg> 解绑</button></div></div>').join('')}\n290: \n291: async function loadConfig(){const code=document.getElementById('cfgDev').value;const box=document.getElementById('cfgBox');const empty=document.getElementById('cfgEmpty');if(!code){box.style.display='none';empty.style.display='';return}empty.style.display='none';box.style.display='';const r=await api('GET','/devices/'+code+'/config');if(!r?.ok){t(r?.data?.error||'读取失败');return}const c=r.data.config||{};document.getElementById('cfgBright').value=(c.display&&c.display.brightness!=null)?c.display.brightness:80;document.getElementById('vB').textContent=document.getElementById('cfgBright').value+'%';document.getElementById('cfgInvert').checked=!!(c.display&&c.display.invert);if(c.eye){if(c.eye.default_expr)document.getElementById('cfgExpr').value=c.eye.default_expr;document.getElementById('cfgBlink').checked=c.eye.auto_blink!==false;document.getElementById('cfgFollow').checked=c.eye.follow_touch!==false;}if(c.voice){document.getElementById('cfgVoiceOn').checked=!!c.voice.enabled;if(c.voice.wake_word)document.getElementById('cfgWake').value=c.voice.wake_word;if(c.voice.style)document.getElementById('cfgStyle').value=c.voice.style;}t('已读取配置')}\n292: async function saveConfig(){const code=document.getElementById('cfgDev').value;if(!code){t('请先选择设备');return}const body={display:{brightness:parseInt(document.getElementById('cfgBright').value,10),invert:document.getElementById('cfgInvert').checked},eye:{default_expr:document.getElementById('cfgExpr').value,auto_blink:document.getElementById('cfgBlink').checked,follow_touch:document.getElementById('cfgFollow').checked}};const r=await api('POST','/devices/'+code+'/config',body);if(!r?.ok){t(r?.data?.error||'保存失败');return}t('配置已保存');loadDev()}\n293: async function saveVoice(){const code=document.getElementById('cfgDev').value;if(!code){t('请先选择设备');return}const body={voice:{enabled:document.getElementById('cfgVoiceOn').checked,wake_word:document.getElementById('cfgWake').value,style:document.getElementById('cfgStyle').value}};const r=await api('POST','/devices/'+code+'/config',body);if(!r?.ok){t(r?.data?.error||'保存失败');return}t('语音配置已保存');loadDev()}\n294: \n295: async function loadAdm(){if(U.role!=='admin')return;const r=await api('GET','/admin/registration').catch(()=>null);if(r?.ok)document.getElementById('regSt').innerHTML=r.data.registration_open?'<span style=\"color:var(--ok)\">开放</span>':'<span style=\"color:var(--tx3)\">关闭</span>';const u=await api('GET','/admin/users');const l=u?.data?.users||[];document.getElementById('userList').innerHTML=l.length?l.map(x=>{const me=x.username===U.username;return'<div class=\"adm-row\"><div><span class=\"nm\">'+x.username+'</span><span class=\"rl\">'+x.role+'</span></div><div style=\"display:flex;align-items:center;gap:6px\"><span style=\"font-size:11px;color:var(--tx3)\">'+(x.created_at?ago(x.created_at):'')+'</span>'+(me?'<span style=\"font-size:10px;color:var(--tx3)\">当前</span>':'<button class=\"btn btn-d btn-s\" style=\"height:26px;padding:0 6px\" onclick=\"delUser(\\''+x.username+'\\')\"><svg style=\"width:12px;height:12px\"><use href=\"#i-trash\"/></svg></button>')+'</div></div>'}).join(''):'<div style=\"font-size:12px;color:var(--tx3)\">暂无</div>'}\n296: async function togReg(){const r=await api('GET','/admin/registration').catch(()=>null);const c=r?.data?.registration_open??true;const a=await api('POST','/admin/registration',{open:!c});if(a?.ok){t('注册已'+(c?'关闭':'开启'));loadAdm()}}\n297: async function delUser(n){if(!confirm('删除 '+n+'？'))return;const r=await api('DELETE','/admin/users/'+n);if(!r?.ok){t(r?.data?.error||'失败');return}t('已删除');loadAdm()}\n298: \n299: populateExpr();loadDev();\n300: setInterval(()=>{if(document.getElementById('pane-devices').classList.contains('active'))loadDev()},30000);\n301: </script>\n302: </body>\n303: </html>\n\n(End of file - total 303 lines)\n</content>"}
