dius:7px;background:var(--pri);display:flex;align-items:center;justify-content:center}\n29: .brand-icon svg{width:14px;height:14px;color:#fff;display:block}\n30: .brand span{font-size:14px;font-weight:700;color:var(--tx);letter-spacing:-.2px}\n31: .nav-tabs{display:flex;gap:1px}\n32: .nav-tab{padding:6px 12px;border-radius:var(--r-xs);font-size:13px;font-weight:500;color:var(--tx3);cursor:pointer;border:none;background:none;transition:all .15s;white-space:nowrap}\n33: .nav-tab:hover{color:var(--tx2);background:var(--pri-soft)}\n34: .nav-tab.active{color:var(--tx);background:var(--pri-soft);font-weight:600}\n35: .nav-right{margin-left:auto;display:flex;align-items:center;gap:10px}\n36: .pill{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:500;padding:4px 10px;border-radius:20px;color:var(--ok);background:var(--ok-soft)}\n37: .dot{width:5px;height:5px;border-radius:50%;background:var(--ok);animation:pulse 2s infinite}\n38: @keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}\n39: .user-btn{width:30px;height:30px;border-radius:50%;background:var(--pri);color:#fff;display:grid;place-items:center;font-size:12px;font-weight:700;cursor:pointer;border:none;transition:background .15s}\n40: .user-btn:hover{background:var(--pri-hover)}\n41: \n42: .content{padding:24px 24px 48px;max-width:1060px;margin:0 auto}\n43: .pane{display:none;animation:fadeIn .2s ease}\n44: .pane.active{display:block}\n45: @keyframes fadeIn{from{opacity:0}to{opacity:1}}\n46: \n47: .card{background:var(--surface);border:1px solid var(--bd);border-radius:var(--r);box-shadow:var(--sh);transition:box-shadow .2s}\n48: .card:hover{box-shadow:var(--sh-md)}\n49: \n50: .sec-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}\n51: .sec-hd h2{font-size:15px;font-weight:700;display:flex;align-items:center;gap:7px;color:var(--tx)}\n52: .sec-hd h2 svg{color:var(--tx2)}\n53: .sec-hd p{font-size:12px;color:var(--tx3);margin-top:2px}\n54: \n55: .bind-bar{padding:14px 16px;margin-bottom:14px;display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap}\n56: .bind-bar .f{flex:1;min-width:180px}\n57: .bind-bar label{display:block;font-size:12px;font-weight:500;color:var(--tx3);margin-bottom:5px}\n58: .bind-bar input,.bind-bar select{width:100%;height:38px;padding:0 12px;border:1px solid var(--bd);border-radius:var(--r-xs);font-size:13px;outline:none;background:#fff;transition:border-color .15s}\n59: .bind-bar input:focus,.bind-bar select:focus{border-color:var(--tx3)}\n60: .dev-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px}\n61: .dev-card{padding:18px;position:relative;overflow:hidden}\n62: .dev-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px}\n63: .dev-info{display:flex;gap:10px;align-items:flex-start}\n64: .dev-ic{width:38px;height:38px;border-radius:9px;background:var(--bd-light);border:1px solid var(--bd);display:grid;place-items:center;flex-shrink:0}\n65: .dev-ic svg{width:18px;height:18px;color:var(--tx2)}\n66: .dev-nm{font-size:14px;font-weight:600;color:var(--tx);margin-bottom:2px}\n67: .dev-cd{font-size:11px;color:var(--tx3);font-family:\"SF Mono\",Consolas,monospace;background:var(--bd-light);padding:2px 7px;border-radius:5px}\n68: .badge{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px}\n69: .badge.on{background:var(--ok-soft);color:var(--ok)}\n70: .badge.off{background:var(--bd-light);color:var(--tx3)}\n71: .dev-rows{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:10px 0;border-top:1px solid var(--bd-light);border-bottom:1px solid var(--bd-light);margin-bottom:10px}\n72: .dev-rows .r{text-align:center}\n73: .dev-rows .r b{display:block;font-size:13px;font-weight:600;color:var(--tx)}\n74: .dev-rows .r span{font-size:11px;color:var(--tx3)}\n75: .dev-act{display:flex;gap:6px}\n76: .dev-act .btn{flex:1;justify-content:center}\n77: .empty{text-align:center;padding:52px 20px;color:var(--tx3)}\n78: .empty-icon{width:56px;height:56px;border-radius:14px;background:var(--bd-light);border:1px solid var(--bd);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px}\n79: .empty-icon svg{width:24px;height:24px;color:var(--tx4)}\n80: .empty p{font-size:13px;color:var(--tx3)}\n81: .empty .sub{font-size:12px;color:var(--tx4);margin-top:3px}\n82: \n83: .fr{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}\n84: .fc{flex:1;min-width:130px}\n85: .fc label{display:block;font-size:12px;font-weight:500;color:var(--tx3);margin-bottom:5px}\n86: .fc input,.fc select,.fc textarea{width:100%;height:36px;padding:0 10px;border:1px solid var(--bd);border-radius:var(--r-xs);font-size:13px;outline:none;background:#fff;color:var(--tx);transition:border-color .15s;font-family:inherit}\n87: .fc textarea{height:64px;padding:8px 10px;resize:vertical}\n88: .fc input:focus,.fc select:focus,.fc textarea:focus{border-color:var(--tx3)}\n89: .check{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--tx2);white-space:nowrap}\n90: .check input{width:16px;height:16px;accent-color:var(--tx2);cursor:pointer}\n91: .rng{display:flex;align-items:center;gap:8px}\n92: .rng input[type=range]{flex:1;height:4px;accent-color:var(--tx2);cursor:pointer}\n93: .rng .v{font-size:12px;color:var(--tx2);font-weight:600;min-width:34px;text-align:right}\n94: .divider{height:1px;background:var(--bd-light);margin:14px 0}\n95: .prof-card{padding:18px;margin-bottom:12px}\n96: .prof-card h3{font-size:13px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:7px;color:var(--tx)}\n97: .prof-card h3 svg{color:var(--tx2)}\n98: .adm-card{padding:18px;margin-top:12px}\n99: .adm-card h3{font-size:13px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:7px;color:var(--tx)}\n100: .adm-card h3 svg{color:var(--warn)}\n101: .adm-row{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--bd-light);font-size:13px}\n102: .adm-row:last-child{border-bottom:none}\n103: .adm-row .nm{font-weight:600;color:var(--tx)}\n104: .adm-row .rl{font-size:10px;color:var(--tx3);margin-left:5px;padding:1px 6px;background:var(--bd-light);border-radius:4px}\n105: \n106: .btn{height:34px;padding:0 14px;border:none;border-radius:var(--r-xs);font-size:13px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s;white-space:nowrap}\n107: .btn svg{width:14px;height:14px}\n108: .btn-p{background:var(--pri);color:#fff}\n109: .btn-p:hover{background:var(--pri-hover)}\n110: .btn-p:active{transform:scale(.98)}\n111: .btn-g{background:transparent;color:var(--tx2);border:1px solid var(--bd)}\n112: .btn-g:hover{background:var(--bd-light);color:var(--tx)}\n113: .btn-s{height:30px;padding:0 10px;font-size:12px;border-radius:var(--r-xs)}\n114: .btn-d{background:transparent;color:var(--err);border:1px solid rgba(220,38,38,.15)}\n115: .btn-d:hover{background:var(--err-soft)}\n116: \n117: .tw{position:fixed;top:14px;right:14px;z-index:999;display:none}\n118: .tw.show{display:block;animation:toastIn .2s ease}\n119: @keyframes toastIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}\n120: .ts{background:var(--pri);color:#fff;padding:10px 16px;border-radius:var(--r-sm);font-size:13px;font-weight:500;box-shadow:var(--sh-lg);display:flex;align-items:center;gap:7px}\n121: .ts svg{width:15px;height:15px;color:#94a3b8}\n122: \n123: @media(max-width:768px){.nav-tabs{display:none}.content{padding:16px}.dev-grid{grid-template-columns:1fr}}\n124: </style>\n125: </head>\n126: <body>\n127: <svg xmlns=\"http://www.w3.org/2000/svg\">\n128: <symbol id=\"i-display\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M8 21h8M12 17v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n129: <symbol id=\"i-gear\" viewBox=\"0 0 24 24\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n130: <symbol id=\"i-mic\" viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"2\" width=\"6\" height=\"12\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M5 10a7 7 0 0 0 14 0M12 18v4M8 22h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n131: <symbol id=\"i-speaker\" viewBox=\"0 0 24 24\"><polygon points=\"11,5 6,9 2,9 2,15 6,15 11,19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n132: <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n133: <symbol id=\"i-link\" viewBox=\"0 0 24 24\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 1 1 0 10h-2M8 12h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n134: <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"8\" y=\"2\" width=\"13\" height=\"19\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M5 21V5a2 2 0 0 1 2-2h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n135: <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M18 6L6 18M6 6l12 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n136: <symbol id=\"i-person\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M4 21v-1a6 6 0 0 1 12 0v1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n137: <symbol id=\"i-key\" viewBox=\"0 0 24 24\"><circle cx=\"8\" cy=\"15\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M11.5 13.5L21 4M17 8l4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n138: <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M12 16v-4M12 8h.01\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n139: <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M12 2l8 4v6c0 5.25-3.5 8.75-8 10-4.5-1.25-8-4.75-8-10V6l8-4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n140: <symbol id=\"i-toggle\" viewBox=\"0 0 24 24\"><rect x=\"1\" y=\"6\" width=\"22\" height=\"12\" rx=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"16\" cy=\"12\" r=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n141: <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n142: <symbol id=\"i-inbox\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M2 14h5l2 4h6l2-4h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n143: <symbol id=\"i-robot\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"9\" cy=\"16\" r=\"1\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"16\" r=\"1\" fill=\"currentColor\"/><path d=\"M12 3v4M8 7h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n144: <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></symbol>\n145: </svg>\n146: \n147: <div class=\"topnav\">\n148:   <div class=\"brand\">\n149:     <div class=\"brand-icon\"><svg><use href=\"#i-robot\"/></svg></div>\n150:     <span>AI 眼睛助手</span>\n151:   </div>\n152:   <div class=\"nav-tabs\">\n153:     <button class=\"nav-tab active\" data-tab=\"devices\">设备</button>\n154:     <button class=\"nav-tab\" data-tab=\"config\">配置</button>\n155:     <button class=\"nav-tab\" data-tab=\"voice\">AI 语音</button>\n156:     <button class=\"nav-tab\" data-tab=\"settings\">设置</button>\n157:   </div>\n158:   <div class=\"nav-right\">\n159:     <div class=\"pill\"><span class=\"dot\"></span> 在线</div>\n160:     <button class=\"user-btn\" id=\"avatarEl\" onclick=\"logout()\" title=\"退出登录\">A</button>\n161:   </div>\n162: </div>\n163: \n164: <div class=\"content\">\n165: \n166:   <!-- Devices -->\n167:   <div class=\"pane active\" id=\"pane-devices\">\n168:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-display\"/></svg> 我的设备</h2><p>绑定设备码后，设备将永久归属你的账号</p></div></div>\n169:     <div class=\"card bind-bar\">\n170:       <div class=\"f\"><label>设备码</label><input type=\"text\" id=\"codeInput\" placeholder=\"输入板端显示的设备码\"></div>\n171:       <button class=\"btn btn-p\" onclick=\"bindDev()\"><svg><use href=\"#i-link\"/></svg> 绑定</button>\n172:     </div>\n173:     <div class=\"dev-grid\" id=\"devList\"></div>\n174:     <div class=\"card empty\" id=\"devEmpty\">\n175:       <div class=\"empty-icon\"><svg><use href=\"#i-inbox\"/></svg></div>\n176:       <p>还没有绑定设备</p>\n177:       <p class=\"sub\">在板端获取设备码后，在上方输入框绑定</p>\n178:     </div>\n179:   </div>\n180: \n181:   <!-- Config -->\n182:   <div class=\"pane\" id=\"pane-config\">\n183:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-gear\"/></svg> 设备配置</h2><p>配置持久化到云端，板端联网后自动应用</p></div></div>\n184:     <div class=\"card bind-bar\">\n185:       <div class=\"f\"><label>选择设备</label><select id=\"cfgDev\" onchange=\"loadConfig()\"></select></div>\n186:       <button class=\"btn btn-g\" onclick=\"loadConfig()\"><svg><use href=\"#i-refresh\"/></svg> 读取</button>\n187:     </div>\n188:     <div id=\"cfgBox\" style=\"display:none\">\n189:       <div class=\"card prof-card\">\n190:         <h3><svg><use href=\"#i-display\"/></svg> 显示</h3>\n191:         <div class=\"fr\">\n192:           <div class=\"fc\"><label>亮度</label><div class=\"rng\"><input type=\"range\" min=\"0\" max=\"100\" value=\"80\" id=\"cfgBright\" oninput=\"document.getElementById('vB').textContent=this.value+'%'\"><span class=\"v\" id=\"vB\">80%</span></div></div>\n193:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgInvert\"> 反色</label></div>\n194:         </div>\n195:       </div>\n196:       <div class=\"card prof-card\">\n197:         <h3><svg><use href=\"#i-robot\"/></svg> 眼睛</h3>\n198:         <div class=\"fr\">\n199:           <div class=\"fc\"><label>默认表情</label><select id=\"cfgExpr\"></select></div>\n200:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgBlink\" checked> 自动眨眼</label></div>\n201:           <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgFollow\" checked> 触摸跟随</label></div>\n202:         </div>\n203:       </div>\n204:       <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px\">\n205:         <button class=\"btn btn-g\" onclick=\"loadConfig()\">重置</button>\n206:         <button class=\"btn btn-p\" onclick=\"saveConfig()\"><svg><use href=\"#i-check\"/></svg> 保存配置</button>\n207:       </div>\n208:     </div>\n209:     <div class=\"card empty\" id=\"cfgEmpty\"><div class=\"empty-icon\"><svg><use href=\"#i-gear\"/></svg></div><p>请先在「设备」页绑定设备</p></div>\n210:   </div>\n211: \n212:   <!-- Voice -->\n213:   <div class=\"pane\" id=\"pane-voice\">\n214:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-mic\"/></svg> AI 语音</h2><p>配置语音交互参数（后端 /voice 链路建设中）</p></div></div>\n215:     <div class=\"card prof-card\">\n216:       <h3><svg><use href=\"#i-mic\"/></svg> 语音设置</h3>\n217:       <div class=\"fr\">\n218:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><label>&nbsp;</label><label class=\"check\"><input type=\"checkbox\" id=\"cfgVoiceOn\"> 启用语音</label></div>\n219:         <div class=\"fc\"><label>唤醒词</label><input id=\"cfgWake\" value=\"小薇\"></div>\n220:         <div class=\"fc\"><label>音色风格</label><select id=\"cfgStyle\"><option>友好亲切</option><option>专业正式</option><option>幽默风趣</option><option>简洁高效</option></select></div>\n221:       </div>\n222:       <div style=\"display:flex;justify-content:flex-end\"><button class=\"btn btn-p\" onclick=\"saveVoice()\"><svg><use href=\"#i-check\"/></svg> 保存语音配置</button></div>\n223:     </div>\n224:   </div>\n225: \n226:   <!-- Settings -->\n227:   <div class=\"pane\" id=\"pane-settings\">\n228:     <div class=\"sec-hd\"><div><h2><svg width=\"16\" height=\"16\"><use href=\"#i-gear\"/></svg> 设置</h2><p>管理账号信息</p></div></div>\n229:     <div class=\"card prof-card\">\n230:       <h3><svg><use href=\"#i-person\"/></svg> 个人信息</h3>\n231:       <div class=\"fr\">\n232:         <div class=\"fc\"><label>昵称</label><input placeholder=\"在设备上显示的名称\"></div>\n233:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><button class=\"btn btn-p\" onclick=\"t('已保存')\">保存</button></div>\n234:       </div>\n235:       <div class=\"divider\"></div>\n236:       <h3 style=\"font-size:13px;font-weight:600;margin-bottom:14px;display:flex;align-items:center;gap:7px\"><svg style=\"color:var(--tx2)\" width=\"14\" height=\"14\"><use href=\"#i-key\"/></svg> 修改密码</h3>\n237:       <div class=\"fr\">\n238:         <div class=\"fc\"><label>当前密码</label><input type=\"password\" placeholder=\"当前密码\"></div>\n239:         <div class=\"fc\"><label>新密码</label><input type=\"password\" placeholder=\"至少 4 位\"></div>\n240:         <div class=\"fc\" style=\"flex:0;min-width:auto;display:flex;align-items:flex-end\"><button class=\"btn btn-p\" onclick=\"t('已修改')\">修改</button></div>\n241:       </div>\n242:     </div>\n243:     <div class=\"card prof-card\">\n244:       <h3><svg><use href=\"#i-info\"/></svg> 关于</h3>\n245:       <div style=\"font-size:13px;color:var(--tx2);line-height:2\">\n246:         <div><strong style=\"color:var(--tx)\">AI 眼睛助手</strong> · Team 193 FirstNext</div>\n247:         <div>后端：Flask · 前端：HTML / CSS / JS</div>\n248:         <div>截止：<strong style=\"color:var(--warn)\">2026-09-20</strong></div>\n249:       </div>\n250:     </div>\n251:     <div class=\"card adm-card\" id=\"admZone\" style=\"display:none\">\n252:       <h3><svg><use href=\"#i-shield\"/></svg> 管理员</h3>\n253:       <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:12px\">\n254:         <button class=\"btn btn-g btn-s\" onclick=\"togReg()\"><svg><use href=\"#i-toggle\"/></svg> 注册开关</button>\n255:         <span style=\"font-size:12px\" id=\"regSt\"></span>\n256:       </div>\n257:       <div style=\"font-size:12px;font-weight:600;color:var(--tx3);margin-bottom:6px\">用户</div>\n258:       <div id=\"userList\"></div>\n259:     </div>\n260:   </div>\n261: \n262: </div>\n263: \n264: <div class=\"tw\" id=\"tw\"><div class=\"ts\" id=\"ts\"></div></div>\n265: \n266: <script>\n267: let T=localStorage.getItem('token')||'';\n268: const U=JSON.parse(localStorage.getItem('user')||'{}');\n269: if(!T)location.href='index.html';\n270: document.getElementById('avatarEl').textContent=(U.username||'?')[0].toUpperCase();\n271: if(U.role==='admin')document.getElementById('admZone').style.display='';\n272: \n273: let _tt=null;function t(m){const e=document.getElementById('tw');document.getElementById('ts').innerHTML='<svg><use href=\"#i-check\"/></svg> '+m;e.classList.add('show');clearTimeout(_tt);_tt=setTimeout(()=>e.classList.remove('show'),2000)}\n274: \n275: document.querySelectorAll('.nav-tab[data-tab]').forEach(b=>{b.addEventListener('click',()=>{document.querySelectorAll('.nav-tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');const s=b.dataset.tab;document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('active',p.id==='pane-'+s));if(s==='settings')loadAdm()})});\n276: \n277: async function api(m,p,body){const h={'Content-Type':'application/json'};if(T)h['Authorization']='Bearer '+T;const r=await fetch('/api'+p,{method:m,headers:h,body:body?JSON.stringify(body):undefined});const j=await r.json();if(r.status===401){localStorage.clear();location.href='index.html';return null}return{ok:r.ok,data:j}}\n278: function logout(){localStorage.clear();location.href='index.html'}\n279: function ago(iso){if(!iso)return'从未';const s=Math.floor((Date.now()-new Date(iso).getTime())/1000);if(s<60)return s+'秒前';if(s<3600)return(s/60|0)+'分钟前';if(s<86400)return(s/3600|0)+'小时前';return(s/86400|0)+'天前'}\n280: \n281: const EXPRS=['平静','开心','大笑','眯眼','喜欢','惊讶','惊恐','难过','哭泣','生气','思考','疑惑','得意','无语','困倦','睡觉','聆听','说话','扫描','加载'];\n282: function populateExpr(){const s=document.getElementById('cfgExpr');s.innerHTML=EXPRS.map(e=>'<option value=\"'+e+'\">'+e+'</option>').join('')}\n283: \n284: async function bindDev(){const c=document.getElementById('codeInput').value.trim();if(!c){t('请输入设备码');return}const r=await api('POST','/devices/bind',{device_code:c,name:c.slice(0,8)});if(!r)return;if(!r.ok){t(r.data.error);return}document.getElementById('codeInput').value='';t('绑定成功');loadDev()}\n285: async function unbindDev(c){if(!confirm('解绑 '+c.slice(0,8)+'？'))return;const r=await api('DELETE','/devices/'+c+'/unbind');if(!r?.ok){t(r?.data?.error||'失败');return}t('已解绑');loadDev()}\n286: function cpCode(c){navigator.clipboard.writeText(c).then(()=>t('已复制'))}\n287: function openCfg(c){const sel=document.getElementById('cfgDev');sel.value=c;document.querySelector('.nav-tab[data-tab=\"config\"]').click();loadConfig()}\n288: \n289: async function loadDev(){const r=await api('GET','/devices');const l=r?.data?.devices||[];const el=document.getElementById('devList');const em=document.getElementById('devEmpty');const sel=document.getElementById('cfgDev');sel.innerHTML='<option value=\"\">— 请选择已绑定设备 —</option>'+l.map(d=>'<option value=\"'+d.device_code+'\">'+(d.name||d.device_code.slice(0,8))+'</option>').join('');if(!l.length){el.innerHTML='';em.style.display='';return}em.style.display='none';el.innerHTML=l.map(d=>'<div class=\"card dev-card\"><div class=\"dev-top\"><div class=\"dev-info\"><div class=\"dev-ic\"><svg><use href=\"#i-display\"/></svg></div><div><div class=\"dev-nm\">'+(d.name||d.device_code.slice(0,8))+'</div><div class=\"dev-cd\">'+d.device_code+'</div></div></div><div class=\"badge '+(d.online?'on':'off')+'\"><span class=\"dot\" style=\"animation-duration:'+(d.online?'2s':'0s')+';opacity:'+(d.online?1:.3)+'\"></span>'+(d.online?'在线':'离线')+'</div></div><div class=\"dev-rows\"><div class=\"r\"><b>眼睛</b><span>模式</span></div><div class=\"r\"><b>—</b><span>配置</span></div><div class=\"r\"><b>'+(d.online?'在线':ago(d.last_seen))+'</b><span>状态</span></div></div><div class=\"dev-act\"><button class=\"btn btn-g btn-s\" onclick=\"openCfg(\\''+d.device_code+'\\')\"><svg><use href=\"#i-gear\"/></svg> 配置</button><button class=\"btn btn-d btn-s\" onclick=\"unbindDev(\\''+d.device_code+'\\')\"><svg><use href=\"#i-x\"/></svg> 解绑</button></div></div>').join('')}\n290: \n291: async function loadConfig(){const code=document.getElementById('cfgDev').value;const box=document.getElementById('cfgBox');const empty=document.getElementById('cfgEmpty');if(!code){box.style.display='none';empty.style.display='';return}empty.style.display='none';box.style.display='';const r=await api('GET','/devices/'+code+'/config');if(!r?.ok){t(r?.data?.error||'读取失败');return}const c=r.data.config||{};document.getElementById('cfgBright').value=(c.display&&c.display.brightness!=null)?c.display.brightness:80;document.getElementById('vB').textContent=document.getElementById('cfgBright').value+'%';document.getElementById('cfgInvert').checked=!!(c.display&&c.display.invert);if(c.eye){if(c.eye.default_expr)document.getElementById('cfgExpr').value=c.eye.default_expr;document.getElementById('cfgBlink').checked=c.eye.auto_blink!==false;document.getElementById('cfgFollow').checked=c.eye.follow_touch!==false;}if(c.voice){document.getElementById('cfgVoiceOn').checked=!!c.voice.enabled;if(c.voice.wake_word)document.getElementById('cfgWake').value=c.voice.wake_word;if(c.voice.style)document.getElementById('cfgStyle').value=c.voice.style;}t('已读取配置')}\n292: async function saveConfig(){const code=document.getElementById('cfgDev').value;if(!code){t('请先选择设备');return}const body={display:{brightness:parseInt(document.getElementById('cfgBright').value,10),invert:document.getElementById('cfgInvert').checked},eye:{default_expr:document.getElementById('cfgExpr').value,auto_blink:document.getElementById('cfgBlink').checked,follow_touch:document.getElementById('cfgFollow').checked}};const r=await api('POST','/devices/'+code+'/config',body);if(!r?.ok){t(r?.data?.error||'保存失败');return}t('配置已保存');loadDev()}\n293: async function saveVoice(){const code=document.getElementById('cfgDev').value;if(!code){t('请先选择设备');return}const body={voice:{enabled:document.getElementById('cfgVoiceOn').checked,wake_word:document.getElementById('cfgWake').value,style:document.getElementById('cfgStyle').value}};const r=await api('POST','/devices/'+code+'/config',body);if(!r?.ok){t(r?.data?.error||'保存失败');return}t('语音配置已保存');loadDev()}\n294: \n295: async function loadAdm(){if(U.role!=='admin')return;const r=await api('GET','/admin/registration').catch(()=>null);if(r?.ok)document.getElementById('regSt').innerHTML=r.data.registration_open?'<span style=\"color:var(--ok)\">开放</span>':'<span style=\"color:var(--tx3)\">关闭</span>';const u=await api('GET','/admin/users');const l=u?.data?.users||[];document.getElementById('userList').innerHTML=l.length?l.map(x=>{const me=x.username===U.username;return'<div class=\"adm-row\"><div><span class=\"nm\">'+x.username+'</span><span class=\"rl\">'+x.role+'</span></div><div style=\"display:flex;align-items:center;gap:6px\"><span style=\"font-size:11px;color:var(--tx3)\">'+(x.created_at?ago(x.created_at):'')+'</span>'+(me?'<span style=\"font-size:10px;color:var(--tx3)\">当前</span>':'<button class=\"btn btn-d btn-s\" style=\"height:26px;padding:0 6px\" onclick=\"delUser(\\''+x.username+'\\')\"><svg style=\"width:12px;height:12px\"><use href=\"#i-trash\"/></svg></button>')+'</div></div>'}).join(''):'<div style=\"font-size:12px;color:var(--tx3)\">暂无</div>'}\n296: async function togReg(){const r=await api('GET','/admin/registration').catch(()=>null);const c=r?.data?.registration_open??true;const a=await api('POST','/admin/registration',{open:!c});if(a?.ok){t('注册已'+(c?'关闭':'开启'));loadAdm()}}\n297: async function delUser(n){if(!confirm('删除 '+n+'？'))return;const r=await api('DELETE','/admin/users/'+n);if(!r?.ok){t(r?.data?.error||'失败');return}t('已删除');loadAdm()}\n298: \n299: populateExpr();loadDev();\n300: setInterval(()=>{if(document.getElementById('pane-devices').classList.contains('active'))loadDev()},30000);\n301: </script>\n302: </body>\n303: </html>\n\n(End of file - total 303 lines)\n</content>"}
