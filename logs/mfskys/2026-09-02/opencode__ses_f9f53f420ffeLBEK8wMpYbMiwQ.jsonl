{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":17,"role":"tool","ts":"2026-09-02T05:54:15.193Z","tool_name":"read","tool_call_id":"call_6500055f310c45629f402cd4","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app</path>\n<type>directory</type>\n<entries>\nCMakeLists.txt\neye_main.c\nhello_app_main.c\nKconfig\nMake.defs\nMakefile\nmy_assistant_main.c\nREADME.md\n\n(8 entries)\n</entries>"}
{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":18,"role":"tool","ts":"2026-09-02T05:54:15.193Z","tool_name":"read","tool_call_id":"call_fc4a61d00bb54256b763006b","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\backend\\app.py"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\backend\\app.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Smart Kanban Backend — Flask application.\n2: \n3: Architecture:\n4:   Board (R528)  ←→  /api/device/<code>/...  (device_code, no auth)\n5:   Web Console   ←→  /api/devices/...        (Bearer ***REDACTED***)\n6:   Admin         ←→  /api/admin/...           (admin token only)\n7: \"\"\"\n8: \n9: from flask import Flask, request, jsonify, send_from_directory\n10: import os\n11: from functools import wraps\n12: import store\n13: \n14: WEB_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)), \"web\")\n15: STATIC_DIR = os.path.join(os.path.dirname(__file__), \"static\")\n16: os.makedirs(STATIC_DIR, exist_ok=True)\n17: \n18: app = Flask(__name__, static_folder=STATIC_DIR)\n19: \n20: # Serve web frontend\n21: @app.route(\"/\")\n22: def serve_index():\n23:     return send_from_directory(WEB_DIR, \"index.html\")\n24: \n25: @app.route(\"/dashboard\")\n26: @app.route(\"/dashboard.html\")\n27: def serve_dashboard():\n28:     return send_from_directory(WEB_DIR, \"dashboard.html\")\n29: \n30: @app.after_request\n31: def add_cors(response):\n32:     response.headers[\"Access-Control-Allow-Origin\"] = \"*\"\n33:     response.headers[\"Access-Control-Allow-Headers\"] = \"Content-Type, Authorization\"\n34:     response.headers[\"Access-Control-Allow-Methods\"] = \"GET, POST, DELETE, OPTIONS\"\n35:     return response\n36: \n37: # ---------------------------------------------------------------------------\n38: # Helpers\n39: # ---------------------------------------------------------------------------\n40: \n41: def _get_token():\n42:     \"\"\"Extract Bearer ***REDACTED*** from Authorization header.\"\"\"\n43:     header = request.headers.get(\"Authorization\", \"\")\n44:     if header.startswith(\"Bearer \"):\n45:         return header[7:]\n46:     return None\n47: \n48: \n49: def _json_body():\n50:     \"\"\"Parse JSON body, return {} on failure.\"\"\"\n51:     try:\n52:         return request.get_json(force=True, silent=True) or {}\n53:     except Exception:\n54:         return {}\n55: \n56: \n57: def login_required(f):\n58:     \"\"\"Decorator: requires valid Bearer ***REDACTED***\"\"\"\n59:     @wraps(f)\n60:     def wrapper(*args, **kwargs):\n61:         user = store.user_auth(_get_token())\n62:         if not user:\n63:             return jsonify({\"error\": \"unauthorized\"}), 401\n64:         return f(user=user, *args, **kwargs)\n65:     return wrapper\n66: \n67: \n68: def admin_required(f):\n69:     \"\"\"Decorator: requires admin Bearer ***REDACTED***\"\"\"\n70:     @wraps(f)\n71:     def wrapper(*args, **kwargs):\n72:         user = store.user_auth(_get_token())\n73:         if not user or user[\"role\"] != \"admin\":\n74:             return jsonify({\"error\": \"forbidden\"}), 403\n75:         return f(user=user, *args, **kwargs)\n76:     return wrapper\n77: \n78: \n79: # ---------------------------------------------------------------------------\n80: # Auth\n81: # ---------------------------------------------------------------------------\n82: \n83: @app.route(\"/api/register\", methods=[\"POST\"])\n84: def api_register():\n85:     body = _json_body()\n86:     username = (body.get(\"username\") or \"\").strip()\n87:     password = (body.get(\"password\") or \"\").strip()\n88: \n89:     if not username or not password:\n90:         return jsonify({\"error\": \"username and password required\"}), 400\n91: \n92:     if not store.system_registration_open():\n93:         return jsonify({\"error\": \"registration closed\"}), 403\n94: \n95:     result = store.user_register(username, password)\n96:     if not result:\n97:         return jsonify({\"error\": \"user already exists\"}), 409\n98: \n99:     return jsonify({\"ok\": True, **result})\n100: \n101: \n102: @app.route(\"/api/login\", methods=[\"POST\"])\n103: def api_login():\n104:     body = _json_body()\n105:     username = (body.get(\"username\") or \"\").strip()\n106:     password = (body.get(\"password\") or \"\").strip()\n107: \n108:     result = store.user_login(username, password)\n109:     if not result:\n110:         return jsonify({\"error\": \"invalid credentials\"}), 401\n111: \n112:     return jsonify({\"ok\": True, **result})\n113: \n114: \n115: @app.route(\"/api/user/info\", methods=[\"GET\"])\n116: @login_required\n117: def api_user_info(user):\n118:     return jsonify({\"ok\": True, **user})\n119: \n120: \n121: # ---------------------------------------------------------------------------\n122: # Web Console — Device management (Token required)\n123: # ---------------------------------------------------------------------------\n124: \n125: @app.route(\"/api/devices\", methods=[\"GET\"])\n126: @login_required\n127: def api_devices_list(user):\n128:     devices = store.device_list_by_user(user[\"username\"])\n129:     return jsonify({\"ok\": True, \"devices\": devices})\n130: \n131: \n132: @app.route(\"/api/devices/bind\", methods=[\"POST\"])\n133: @login_required\n134: def api_devices_bind(user):\n135:     body = _json_body()\n136:     device_code = (body.get(\"device_code\") or \"\").strip()\n137:     name = (body.get(\"name\") or \"\").strip()\n138: \n139:     if not device_code:\n140:         return jsonify({\"error\": \"device_code required\"}), 400\n141: \n142:     result = store.device_bind(user[\"username\"], device_code, name)\n143:     if not result:\n144:         return jsonify({\"error\": \"device already bound\"}), 409\n145: \n146:     return jsonify({\"ok\": True, \"device\": result})\n147: \n148: \n149: @app.route(\"/api/devices/<device_code>/config\", methods=[\"GET\"])\n150: @login_required\n151: def api_devices_config_get(device_code, user):\n152:     # Verify ownership\n153:     dev = store.device_get(device_code)\n154:     if not dev or dev.get(\"owner\") != user[\"username\"]:\n155:         return jsonify({\"error\": \"not found\"}), 404\n156: \n157:     config = store.device_config_get(device_code)\n158:     return jsonify({\"ok\": True, \"config\": config})\n159: \n160: \n161: @app.route(\"/api/devices/<device_code>/config\", methods=[\"POST\"])\n162: @login_required\n163: def api_devices_config_set(device_code, user):\n164:     dev = store.device_get(device_code)\n165:     if not dev or dev.get(\"owner\") != user[\"username\"]:\n166:         return jsonify({\"error\": \"not found\"}), 404\n167: \n168:     body = _json_body()\n169:     config = body.get(\"config\") or body\n170:     store.device_config_set(device_code, config)\n171:     return jsonify({\"ok\": True, \"config\": store.device_config_get(device_code)})\n172: \n173: \n174: @app.route(\"/api/devices/<device_code>/unbind\", methods=[\"DELETE\"])\n175: @login_required\n176: def api_devices_unbind(device_code, user):\n177:     ok = store.device_unbind(device_code, user[\"username\"])\n178:     if not ok:\n179:         return jsonify({\"error\": \"not found or not owned\"}), 404\n180:     return jsonify({\"ok\": True})\n181: \n182: \n183: # ---------------------------------------------------------------------------\n184: # Board API (device_code, no auth)\n185: # ---------------------------------------------------------------------------\n186: \n187: @app.route(\"/api/device/<device_code>/screen\", methods=[\"GET\"])\n188: def api_device_screen(device_code):\n189:     result = store.device_screen(device_code)\n190:     return jsonify({\"ok\": True, **result})\n191: \n192: \n193: @app.route(\"/api/device/<device_code>/voice\", methods=[\"POST\"])\n194: def api_device_voice(device_code):\n195:     # TODO: receive audio file → ASR → LLM → TTS\n196:     return jsonify({\"ok\": True, \"tts\": \"语音功能即将上线\", \"action\": None})\n197: \n198: \n199: @app.route(\"/api/device/<device_code>/heartbeat\", methods=[\"POST\"])\n200: def api_device_heartbeat(device_code):\n201:     store.device_heartbeat(device_code)\n202:     return jsonify({\"ok\": True})\n203: \n204: \n205: @app.route(\"/api/device/<device_code>/config\", methods=[\"GET\"])\n206: def api_device_config_for_board(device_code):\n207:     \"\"\"Board uses this to fetch its full config.\"\"\"\n208:     config = store.device_config_get_for_board(device_code)\n209:     if config is None:\n210:         return jsonify({\"error\": \"device not found\"}), 404\n211:     return jsonify({\"ok\": True, \"config\": config})\n212: \n213: \n214: # ---------------------------------------------------------------------------\n215: # Admin\n216: # ---------------------------------------------------------------------------\n217: \n218: @app.route(\"/api/admin/registration\", methods=[\"GET\"])\n219: @admin_required\n220: def api_admin_registration_get(user):\n221:     return jsonify({\"ok\": True, \"registration_open\": store.system_registration_open()})\n222: \n223: \n224: @app.route(\"/api/admin/registration\", methods=[\"POST\"])\n225: @admin_required\n226: def api_admin_registration(user):\n227:     body = _json_body()\n228:     open_ = body.get(\"open\", True)\n229:     store.system_set_registration(bool(open_))\n230:     return jsonify({\"ok\": True, \"registration_open\": store.system_registration_open()})\n231: \n232: \n233: @app.route(\"/api/admin/users\", methods=[\"GET\"])\n234: @admin_required\n235: def api_admin_users(user):\n236:     users = store.user_list()\n237:     return jsonify({\"ok\": True, \"users\": users})\n238: \n239: \n240: @app.route(\"/api/admin/users/<username>\", methods=[\"DELETE\"])\n241: @admin_required\n242: def api_admin_delete_user(user, username):\n243:     store.user_delete(username)\n244:     return jsonify({\"ok\": True})\n245: \n246: \n247: # ---------------------------------------------------------------------------\n248: # Entry\n249: # ---------------------------------------------------------------------------\n250: \n251: if __name__ == \"__main__\":\n252:     print(\"Smart Kanban Backend starting...\")\n253:     print(\"  /api/register  /api/login\")\n254:     print(\"  /api/devices   /api/device/<code>/screen\")\n255:     app.run(host=\"0.0.0.0\", port=5000, debug=True)\n\n(End of file - total 255 lines)\n</content>","redacted_count":4}
{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":19,"role":"tool","ts":"2026-09-02T05:54:15.193Z","tool_name":"read","tool_call_id":"call_a8ffeccd399c4c6b9f5cb1f8","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\backend\\store.py"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\backend\\store.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Data store for the Smart Kanban backend.\n2: \n3: Uses a single data.json file. In production this would be SQLite / Redis.\n4: Thread-safe via a simple file lock.\n5: \"\"\"\n6: \n7: import json\n8: import os\n9: import hashlib\n10: import secrets\n11: import time\n12: import threading\n13: from datetime import datetime, timezone\n14: \n15: DATA_FILE = os.path.join(os.path.dirname(__file__), \"data.json\")\n16: TOKEN_TTL = 24 * 3600   # 24 hours\n17: _lock = threading.Lock()\n18: \n19: # ---------------------------------------------------------------------------\n20: # Internal helpers\n21: # ---------------------------------------------------------------------------\n22: \n23: def _now_iso():\n24:     return datetime.now(timezone.utc).isoformat()\n25: \n26: def _sha256(s: str) -> str:\n27:     return hashlib.sha256(s.encode()).hexdigest()\n28: \n29: def _token() -> str:\n30:     return secrets.token_hex(32)\n31: \n32: def _load() -> dict:\n33:     if not os.path.exists(DATA_FILE):\n34:         return {\n35:             \"system\": {\"registration_open\": True},\n36:             \"users\": {},\n37:             \"devices\": {},\n38:         }\n39:     with open(DATA_FILE, \"r\", encoding=\"utf-8\") as f:\n40:         return json.load(f)\n41: \n42: def _save(data: dict):\n43:     os.makedirs(os.path.dirname(DATA_FILE), exist_ok=True)\n44:     tmp = DATA_FILE + \".tmp\"\n45:     with open(tmp, \"w\", encoding=\"utf-8\") as f:\n46:         json.dump(data, f, ensure_ascii=False, indent=2)\n47:     os.replace(tmp, DATA_FILE)  # atomic on most OS\n48: \n49: # ---------------------------------------------------------------------------\n50: # Users\n51: # ---------------------------------------------------------------------------\n52: \n53: def user_register(username: str, password: str) -> dict | None:\n54:     \"\"\"Create a user. First user is admin. Returns user dict or None.\"\"\"\n55:     with _lock:\n56:         data = _load()\n57:         if username in data[\"users\"]:\n58:             return None\n59: \n60:         first = len(data[\"users\"]) == 0\n61:         token = _token()\n62:         now = _now_iso()\n63: \n64:         user = {\n65:             \"password_hash\": _sha256(password),\n66:             \"role\": \"admin\" if first else \"user\",\n67:             \"token\": token,\n68:             \"token_created_at\": now,\n69:             \"created_at\": now,\n70:         }\n71:         data[\"users\"][username] = user\n72:         _save(data)\n73:         return {\"username\": username, \"role\": user[\"role\"], \"token\": token}\n74: \n75: \n76: def user_login(username: str, password: str) -> dict | None:\n77:     \"\"\"Authenticate user. Returns {username, role, token} or None.\"\"\"\n78:     with _lock:\n79:         data = _load()\n80:         u = data[\"users\"].get(username)\n81:         if not u:\n82:             return None\n83:         if u[\"password_hash\"] != _sha256(password):\n84:             return None\n85: \n86:         token = _token()\n87:         now = _now_iso()\n88:         u[\"token\"] = token\n89:         u[\"token_created_at\"] = now\n90:         _save(data)\n91:         return {\"username\": username, \"role\": u[\"role\"], \"token\": token}\n92: \n93: \n94: def user_auth(provided_token: str | None) -> dict | None:\n95:     \"\"\"Validate token. Returns user dict or None.\"\"\"\n96:     if not provided_token:\n97:         return None\n98:     with _lock:\n99:         data = _load()\n100:         for name, u in data[\"users\"].items():\n101:             if u.get(\"token\") == provided_token:\n102:                 created = u.get(\"token_created_at\", \"2000-01-01T00:00:00\")\n103:                 try:\n104:                     ts = datetime.fromisoformat(created).timestamp()\n105:                 except ValueError:\n106:                     return None\n107:                 if time.time() - ts > TOKEN_TTL:\n108:                     return None\n109:                 return {\"username\": name, \"role\": u[\"role\"]}\n110:     return None\n111: \n112: \n113: def user_list():\n114:     \"\"\"Admin: list all users.\"\"\"\n115:     with _lock:\n116:         data = _load()\n117:         return [\n118:             {\"username\": n, \"role\": u[\"role\"], \"created_at\": u[\"created_at\"]}\n119:             for n, u in data[\"users\"].items()\n120:         ]\n121: \n122: \n123: def user_delete(username: str):\n124:     \"\"\"Admin: delete a user and unbind their devices.\"\"\"\n125:     with _lock:\n126:         data = _load()\n127:         if username not in data[\"users\"]:\n128:             return\n129:         del data[\"users\"][username]\n130:         # unbind all devices owned by this user\n131:         for code, dev in list(data[\"devices\"].items()):\n132:             if dev.get(\"owner\") == username:\n133:                 data[\"devices\"].pop(code, None)\n134:         _save(data)\n135: \n136: \n137: # ---------------------------------------------------------------------------\n138: # System settings\n139: # ---------------------------------------------------------------------------\n140: \n141: def system_registration_open() -> bool:\n142:     with _lock:\n143:         return _load()[\"system\"].get(\"registration_open\", True)\n144: \n145: \n146: def system_set_registration(open_: bool):\n147:     with _lock:\n148:         data = _load()\n149:         data[\"system\"][\"registration_open\"] = open_\n150:         _save(data)\n151: \n152: \n153: # ---------------------------------------------------------------------------\n154: # Devices\n155: # ---------------------------------------------------------------------------\n156: \n157: def device_bind(username: str, device_code: str, name: str = \"\") -> dict | None:\n158:     \"\"\"Bind a device to a user. Permanent ownership.\"\"\"\n159:     with _lock:\n160:         data = _load()\n161:         dev = data[\"devices\"].get(device_code)\n162:         if dev and dev.get(\"owner\"):\n163:             return None   # already bound to someone\n164:         if not dev:\n165:             dev = {\n166:                 \"name\": name or device_code[:8],\n167:                 \"owner\": username,\n168:                 \"online\": False,\n169:                 \"last_seen\": None,\n170:                 \"config\": {\n171:                     \"display\": {\"brightness\": 80, \"invert\": False},\n172:                     \"eye\": {\"default_expr\": \"平静\", \"auto_blink\": True, \"follow_touch\": True},\n173:                     \"voice\": {\"enabled\": False, \"wake_word\": \"小薇\", \"style\": \"友好亲切\"},\n174:                 },\n175:             }\n176:             data[\"devices\"][device_code] = dev\n177:         else:\n178:             dev[\"owner\"] = username\n179:             dev[\"name\"] = name or dev.get(\"name\", device_code[:8])\n180:         _save(data)\n181:         return dev\n182: \n183: \n184: def device_unbind(device_code: str, username: str | None = None) -> bool:\n185:     \"\"\"Unbind a device. Optional owner check.\"\"\"\n186:     with _lock:\n187:         data = _load()\n188:         dev = data[\"devices\"].get(device_code)\n189:         if not dev or not dev.get(\"owner\"):\n190:             return False\n191:         if username and dev[\"owner\"] != username:\n192:             return False\n193:         # clear ownership, keep config skeleton\n194:         dev[\"owner\"] = None\n195:         dev[\"online\"] = False\n196:         _save(data)\n197:         return True\n198: \n199: \n200: def device_get(device_code: str) -> dict | None:\n201:     \"\"\"Get device by code.\"\"\"\n202:     with _lock:\n203:         dev = _load()[\"devices\"].get(device_code)\n204:         return dict(dev) if dev else None\n205: \n206: \n207: def device_list_by_user(username: str) -> list[dict]:\n208:     \"\"\"List all devices owned by a user.\"\"\"\n209:     with _lock:\n210:         data = _load()\n211:         return [\n212:             {\n213:                 \"device_code\": code,\n214:                 \"name\": dev.get(\"name\", code[:8]),\n215:                 \"online\": dev.get(\"online\", False),\n216:                 \"last_seen\": dev.get(\"last_seen\"),\n217:             }\n218:             for code, dev in data[\"devices\"].items()\n219:             if dev.get(\"owner\") == username\n220:         ]\n221: \n222: \n223: def device_config_get(device_code: str) -> dict | None:\n224:     \"\"\"Get device config. (Web console, authed).\"\"\"\n225:     dev = device_get(device_code)\n226:     if not dev:\n227:         return None\n228:     return dev.get(\"config\", {})\n229: \n230: \n231: def device_config_set(device_code: str, config: dict):\n232:     \"\"\"Merge config into device. (Web console, authed).\"\"\"\n233:     with _lock:\n234:         data = _load()\n235:         dev = data[\"devices\"].get(device_code)\n236:         if not dev:\n237:             return\n238:         existing = dev.get(\"config\", {})\n239:         _deep_merge(existing, config)\n240:         dev[\"config\"] = existing\n241:         _save(data)\n242: \n243: \n244: def device_screen(device_code: str) -> dict:\n245:     \"\"\"Board API: return current screen content.\"\"\"\n246:     dev = device_get(device_code)\n247:     if not dev:\n248:         return {\"type\": \"idle\", \"url\": \"/static/idle.png\"}\n249:     # For now: return simple placeholder based on config mode\n250:     mode = dev.get(\"config\", {}).get(\"mode\", \"wallpaper\")\n251:     return {\"type\": mode, \"url\": f\"/static/{mode}_placeholder.png\"}\n252: \n253: \n254: def device_heartbeat(device_code: str):\n255:     \"\"\"Board API: mark device online.\"\"\"\n256:     with _lock:\n257:         data = _load()\n258:         dev = data[\"devices\"].get(device_code)\n259:         if not dev:\n260:             return\n261:         dev[\"online\"] = True\n262:         dev[\"last_seen\"] = _now_iso()\n263:         _save(data)\n264: \n265: \n266: def device_config_get_for_board(device_code: str) -> dict | None:\n267:     \"\"\"Board API: get config without auth.\"\"\"\n268:     dev = device_get(device_code)\n269:     if not dev:\n270:         return None\n271:     return dev.get(\"config\", {})\n272: \n273: \n274: # ---------------------------------------------------------------------------\n275: # Utility\n276: # ---------------------------------------------------------------------------\n277: \n278: def _deep_merge(base: dict, overlay: dict):\n279:     \"\"\"Merge overlay into base in-place.\"\"\"\n280:     for k, v in overlay.items():\n281:         if isinstance(v, dict) and isinstance(base.get(k), dict):\n282:             _deep_merge(base[k], v)\n283:         else:\n284:             base[k] = v\n\n(End of file - total 284 lines)\n</content>"}
{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":20,"role":"tool","ts":"2026-09-02T05:54:15.193Z","tool_name":"read","tool_call_id":"call_0a05d586618d493a826a3330","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\backend\\requirements.txt"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\backend\\requirements.txt</path>\n<type>file</type>\n<content>\n1: flask>=3.0\n2: flask-cors>=4.0\n3: requests>=2.31\n\n(End of file - total 3 lines)\n</content>"}
{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":21,"role":"tool","ts":"2026-09-02T05:54:15.193Z","tool_name":"read","tool_call_id":"call_87f3aabc26de4b4882e1fd50","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\backend\\README.md"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\backend\\README.md</path>\n<type>file</type>\n<content>\n1: # 后端（Flask）— AI 眼睛助手云端服务\n2: \n3: 为板端 `eye_app` 提供用户 / 设备 / 配置管理与通信接口；Web 控制台见 `web/`。\n4: > 注：早期曾命名为「Smart Kanban Backend」，`app.py` 启动日志里仍残留该字符串，不影响运行。\n5: \n6: ## 运行\n7: \n8: ```bash\n9: cd backend\n10: pip install -r requirements.txt\n11: python app.py\n12: ```\n13: \n14: 默认监听 `http://0.0.0.0:5000`，已开启 CORS（方便本地官网 / 模拟器联调）。\n15: \n16: ## API\n17: \n18: ### 用户 / 设备（Bearer ***REDACTED***）\n19: | API | 方法 | 说明 |\n20: |-----|------|------|\n21: | `/api/register` | POST | 注册 `{username,password}` → `{token,user_id}` |\n22: | `/api/login` | POST | 登录 `{username,password}` → `{token}` |\n23: | `/api/devices` | GET | 当前用户设备列表 |\n24: | `/api/devices/bind` | POST | 绑定设备码 `{device_code,name}` |\n25: | `/api/devices/<code>/config` | GET / POST | 拉取 / 更新设备配置 |\n26: | `/api/devices/<code>/unbind` | DELETE | 解绑 |\n27: \n28: ### 板端（device_code，无鉴权）\n29: | API | 方法 | 说明 |\n30: |-----|------|------|\n31: | `/api/device/<code>/screen` | GET | 屏配置 |\n32: | `/api/device/<code>/config` | GET | 板端拉全量配置 |\n33: | `/api/device/<code>/heartbeat` | POST | 心跳保活 |\n34: | `/api/device/<code>/voice` | POST | **语音链路（TODO 占位）**：当前仅返回 `{\"tts\":\"语音功能即将上线\",\"action\":null}`，尚未接入 ASR / LLM / TTS |\n35: \n36: ### 管理（admin Token）\n37: | API | 方法 | 说明 |\n38: |-----|------|------|\n39: | `/api/admin/registration` | GET / POST | 开关系统注册 |\n40: | `/api/admin/users` | GET | 用户列表 |\n41: | `/api/admin/users/<username>` | DELETE | 删除用户 |\n42: \n43: ## 存储\n44: \n45: - 开发期使用本地 `data.json`（已被 `.gitignore` 忽略，避免提交密钥）。\n46: - **`/voice` 尚未实现真正的 ASR / LLM / TTS**，仅占位；接入点见 `app.py` 的 `api_device_voice()`。\n47: \n48: ## 下一步\n49: \n50: - 实现 `/voice`：收音频 → ASR → LLM（对话 / 意图）→ TTS，返回 `tts` 文本或音频，并据 `action` 让板端切换表情（聆听 / 说话等）。\n\n(End of file - total 50 lines)\n</content>","redacted_count":1}
