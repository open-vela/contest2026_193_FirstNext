{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":25,"role":"tool","ts":"2026-09-02T05:54:15.197Z","tool_name":"read","tool_call_id":"call_4f140bf26aef4ec7807e948d","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app\\my_assistant_main.c"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app\\my_assistant_main.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * my_assistant_main.c - OpenVela 智能信息看板 (Team 193 FirstNext)\n3:  *\n4:  * 与 PC 模拟器 (lvgl_sim/main/src/main.c) 共用同一套 UI 逻辑\n5:  * 差异：NuttX 帧缓冲初始化 + 字体从 /etc/fonts 加载 + WiFi 为真实连接\n6:  *\n7:  * 页面结构：\n8:  *   - 主页 (HOME)     ：大时钟 + 日期 + 问候 + 设备在线\n9:  *   - 设置页 (SETTINGS)：列表，WiFi / 蓝牙\n10:  *   - WiFi 页 (WIFI)  ：独立页面，真实扫描并连接一个网络\n11:  *   - 底部按钮          ：随页面切换图标（设置 <-> 主页）\n12:  *\n13:  * 真实 WiFi：\n14:  *   - 扫描：system(\"sh /data/get_wifi.sh > /tmp/wifi_scan_result.txt\")\n15:  *            文件格式 bssid/频率/信号/加密/ssid，第5字段为 SSID\n16:  *   - 连接：save_wifi_config() 写 /data/wifi.cfg（SSID + PASSWORD）\n17:  *            板子固件读取该配置进行联网\n18:  ****************************************************************************/\n19: \n20: #include <nuttx/config.h>\n21: #include <stdio.h>\n22: #include <stdlib.h>\n23: #include <stdint.h>\n24: #include <string.h>\n25: #include <unistd.h>\n26: #include <time.h>\n27: #include <fcntl.h>\n28: #include <sys/boardctl.h>\n29: \n30: #include <lvgl/lvgl.h>\n31: \n32: /****************************************************************************\n33:  * 服务器配置（本地联调用 PC 局域网 IP，部署时改为公网 IP/域名）\n34:  ****************************************************************************/\n35: \n36: #define SERVER_HOST   \"192.168.1.7\"\n37: #define SERVER_PORT   5000\n38: #define POLL_INTERVAL 10000   /* 轮询间隔 10 秒 */\n39: \n40: /* 设备码文件路径 */\n41: #define DEVICE_CODE_FILE \"/data/device_code\"\n42: \n43: /* NTP 服务器（暂未启用，需要 ntpdate 命令支持） */\n44: #define NTP_SERVER    \"ntp.aliyun.com\"\n45: \n46: /* 当前显示模式 */\n47: typedef enum { SCREEN_IDLE, SCREEN_WALLPAPER, SCREEN_NEWS } screen_mode_t;\n48: \n49: /****************************************************************************\n50:  * Board constants (match R528 DshanPi 320x480)\n51:  ****************************************************************************/\n52: \n53: #define SCREEN_W 320\n54: #define SCREEN_H 480\n55: \n56: #define NAV_BAR_H  50\n57: #define CONTENT_H  (SCREEN_H - NAV_BAR_H)\n58: \n59: /* ---- 设计色板（与模拟器保持一致） ---- */\n60: #define C_BG_TOP    0x1E293B   /* 主页渐变上 */\n61: #define C_BG_BOT    0x0F172A   /* 主页渐变下 */\n62: #define C_SURFACE   0xFFFFFF    /* 卡片白 */\n63: #define C_BORDER    0xE5E7EB   /* 描边灰 */\n64: #define C_TEXT      0x1F2937   /* 主文字 */\n65: #define C_TEXT_SUB  0x9CA3AF   /* 次文字 */\n66: #define C_PRIMARY   0x2563EB   /* 品牌蓝 */\n67: #define C_ACCENT    0x34D399   /* 在线绿 */\n68: #define C_HOME_TEXT 0xFFFFFF    /* 主页主文字 */\n69: #define C_HOME_SUB  0x94A3B8   /* 主页次文字 */\n70: \n71: static const lv_font_t *g_font_cn = NULL;\n72: \n73: /* 页面枚举 */\n74: typedef enum { PAGE_HOME, PAGE_SETTINGS, PAGE_WIFI } page_id_t;\n75: static page_id_t g_page = PAGE_HOME;\n76: \n77: /* 前置声明 */\n78: static void show_page(page_id_t p);\n79: static void bottom_btn_cb(lv_event_t *e);\n80: static void enter_wifi_cb(lv_event_t *e);\n81: static void wifi_item_cb(lv_event_t *e);\n82: static void build_wifi_list(lv_obj_t *parent);\n83: static void build_password_sheet(lv_obj_t *parent);\n84: static void wifi_check_status_cb(lv_timer_t *t);\n85: static void wifi_scan_real(void);\n86: static int  get_wifi_ssids(char ap_names[][33], int max_count);\n87: static int  save_wifi_config(const char *ssid, const char *password);\n88: \n89: /* 页面与控件句柄 */\n90: static lv_obj_t *g_home_page     = NULL;\n91: static lv_obj_t *g_settings_page = NULL;\n92: static lv_obj_t *g_wifi_page     = NULL;\n93: static lv_obj_t *g_wifi_list_cont = NULL;   /* WiFi 页可滚动列表容器 */\n94: static lv_obj_t *g_wifi_banner   = NULL;   /* WiFi 页顶部连接状态横幅 */\n95: static lv_obj_t *g_wifi_banner_lbl = NULL; /* 横幅文字 */\n96: static lv_obj_t *g_pwd_sheet     = NULL;\n97: static lv_obj_t *g_pwd_panel     = NULL;   /* 密码弹层 */\n98: static lv_obj_t *g_wifi_status   = NULL;   /* 设置页 WiFi 项右侧状态 */\n99: static lv_obj_t *g_clock_label   = NULL;   /* 主页大时钟 */\n100: static lv_obj_t *g_date_label    = NULL;   /* 主页日期 */\n101: static lv_obj_t *g_time_label    = NULL;   /* 底部栏时间 */\n102: static lv_obj_t *g_set_btn       = NULL;   /* 底部切换按钮 */\n103: static lv_obj_t *g_set_btn_lbl   = NULL;   /* 底部切换按钮图标 */\n104: static lv_obj_t *g_wifi_icon     = NULL;   /* 底栏 WiFi 图标 */\n105: static char      g_wifi_ssid[64] = \"\";\n106: \n107: /* 密码输入面板（加密 WiFi 使用） */\n108: static lv_obj_t *g_pwd_ssid_label = NULL;\n109: static lv_obj_t *g_pwd_textarea  = NULL;\n110: static char      g_pending_ssid[64] = \"\";\n111: \n112: /* 真实扫描得到的 WiFi 热点（bssid/频率/信号/加密/ssid，取 SSID） */\n113: static char g_ap_names[64][33] = { {0} };\n114: static int  g_ap_count = 0;\n115: \n116: /* 设备码 & 云端状态 */\n117: static char g_device_code[16] = \"\";   /* 8 位短码 */\n118: static screen_mode_t g_screen_mode = SCREEN_IDLE;\n119: static lv_obj_t *g_dev_code_lbl  = NULL;   /* 设置页设备码标签 */\n120: static lv_obj_t *g_status_lbl    = NULL;   /* 设置页云端状态 */\n121: static int g_ntp_synced = 0;              /* NTP 是否已同步 */\n122: \n123: /****************************************************************************\n124:  * Helpers\n125:  ****************************************************************************/\n126: \n127: static lv_color_t color_hex(uint32_t hex)\n128: {\n129:   return lv_color_hex(hex);\n130: }\n131: \n132: static void set_cn_font(lv_obj_t *obj)\n133: {\n134:   if (g_font_cn)\n135:     lv_obj_set_style_text_font(obj, g_font_cn, 0);\n136: }\n137: \n138: /* 统一风格的设置列表项：左标题 + 右侧（状态 + 可选箭头） */\n139: static lv_obj_t *make_list_item(lv_obj_t *parent, const char *title,\n140:                                 lv_obj_t **status_out, bool chevron)\n141: {\n142:   lv_obj_t *item = lv_obj_create(parent);\n143:   lv_obj_set_width(item, SCREEN_W - 24);\n144:   lv_obj_set_height(item, 54);\n145:   lv_obj_set_style_bg_color(item, color_hex(C_HOME_TEXT), 0);\n146:   lv_obj_set_style_bg_opa(item, 12, 0);\n147:   lv_obj_set_style_bg_color(item, color_hex(0x334155), LV_STATE_PRESSED);\n148:   lv_obj_set_style_border_width(item, 0, 0);\n149:   lv_obj_set_style_radius(item, 14, 0);\n150:   lv_obj_set_style_pad_left(item, 16, 0);\n151:   lv_obj_set_style_pad_right(item, 16, 0);\n152:   lv_obj_set_style_pad_top(item, 0, 0);\n153:   lv_obj_set_style_pad_bottom(item, 0, 0);\n154:   lv_obj_clear_flag(item, LV_OBJ_FLAG_SCROLLABLE);\n155:   lv_obj_set_flex_flow(item, LV_FLEX_FLOW_ROW);\n156:   lv_obj_set_flex_align(item, LV_FLEX_ALIGN_SPACE_BETWEEN,\n157:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n158: \n159:   lv_obj_t *title_lbl = lv_label_create(item);\n160:   lv_obj_set_style_text_color(title_lbl, color_hex(C_HOME_TEXT), 0);\n161:   lv_obj_set_style_text_font(title_lbl, &lv_font_montserrat_16, 0);\n162:   set_cn_font(title_lbl);\n163:   lv_label_set_text(title_lbl, title);\n164:   lv_obj_set_style_min_width(title_lbl, 55, 0);\n165: \n166:   /* 右侧容器：状态 + 箭头（固定宽度防点阵字体截断） */\n167:   lv_obj_t *right = lv_obj_create(item);\n168:   lv_obj_set_width(right, 110);\n169:   lv_obj_set_style_bg_opa(right, LV_OPA_TRANSP, 0);\n170:   lv_obj_set_style_border_width(right, 0, 0);\n171:   lv_obj_set_style_pad_all(right, 0, 0);\n172:   lv_obj_set_style_shadow_width(right, 0, 0);\n173:   lv_obj_set_style_outline_width(right, 0, 0);\n174:   lv_obj_clear_flag(right, LV_OBJ_FLAG_SCROLLABLE);\n175:   lv_obj_set_flex_flow(right, LV_FLEX_FLOW_ROW);\n176:   lv_obj_set_flex_align(right, LV_FLEX_ALIGN_END,\n177:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n178:   lv_obj_set_style_pad_column(right, 8, 0);\n179: \n180:   lv_obj_t *status = lv_label_create(right);\n181:   lv_obj_set_style_text_color(status, color_hex(C_HOME_SUB), 0);\n182:   set_cn_font(status);\n183:   lv_label_set_text(status, \"未连接\");\n184: \n185:   if (chevron)\n186:     {\n187:       lv_obj_t *ch = lv_label_create(right);\n188:       lv_obj_set_style_text_color(ch, color_hex(C_HOME_SUB), 0);\n189:       lv_obj_set_style_text_font(ch, &lv_font_montserrat_16, 0);\n190:       lv_label_set_text(ch, \">\");\n191:     }\n192: \n193:   if (status_out)\n194:     *status_out = status;\n195: \n196:   return item;\n197: }\n198: \n199: /****************************************************************************\n200:  * Bottom bar (time + WiFi + settings)\n201:  ****************************************************************************/\n202: \n203: static void build_bottom_nav(lv_obj_t *parent)\n204: {\n205:   lv_obj_t *bar = lv_obj_create(parent);\n206:   lv_obj_set_size(bar, SCREEN_W, NAV_BAR_H);\n207:   lv_obj_set_pos(bar, 0, SCREEN_H - NAV_BAR_H);\n208:   lv_obj_set_style_bg_color(bar, color_hex(0x111827), 0);\n209:   lv_obj_set_style_border_width(bar, 0, 0);\n210:   lv_obj_set_style_pad_all(bar, 6, 0);\n211:   /* 顶部细分隔线 */\n212:   lv_obj_set_style_pad_top(bar, 7, 0);\n213:   lv_obj_set_style_outline_color(bar, color_hex(0x1F2937), 0);\n214:   lv_obj_set_style_outline_width(bar, 1, LV_PART_MAIN);\n215:   lv_obj_clear_flag(bar, LV_OBJ_FLAG_SCROLLABLE);\n216: \n217:   /* 左侧：WiFi 图标 + 时间 */\n218:   lv_obj_t *left = lv_obj_create(bar);\n219:   lv_obj_set_size(left, LV_SIZE_CONTENT, LV_SIZE_CONTENT);\n220:   lv_obj_align(left, LV_ALIGN_LEFT_MID, 4, 0);\n221:   lv_obj_set_style_bg_opa(left, LV_OPA_TRANSP, 0);\n222:   lv_obj_set_style_border_width(left, 0, 0);\n223:   lv_obj_set_style_pad_all(left, 0, 0);\n224:   lv_obj_set_style_shadow_width(left, 0, 0);\n225:   lv_obj_set_style_outline_width(left, 0, 0);\n226:   lv_obj_clear_flag(left, LV_OBJ_FLAG_SCROLLABLE);\n227:   lv_obj_set_flex_flow(left, LV_FLEX_FLOW_ROW);\n228:   lv_obj_set_flex_align(left, LV_FLEX_ALIGN_START,\n229:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n230: \n231:   g_wifi_icon = lv_label_create(left);\n232:   lv_obj_set_style_text_color(g_wifi_icon, color_hex(C_TEXT_SUB), 0);\n233:   lv_label_set_text(g_wifi_icon, LV_SYMBOL_WIFI);\n234: \n235:   g_time_label = lv_label_create(left);\n236:   lv_obj_set_style_text_color(g_time_label, color_hex(C_HOME_TEXT), 0);\n237:   lv_obj_set_style_text_font(g_time_label, &lv_font_montserrat_16, 0);\n238:   lv_obj_set_style_pad_left(g_time_label, 6, 0);\n239:   lv_label_set_text(g_time_label, \"00:00\");\n240: \n241:   /* 右侧：切换按钮（随当前页面在 设置/主页 图标间切换） */\n242:   g_set_btn = lv_btn_create(bar);\n243:   lv_obj_set_size(g_set_btn, 30, 30);\n244:   lv_obj_align(g_set_btn, LV_ALIGN_RIGHT_MID, -4, 0);\n245:   lv_obj_set_style_bg_color(g_set_btn, color_hex(0x374151), 0);\n246:   lv_obj_set_style_bg_color(g_set_btn, color_hex(0x4B5563), LV_STATE_PRESSED);\n247:   lv_obj_set_style_shadow_width(g_set_btn, 0, 0);\n248:   lv_obj_set_style_radius(g_set_btn, 8, 0);\n249:   lv_obj_add_event_cb(g_set_btn, bottom_btn_cb, LV_EVENT_CLICKED, NULL);\n250:   g_set_btn_lbl = lv_label_create(g_set_btn);\n251:   lv_obj_set_style_text_color(g_set_btn_lbl, color_hex(0xF9FAFB), 0);\n252:   lv_label_set_text(g_set_btn_lbl, LV_SYMBOL_SETTINGS);\n253:   lv_obj_center(g_set_btn_lbl);\n254: }\n255: \n256: /* 时间 / 日期刷新（驱动底栏时间与主页时钟） */\n257: static void update_time_cb(lv_timer_t *timer)\n258: {\n259:   LV_UNUSED(timer);\n260:   time_t t = time(NULL);\n261:   struct tm *tm = localtime(&t);\n262:   char buf[16];\n263:   snprintf(buf, sizeof(buf), \"%02d:%02d\", tm->tm_hour, tm->tm_min);\n264:   if (g_time_label)\n265:     lv_label_set_text(g_time_label, buf);\n266:   if (g_clock_label)\n267:     lv_label_set_text(g_clock_label, buf);\n268: \n269:   static const char *wd[] = {\"日\", \"一\", \"二\", \"三\", \"四\", \"五\", \"六\"};\n270:   char dbuf[32];\n271:   snprintf(dbuf, sizeof(dbuf), \"%d年%d月%d日 星期%s\",\n272:            tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday, wd[tm->tm_wday]);\n273:   if (g_date_label)\n274:     lv_label_set_text(g_date_label, dbuf);\n275: \n276:   /* WiFi 图标状态：已连接 → 绿色，未连接 → 灰色 */\n277:   if (g_wifi_icon)\n278:     lv_obj_set_style_text_color(g_wifi_icon,\n279:       color_hex(g_wifi_ssid[0] ? C_ACCENT : C_TEXT_SUB), 0);\n280: }\n281: \n282: /****************************************************************************\n283:  * Home page — 简洁风格\n284:  ****************************************************************************/\n285: \n286: static void build_home_page(lv_obj_t *parent)\n287: {\n288:   lv_obj_t *page = lv_obj_create(parent);\n289:   lv_obj_set_size(page, SCREEN_W, CONTENT_H);\n290:   lv_obj_set_pos(page, 0, 0);\n291:   lv_obj_set_style_bg_color(page, color_hex(C_BG_BOT), 0);\n292:   lv_obj_set_style_border_width(page, 0, 0);\n293:   lv_obj_clear_flag(page, LV_OBJ_FLAG_SCROLLABLE);\n294:   lv_obj_set_flex_flow(page, LV_FLEX_FLOW_COLUMN);\n295:   lv_obj_set_flex_align(page, LV_FLEX_ALIGN_CENTER,\n296:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n297:   lv_obj_set_style_pad_top(page, 60, 0);\n298:   g_home_page = page;\n299: \n300:   /* 设备状态胶囊 */\n301:   lv_obj_t *pill = lv_obj_create(page);\n302:   lv_obj_set_width(pill, LV_SIZE_CONTENT);\n303:   lv_obj_set_height(pill, 28);\n304:   lv_obj_set_style_bg_color(pill, color_hex(C_HOME_TEXT), 0);\n305:   lv_obj_set_style_bg_opa(pill, 12, 0);\n306:   lv_obj_set_style_border_width(pill, 0, 0);\n307:   lv_obj_set_style_radius(pill, 14, 0);\n308:   lv_obj_set_style_pad_left(pill, 12, 0);\n309:   lv_obj_set_style_pad_right(pill, 12, 0);\n310:   lv_obj_set_style_pad_top(pill, 0, 0);\n311:   lv_obj_set_style_pad_bottom(pill, 0, 0);\n312:   lv_obj_clear_flag(pill, LV_OBJ_FLAG_SCROLLABLE);\n313:   lv_obj_set_flex_flow(pill, LV_FLEX_FLOW_ROW);\n314:   lv_obj_set_flex_align(pill, LV_FLEX_ALIGN_CENTER,\n315:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n316:   lv_obj_set_style_pad_column(pill, 6, 0);\n317: \n318:   lv_obj_t *dot = lv_obj_create(pill);\n319:   lv_obj_set_size(dot, 8, 8);\n320:   lv_obj_set_style_radius(dot, 4, 0);\n321:   lv_obj_set_style_bg_color(dot, color_hex(C_ACCENT), 0);\n322:   lv_obj_set_style_border_width(dot, 0, 0);\n323:   lv_obj_clear_flag(dot, LV_OBJ_FLAG_SCROLLABLE);\n324: \n325:   lv_obj_t *pill_txt = lv_label_create(pill);\n326:   lv_obj_set_style_text_color(pill_txt, color_hex(C_HOME_SUB), 0);\n327:   set_cn_font(pill_txt);\n328:   lv_label_set_text(pill_txt, \"设备在线\");\n329: \n330:   /* 大时钟 */\n331:   g_clock_label = lv_label_create(page);\n332:   lv_obj_set_style_text_color(g_clock_label, color_hex(C_HOME_TEXT), 0);\n333:   lv_obj_set_style_text_font(g_clock_label, &lv_font_montserrat_16, 0);\n334:   lv_obj_set_style_margin_top(g_clock_label, 28, 0);\n335:   lv_label_set_text(g_clock_label, \"00:00\");\n336: \n337:   /* 日期 */\n338:   g_date_label = lv_label_create(page);\n339:   lv_obj_set_style_text_color(g_date_label, color_hex(C_HOME_SUB), 0);\n340:   set_cn_font(g_date_label);\n341:   lv_label_set_text(g_date_label, \"2026年8月23日\");\n342: \n343:   /* 问候 */\n344:   lv_obj_t *greet = lv_label_create(page);\n345:   lv_obj_set_style_text_color(greet, color_hex(0xCBD5E1), 0);\n346:   set_cn_font(greet);\n347:   lv_obj_set_style_margin_top(greet, 10, 0);\n348:   lv_label_set_text(greet, \"欢迎使用 OpenVela\");\n349: }\n350: \n351: /****************************************************************************\n352:  * Settings page\n353:  ****************************************************************************/\n354: \n355: static void bt_toggle_cb(lv_event_t *e)\n356: {\n357:   lv_obj_t *st = (lv_obj_t *)lv_event_get_user_data(e);\n358:   const char *t = lv_label_get_text(st);\n359:   lv_label_set_text(st, (strcmp(t, \"关闭\") == 0) ? \"已开启\" : \"关闭\");\n360: }\n361: \n362: static void build_settings_page(lv_obj_t *parent)\n363: {\n364:   lv_obj_t *page = lv_obj_create(parent);\n365:   lv_obj_set_size(page, SCREEN_W, CONTENT_H);\n366:   lv_obj_set_pos(page, 0, 0);\n367:   lv_obj_set_style_bg_opa(page, LV_OPA_TRANSP, 0);\n368:   lv_obj_set_style_border_width(page, 0, 0);\n369:   lv_obj_clear_flag(page, LV_OBJ_FLAG_SCROLLABLE);\n370:   lv_obj_set_flex_flow(page, LV_FLEX_FLOW_COLUMN);\n371:   lv_obj_set_flex_align(page, LV_FLEX_ALIGN_START,\n372:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n373:   lv_obj_set_style_pad_top(page, 12, 0);\n374:   lv_obj_set_style_pad_bottom(page, 12, 0);\n375:   lv_obj_set_style_pad_row(page, 10, 0);\n376:   lv_obj_add_flag(page, LV_OBJ_FLAG_HIDDEN);\n377:   g_settings_page = page;\n378: \n379:   /* ---- 设备绑定卡片 ---- */\n380:   lv_obj_t *bind_card = lv_obj_create(page);\n381:   lv_obj_set_width(bind_card, SCREEN_W - 24);\n382:   lv_obj_set_height(bind_card, LV_SIZE_CONTENT);\n383:   lv_obj_set_style_bg_color(bind_card, color_hex(C_HOME_TEXT), 0);\n384:   lv_obj_set_style_bg_opa(bind_card, 8, 0);\n385:   lv_obj_set_style_border_width(bind_card, 0, 0);\n386:   lv_obj_set_style_radius(bind_card, 14, 0);\n387:   lv_obj_set_style_pad_all(bind_card, 14, 0);\n388:   lv_obj_clear_flag(bind_card, LV_OBJ_FLAG_SCROLLABLE);\n389:   lv_obj_set_flex_flow(bind_card, LV_FLEX_FLOW_COLUMN);\n390:   lv_obj_set_flex_align(bind_card, LV_FLEX_ALIGN_START,\n391:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n392:   lv_obj_set_style_pad_row(bind_card, 8, 0);\n393: \n394:   /* 标题 */\n395:   lv_obj_t *bind_title = lv_label_create(bind_card);\n396:   lv_obj_set_style_text_color(bind_title, color_hex(0xcbd5e1), 0);\n397:   set_cn_font(bind_title);\n398:   lv_label_set_text(bind_title, \"设备绑定\");\n399: \n400:   /* 设备码 */\n401:   lv_obj_t *code_row = lv_obj_create(bind_card);\n402:   lv_obj_set_width(code_row, SCREEN_W - 52);\n403:   lv_obj_set_height(code_row, LV_SIZE_CONTENT);\n404:   lv_obj_set_style_bg_opa(code_row, LV_OPA_TRANSP, 0);\n405:   lv_obj_set_style_border_width(code_row, 0, 0);\n406:   lv_obj_set_style_pad_all(code_row, 0, 0);\n407:   lv_obj_clear_flag(code_row, LV_OBJ_FLAG_SCROLLABLE);\n408:   lv_obj_set_flex_flow(code_row, LV_FLEX_FLOW_ROW);\n409:   lv_obj_set_flex_align(code_row, LV_FLEX_ALIGN_SPACE_BETWEEN,\n410:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n411: \n412:   lv_obj_t *code_lbl = lv_label_create(code_row);\n413:   lv_obj_set_style_text_color(code_lbl, color_hex(0x94a3b8), 0);\n414:   set_cn_font(code_lbl);\n415:   lv_label_set_text(code_lbl, \"设备码\");\n416: \n417:   g_dev_code_lbl = lv_label_create(code_row);\n418:   lv_obj_set_style_text_color(g_dev_code_lbl, color_hex(0xffffff), 0);\n419:   lv_obj_set_style_text_font(g_dev_code_lbl, &lv_font_montserrat_16, 0);\n420:   lv_label_set_text(g_dev_code_lbl, g_device_code);\n421: \n422:   /* 云端状态 */\n423:   lv_obj_t *status_row = lv_obj_create(bind_card);\n424:   lv_obj_set_width(status_row, SCREEN_W - 52);\n425:   lv_obj_set_height(status_row, LV_SIZE_CONTENT);\n426:   lv_obj_set_style_bg_opa(status_row, LV_OPA_TRANSP, 0);\n427:   lv_obj_set_style_border_width(status_row, 0, 0);\n428:   lv_obj_set_style_pad_all(status_row, 0, 0);\n429:   lv_obj_clear_flag(status_row, LV_OBJ_FLAG_SCROLLABLE);\n430:   lv_obj_set_flex_flow(status_row, LV_FLEX_FLOW_ROW);\n431:   lv_obj_set_flex_align(status_row, LV_FLEX_ALIGN_SPACE_BETWEEN,\n432:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n433: \n434:   lv_obj_t *st_lbl = lv_label_create(status_row);\n435:   lv_obj_set_style_text_color(st_lbl, color_hex(0x94a3b8), 0);\n436:   set_cn_font(st_lbl);\n437:   lv_label_set_text(st_lbl, \"状态\");\n438: \n439:   g_status_lbl = lv_label_create(status_row);\n440:   lv_obj_set_style_text_color(g_status_lbl, color_hex(0xfbbf24), 0);\n441:   set_cn_font(g_status_lbl);\n442:   lv_label_set_text(g_status_lbl, \"等待绑定...\");\n443: \n444:   /* ---- 分隔线 ---- */\n445:   lv_obj_t *sep = lv_obj_create(page);\n446:   lv_obj_set_width(sep, SCREEN_W - 24);\n447:   lv_obj_set_height(sep, 1);\n448:   lv_obj_set_style_bg_color(sep, color_hex(0x1e293b), 0);\n449:   lv_obj_set_style_border_width(sep, 0, 0);\n450:   lv_obj_clear_flag(sep, LV_OBJ_FLAG_SCROLLABLE);\n451: \n452:   /* ---- WiFi ---- */\n453:   lv_obj_t *wifi_item = make_list_item(page, \"WiFi\", &g_wifi_status, true);\n454:   lv_obj_add_event_cb(wifi_item, enter_wifi_cb, LV_EVENT_CLICKED, NULL);\n455: \n456:   /* ---- 蓝牙 ---- */\n457:   lv_obj_t *bt_item = make_list_item(page, \"蓝牙\", NULL, true);\n458:   lv_obj_t *bt_status = lv_obj_get_child(bt_item, 1);\n459:   lv_obj_t *bt_st_lbl = bt_status ? lv_obj_get_child(bt_status, 0) : NULL;\n460:   if (bt_st_lbl)\n461:     {\n462:       lv_label_set_text(bt_st_lbl, \"关闭\");\n463:       lv_obj_add_event_cb(bt_item, bt_toggle_cb, LV_EVENT_CLICKED,\n464:                           (void *)bt_st_lbl);\n465:     }\n466: }\n467: \n468: /****************************************************************************\n469:  * WiFi page (独立页面：真实扫描并连接一个网络)\n470:  ****************************************************************************/\n471: \n472: /* WiFi 页顶部横幅：显示 连接中 / 已连接 / 超时 */\n473: static void wifi_banner_show(const char *text, uint32_t bg)\n474: {\n475:   if (g_wifi_banner == NULL || g_wifi_banner_lbl == NULL)\n476:     return;\n477:   lv_label_set_text(g_wifi_banner_lbl, text);\n478:   lv_obj_set_style_bg_color(g_wifi_banner, color_hex(bg), 0);\n479:   lv_obj_clear_flag(g_wifi_banner, LV_OBJ_FLAG_HIDDEN);\n480: }\n481: \n482: /* 真实 WiFi 连接入口：写配置文件，板子固件读取后联网 */\n483: static int g_wifi_check_count = 0;\n484: \n485: static void wifi_connect(const char *ssid, const char *pwd)\n486: {\n487:   char buf[96];\n488: \n489:   lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n490:   if (g_wifi_status)\n491:     lv_label_set_text(g_wifi_status, \"连接中...\");\n492: \n493:   snprintf(buf, sizeof(buf), \"正在连接 %s ...\", ssid);\n494:   wifi_banner_show(buf, 0x475569);\n495: \n496:   /* 写入 /data/wifi.cfg，板子固件读取此文件进行联网 */\n497:   save_wifi_config(ssid, pwd);\n498: \n499:   /* 重置 NTP 同步标记，连接成功后重新校时 */\n500:   g_ntp_synced = 0;\n501: \n502:   /* 每秒轮询真实关联状态，最多 20 秒 */\n503:   g_wifi_check_count = 0;\n504:   lv_timer_create(wifi_check_status_cb, 1000, NULL);\n505: }\n506: \n507: /* 轮询 wapi 状态：wlan0 关联的 ESSID 与目标一致才算真的连上 */\n508: static void wifi_check_status_cb(lv_timer_t *t)\n509: {\n510:   char buf[96];\n511:   bool connected = false;\n512: \n513:   g_wifi_check_count++;\n514: \n515:   int rc = system(\"wapi show wlan0 > /data/wifi_state.txt 2>&1\");\n516:   LV_UNUSED(rc);\n517: \n518:   FILE *fp = fopen(\"/data/wifi_state.txt\", \"r\");\n519:   if (fp)\n520:     {\n521:       char line[160];\n522:       while (fgets(line, sizeof(line), fp))\n523:         {\n524:           if (g_pending_ssid[0] != '\\0' && strstr(line, g_pending_ssid))\n525:             {\n526:               connected = true;\n527:               break;\n528:             }\n529:         }\n530:       fclose(fp);\n531:     }\n532: \n533:   if (connected)\n534:     {\n535:       strncpy(g_wifi_ssid, g_pending_ssid, sizeof(g_wifi_ssid) - 1);\n536:       g_wifi_ssid[sizeof(g_wifi_ssid) - 1] = '\\0';\n537:       if (g_wifi_status)\n538:         lv_label_set_text(g_wifi_status, \"已连接\");\n539:       snprintf(buf, sizeof(buf), \"已连接: %s\", g_wifi_ssid);\n540:       wifi_banner_show(buf, 0x059669);   /* 绿色 */\n541:       printf(\"WiFi connected: %s\\n\", g_wifi_ssid);\n542:       lv_timer_del(t);\n543:     }\n544:   else if (g_wifi_check_count >= 20)\n545:     {\n546:       if (g_wifi_status)\n547:         lv_label_set_text(g_wifi_status, \"未连接\");\n548:       wifi_banner_show(\"连接超时，请检查密码后重试\", 0xDC2626);  /* 红色 */\n549:       printf(\"WiFi connect timeout: %s\\n\", g_pending_ssid);\n550:       lv_timer_del(t);\n551:     }\n552: }\n553: \n554: static void wifi_item_cb(lv_event_t *e)\n555: {\n556:   int idx = (int)(intptr_t)lv_event_get_user_data(e);\n557:   if (idx < 0 || idx >= g_ap_count)\n558:     return;\n559:   const char *ssid = g_ap_names[idx];\n560: \n561:   /* 真实网络统一按加密处理（开放网络输入空密码亦可连接） */\n562:   strncpy(g_pending_ssid, ssid, sizeof(g_pending_ssid) - 1);\n563:   g_pending_ssid[sizeof(g_pending_ssid) - 1] = '\\0';\n564:   lv_label_set_text(g_pwd_ssid_label, ssid);\n565:   lv_textarea_set_text(g_pwd_textarea, \"\");\n566:   lv_obj_clear_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n567:   lv_obj_move_foreground(g_pwd_sheet);  /* 提到导航栏之上，避免键盘被遮挡 */\n568: }\n569: \n570: /* ---- 密码输入面板 ---- */\n571: \n572: static void pwd_cancel_cb(lv_event_t *e)\n573: {\n574:   LV_UNUSED(e);\n575:   lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n576: }\n577: \n578: static void pwd_connect_cb(lv_event_t *e)\n579: {\n580:   LV_UNUSED(e);\n581:   const char *pwd = lv_textarea_get_text(g_pwd_textarea);\n582:   wifi_connect(g_pending_ssid, pwd);\n583: }\n584: \n585: /* 解析 /tmp/wifi_scan_result.txt，提取 SSID 列表。\n586:    文件格式：bssid / frequency / signal level / encode / ssid\n587:    第1行为标题需跳过，第5字段(索引4)为 SSID。 */\n588: static int get_wifi_ssids(char ap_names[][33], int max_count)\n589: {\n590:   FILE *fp = fopen(\"/tmp/wifi_scan_result.txt\", \"r\");\n591:   if (fp == NULL)\n592:     return 0;\n593: \n594:   char line[256];\n595:   int count = 0;\n596: \n597:   /* 跳过第一行标题 */\n598:   if (fgets(line, sizeof(line), fp) == NULL)\n599:     {\n600:       fclose(fp);\n601:       return 0;\n602:     }\n603: \n604:   while (fgets(line, sizeof(line), fp) != NULL && count < max_count)\n605:     {\n606:       char *nl = strchr(line, '\\n');\n607:       if (nl)\n608:         *nl = '\\0';\n609: \n610:       char *saveptr = NULL;\n611:       char *tok = strtok_r(line, \" \\t\", &saveptr);\n612:       int field = 0;\n613:       char *ssid = NULL;\n614:       while (tok != NULL && field < 5)\n615:         {\n616:           if (field == 4)\n617:             {\n618:               ssid = tok;\n619:               break;\n620:             }\n621:           tok = strtok_r(NULL, \" \\t\", &saveptr);\n622:           field++;\n623:         }\n624: \n625:       if (ssid)\n626:         {\n627:           strncpy(ap_names[count], ssid, 32);\n628:           ap_names[count][32] = '\\0';\n629:           count++;\n630:         }\n631:     }\n632: \n633:   fclose(fp);\n634:   return count;\n635: }\n636: \n637: /* 真实扫描：调用板子扫描脚本，结果写入 /tmp/wifi_scan_result.txt */\n638: static void wifi_scan_real(void)\n639: {\n640:   g_ap_count = 0;\n641:   int rc = system(\"sh /data/get_wifi.sh > /tmp/wifi_scan_result.txt 2>/dev/null\");\n642:   LV_UNUSED(rc);\n643:   g_ap_count = get_wifi_ssids(g_ap_names, 64);\n644: }\n645: \n646: /* 将 WiFi SSID 与密码写入配置文件，供板子固件联网使用 */\n647: static int save_wifi_config(const char *ssid, const char *password)\n648: {\n649:   FILE *fp = fopen(\"/data/wifi.cfg\", \"w\");\n650:   if (fp == NULL)\n651:     {\n652:       printf(\"Failed to open /data/wifi.cfg for writing\\n\");\n653:       return -1;\n654:     }\n655: \n656:   fprintf(fp, \"SSID=\\\"%s\\\"\\n\", ssid ? ssid : \"\");\n657:   fprintf(fp, \"PASSWORD=\\\"%s\\\"\\n\", password ? password : \"\");\n658:   fclose(fp);\n659: \n660:   printf(\"WiFi config saved: SSID=%s\\n\", ssid ? ssid : \"\");\n661:   return 0;\n662: }\n663: \n664: /****************************************************************************\n665:  * 设备码：首次启动生成 UUID，持久化到 /data/device_code\n666:  ****************************************************************************/\n667: \n668: static void generate_device_code(void)\n669: {\n670:   /* 尝试读取已有的设备码 */\n671:   FILE *fp = fopen(DEVICE_CODE_FILE, \"r\");\n672:   if (fp)\n673:     {\n674:       if (fgets(g_device_code, sizeof(g_device_code), fp))\n675:         {\n676:           /* 去掉换行 */\n677:           char *nl = strchr(g_device_code, '\\n');\n678:           if (nl) *nl = '\\0';\n679:           if (strlen(g_device_code) >= 6)\n680:             {\n681:               fclose(fp);\n682:               printf(\"Device code loaded: %s\\n\", g_device_code);\n683:               return;\n684:             }\n685:         }\n686:       fclose(fp);\n687:     }\n688: \n689:   /* 没有有效设备码，生成 8 位短码 */\n690:   fp = fopen(\"/dev/urandom\", \"r\");\n691:   if (!fp)\n692:     {\n693:       srand(time(NULL));\n694:       snprintf(g_device_code, sizeof(g_device_code), \"%08x\",\n695:                (unsigned)time(NULL) ^ (rand() << 16 | rand()));\n696:     }\n697:   else\n698:     {\n699:       unsigned char rb[4];\n700:       fread(rb, 1, 4, fp);\n701:       fclose(fp);\n702:       snprintf(g_device_code, sizeof(g_device_code), \"%02x%02x%02x%02x\",\n703:                rb[0], rb[1], rb[2], rb[3]);\n704:     }\n705: \n706:   /* 保存到文件 */\n707:   fp = fopen(DEVICE_CODE_FILE, \"w\");\n708:   if (fp)\n709:     {\n710:       fprintf(fp, \"%s\\n\", g_device_code);\n711:       fclose(fp);\n712:     }\n713: \n714:   printf(\"Device code generated: %s\\n\", g_device_code);\n715: }\n716: \n717: /****************************************************************************\n718:  * HTTP 轮询：curl GET /api/device/<code>/screen → 解析 JSON\n719:  ****************************************************************************/\n720: \n721: static void fetch_screen_cb(lv_timer_t *timer)\n722: {\n723:   LV_UNUSED(timer);\n724: \n725:   /* 只在主页且 WiFi 已连接时轮询 */\n726:   if (g_page != PAGE_HOME || g_wifi_ssid[0] == '\\0')\n727:     return;\n728: \n729:   char cmd[256];\n730:   snprintf(cmd, sizeof(cmd),\n731:            \"curl -s -m 5 http://%s:%d/api/device/%s/screen > /tmp/screen_resp.json 2>/dev/null\",\n732:            SERVER_HOST, SERVER_PORT, g_device_code);\n733:   system(cmd);\n734: \n735:   FILE *fp = fopen(\"/tmp/screen_resp.json\", \"r\");\n736:   if (!fp)\n737:     return;\n738: \n739:   char resp[512] = \"\";\n740:   size_t n = fread(resp, 1, sizeof(resp) - 1, fp);\n741:   fclose(fp);\n742:   resp[n] = '\\0';\n743: \n744:   printf(\"Screen API response: %s\\n\", resp);\n745: \n746:   /* 简单 JSON 解析：找 \"type\" 字段 */\n747:   char *type_ptr = strstr(resp, \"\\\"type\\\"\");\n748:   if (!type_ptr)\n749:     return;\n750: \n751:   /* 跳到冒号后面的值 */\n752:   type_ptr = strchr(type_ptr, ':');\n753:   if (!type_ptr) return;\n754:   type_ptr++;\n755: \n756:   /* 跳过空格和引号 */\n757:   while (*type_ptr == ' ' || *type_ptr == '\"') type_ptr++;\n758: \n759:   if (strncmp(type_ptr, \"idle\", 4) == 0)\n760:     {\n761:       g_screen_mode = SCREEN_IDLE;\n762:       if (g_status_lbl)\n763:         lv_label_set_text(g_status_lbl, \"等待绑定...\");\n764:       printf(\"Screen mode: idle\\n\");\n765:     }\n766:   else if (strncmp(type_ptr, \"wallpaper\", 9) == 0)\n767:     {\n768:       g_screen_mode = SCREEN_WALLPAPER;\n769:       if (g_status_lbl)\n770:         lv_label_set_text(g_status_lbl, \"壁纸模式\");\n771:       printf(\"Screen mode: wallpaper\\n\");\n772:       /* TODO: 下载并显示壁纸图片 */\n773:     }\n774:   else if (strncmp(type_ptr, \"news\", 4) == 0)\n775:     {\n776:       g_screen_mode = SCREEN_NEWS;\n777:       if (g_status_lbl)\n778:         lv_label_set_text(g_status_lbl, \"资讯模式\");\n779:       printf(\"Screen mode: news\\n\");\n780:       /* TODO: 下载并显示资讯截图 */\n781:     }\n782: }\n783: \n784: /****************************************************************************\n785:  * 心跳上报：POST /api/device/<code>/heartbeat\n786:  ****************************************************************************/\n787: \n788: static void heartbeat_cb(lv_timer_t *timer)\n789: {\n790:   LV_UNUSED(timer);\n791:   if (g_wifi_ssid[0] == '\\0')\n792:     return;\n793: \n794:   char cmd[256];\n795:   snprintf(cmd, sizeof(cmd),\n796:            \"curl -s -m 3 -X POST http://%s:%d/api/device/%s/heartbeat > /dev/null 2>&1\",\n797:            SERVER_HOST, SERVER_PORT, g_device_code);\n798:   system(cmd);\n799: }\n800: \n801: /****************************************************************************\n802:  * NTP 时间同步（暂未启用，需要 ntpdate 命令支持）\n803:  ****************************************************************************/\n804: \n805: static void ntp_sync_cb(lv_timer_t *timer)\n806: {\n807:   LV_UNUSED(timer);\n808:   /* TODO: 实现 NTP 同步 */\n809: }\n810: \n811: /* WiFi 热点列表（深色卡片，点击连接） */\n812: static void build_wifi_list(lv_obj_t *parent)\n813: {\n814:   if (g_ap_count <= 0)\n815:     {\n816:       lv_obj_t *ph = lv_label_create(parent);\n817:       lv_obj_set_width(ph, SCREEN_W - 32);\n818:       lv_obj_set_style_text_color(ph, color_hex(C_HOME_SUB), 0);\n819:       set_cn_font(ph);\n820:       lv_label_set_long_mode(ph, LV_LABEL_LONG_WRAP);\n821:       lv_obj_set_style_pad_top(ph, 20, 0);\n822:       lv_label_set_text(ph, \"未找到 WiFi\\n请确认 WiFi 已开启后，返回设置页重新进入\");\n823:       return;\n824:     }\n825: \n826:   for (int i = 0; i < g_ap_count; i++)\n827:     {\n828:       lv_obj_t *item = lv_obj_create(parent);\n829:       lv_obj_set_width(item, SCREEN_W - 24);\n830:       lv_obj_set_height(item, 54);\n831:       lv_obj_set_style_bg_color(item, color_hex(C_HOME_TEXT), 0);\n832:       lv_obj_set_style_bg_opa(item, 12, 0);\n833:       lv_obj_set_style_bg_color(item, color_hex(0x334155), LV_STATE_PRESSED);\n834:       lv_obj_set_style_border_width(item, 0, 0);\n835:       lv_obj_set_style_radius(item, 14, 0);\n836:       lv_obj_set_style_pad_left(item, 16, 0);\n837:       lv_obj_set_style_pad_right(item, 16, 0);\n838:       lv_obj_clear_flag(item, LV_OBJ_FLAG_SCROLLABLE);\n839:       lv_obj_set_flex_flow(item, LV_FLEX_FLOW_ROW);\n840:       lv_obj_set_flex_align(item, LV_FLEX_ALIGN_SPACE_BETWEEN,\n841:                             LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n842:       lv_obj_add_event_cb(item, wifi_item_cb, LV_EVENT_CLICKED,\n843:                           (void *)(intptr_t)i);\n844: \n845:       lv_obj_t *name = lv_label_create(item);\n846:       lv_obj_set_style_text_color(name, color_hex(C_HOME_TEXT), 0);\n847:       lv_obj_set_style_text_font(name, &lv_font_montserrat_16, 0);\n848:       set_cn_font(name);\n849:       lv_label_set_text(name, g_ap_names[i]);\n850: \n851:       /* 右侧：加密小标（真实扫描统一按加密处理） */\n852:       lv_obj_t *right = lv_obj_create(item);\n853:       lv_obj_set_size(right, LV_SIZE_CONTENT, LV_SIZE_CONTENT);\n854:       lv_obj_set_style_bg_opa(right, LV_OPA_TRANSP, 0);\n855:       lv_obj_set_style_border_width(right, 0, 0);\n856:       lv_obj_set_style_pad_all(right, 0, 0);\n857:       lv_obj_clear_flag(right, LV_OBJ_FLAG_SCROLLABLE);\n858:       lv_obj_set_flex_flow(right, LV_FLEX_FLOW_ROW);\n859:       lv_obj_set_flex_align(right, LV_FLEX_ALIGN_CENTER,\n860:                             LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n861:       lv_obj_set_style_pad_column(right, 10, 0);\n862: \n863:       /* LVGL 内置符号无锁形图标，用 WiFi 信号图标表示热点 */\n864:       lv_obj_t *lock = lv_label_create(right);\n865:       lv_obj_set_style_text_color(lock, color_hex(C_HOME_SUB), 0);\n866:       lv_obj_set_style_text_font(lock, &lv_font_montserrat_16, 0);\n867:       lv_label_set_text(lock, LV_SYMBOL_WIFI);\n868:     }\n869: }\n870: \n871: /* WiFi 独立页面：可滚动热点列表（进入时重新扫描刷新） */\n872: static void build_wifi_page(lv_obj_t *parent)\n873: {\n874:   lv_obj_t *page = lv_obj_create(parent);\n875:   lv_obj_set_size(page, SCREEN_W, CONTENT_H);\n876:   lv_obj_set_pos(page, 0, 0);\n877:   lv_obj_set_style_bg_opa(page, LV_OPA_TRANSP, 0);\n878:   lv_obj_set_style_border_width(page, 0, 0);\n879:   lv_obj_clear_flag(page, LV_OBJ_FLAG_SCROLLABLE);\n880:   lv_obj_set_flex_flow(page, LV_FLEX_FLOW_COLUMN);\n881:   lv_obj_set_flex_align(page, LV_FLEX_ALIGN_START,\n882:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n883:   lv_obj_set_style_pad_top(page, 12, 0);\n884:   lv_obj_set_style_pad_bottom(page, 12, 0);\n885:   lv_obj_set_style_pad_row(page, 10, 0);\n886:   lv_obj_add_flag(page, LV_OBJ_FLAG_HIDDEN);\n887:   g_wifi_page = page;\n888: \n889:   /* 顶部连接状态横幅（默认隐藏，连接时显示） */\n890:   g_wifi_banner = lv_obj_create(page);\n891:   lv_obj_remove_style_all(g_wifi_banner);\n892:   lv_obj_set_size(g_wifi_banner, SCREEN_W - 12, 34);\n893:   lv_obj_set_style_bg_opa(g_wifi_banner, LV_OPA_COVER, 0);\n894:   lv_obj_set_style_bg_color(g_wifi_banner, color_hex(0x475569), 0);\n895:   lv_obj_set_style_radius(g_wifi_banner, 8, 0);\n896:   lv_obj_add_flag(g_wifi_banner, LV_OBJ_FLAG_HIDDEN);\n897:   g_wifi_banner_lbl = lv_label_create(g_wifi_banner);\n898:   set_cn_font(g_wifi_banner_lbl);\n899:   lv_obj_set_style_text_color(g_wifi_banner_lbl, color_hex(0xFFFFFF), 0);\n900:   lv_obj_center(g_wifi_banner_lbl);\n901:   lv_label_set_text(g_wifi_banner_lbl, \"\");\n902: \n903:   /* 可滚动列表容器 */\n904:   g_wifi_list_cont = lv_obj_create(page);\n905:   lv_obj_set_width(g_wifi_list_cont, SCREEN_W - 12);\n906:   lv_obj_set_height(g_wifi_list_cont, CONTENT_H - 24 - 44);\n907:   lv_obj_set_style_bg_opa(g_wifi_list_cont, LV_OPA_TRANSP, 0);\n908:   lv_obj_set_style_border_width(g_wifi_list_cont, 0, 0);\n909:   lv_obj_set_style_pad_all(g_wifi_list_cont, 6, 0);\n910:   lv_obj_set_style_pad_column(g_wifi_list_cont, 0, 0);\n911:   lv_obj_set_style_pad_row(g_wifi_list_cont, 10, 0);\n912:   /* v9 滚动由可滚动标志 + 滚动方向控制；内容超出固定高度时自动可滚动 */\n913:   lv_obj_set_scroll_dir(g_wifi_list_cont, LV_DIR_VER);\n914:   lv_obj_set_flex_flow(g_wifi_list_cont, LV_FLEX_FLOW_COLUMN);\n915:   lv_obj_set_flex_align(g_wifi_list_cont, LV_FLEX_ALIGN_START,\n916:                          LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n917: \n918:   /* 初始扫描并填充（进入页面时还会再刷新） */\n919:   wifi_scan_real();\n920:   build_wifi_list(g_wifi_list_cont);\n921: }\n922: \n923: /****************************************************************************\n924:  * Password input sheet (encrypted WiFi)\n925:  ****************************************************************************/\n926: \n927: static void build_password_sheet(lv_obj_t *parent)\n928: {\n929:   g_pwd_sheet = lv_obj_create(parent);\n930:   lv_obj_set_size(g_pwd_sheet, SCREEN_W, SCREEN_H);\n931:   lv_obj_set_pos(g_pwd_sheet, 0, 0);\n932:   lv_obj_set_style_bg_color(g_pwd_sheet, color_hex(0x000000), 0);\n933:   lv_obj_set_style_bg_opa(g_pwd_sheet, LV_OPA_50, 0);\n934:   lv_obj_set_style_border_width(g_pwd_sheet, 0, 0);\n935:   lv_obj_set_style_pad_all(g_pwd_sheet, 0, 0);\n936:   lv_obj_clear_flag(g_pwd_sheet, LV_OBJ_FLAG_SCROLLABLE);\n937:   lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n938: \n939:   /* 清掉 lv_obj_create 自带的默认样式，否则容器默认 padding 会让键盘错位 */\n940:   lv_obj_t *cont = lv_obj_create(g_pwd_sheet);\n941:   lv_obj_remove_style_all(cont);\n942:   lv_obj_set_size(cont, LV_PCT(100), LV_PCT(100));\n943:   lv_obj_set_style_bg_opa(cont, LV_OPA_100, 0);\n944:   lv_obj_set_style_bg_color(cont, color_hex(C_SURFACE), 0);\n945:   lv_obj_set_style_pad_all(cont, 0, 0);\n946:   lv_obj_set_style_radius(cont, 0, 0);\n947:   lv_obj_clear_flag(cont, LV_OBJ_FLAG_SCROLLABLE);\n948:   g_pwd_panel = cont;\n949: \n950:   lv_obj_t *t = lv_label_create(cont);\n951:   lv_obj_set_style_text_color(t, color_hex(0x111827), 0);\n952:   lv_obj_set_style_text_font(t, &lv_font_montserrat_16, 0);\n953:   set_cn_font(t);\n954:   lv_label_set_text(t, \"输入 WiFi 密码\");\n955:   lv_obj_set_pos(t, 16, 16);\n956: \n957:   g_pwd_ssid_label = lv_label_create(cont);\n958:   lv_obj_set_style_text_color(g_pwd_ssid_label, color_hex(C_TEXT_SUB), 0);\n959:   set_cn_font(g_pwd_ssid_label);\n960:   lv_label_set_text(g_pwd_ssid_label, \"\");\n961:   lv_obj_set_pos(g_pwd_ssid_label, 16, 46);\n962: \n963:   g_pwd_textarea = lv_textarea_create(cont);\n964:   lv_obj_set_size(g_pwd_textarea, SCREEN_W - 32, 40);\n965:   lv_obj_set_pos(g_pwd_textarea, 16, 78);\n966:   lv_textarea_set_password_mode(g_pwd_textarea, true);\n967:   lv_textarea_set_one_line(g_pwd_textarea, true);\n968:   lv_obj_set_style_text_font(g_pwd_textarea, &lv_font_montserrat_16, 0);\n969: \n970:   lv_obj_t *row = lv_obj_create(cont);\n971:   lv_obj_remove_style_all(row);\n972:   lv_obj_set_size(row, SCREEN_W, 48);\n973:   lv_obj_set_pos(row, 0, 130);\n974:   lv_obj_set_style_bg_color(row, color_hex(C_SURFACE), 0);\n975:   lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);\n976:   lv_obj_set_flex_align(row, LV_FLEX_ALIGN_SPACE_EVENLY,\n977:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n978:   lv_obj_clear_flag(row, LV_OBJ_FLAG_SCROLLABLE);\n979: \n980:   lv_obj_t *cancel = lv_btn_create(row);\n981:   lv_obj_set_size(cancel, 110, 34);\n982:   lv_obj_set_style_bg_color(cancel, color_hex(C_BORDER), 0);\n983:   lv_obj_set_style_bg_color(cancel, color_hex(0xD1D5DB), LV_STATE_PRESSED);\n984:   lv_obj_set_style_shadow_width(cancel, 0, 0);\n985:   lv_obj_add_event_cb(cancel, pwd_cancel_cb, LV_EVENT_CLICKED, NULL);\n986:   lv_obj_t *cl = lv_label_create(cancel);\n987:   lv_obj_set_style_text_color(cl, color_hex(C_TEXT), 0);\n988:   set_cn_font(cl);\n989:   lv_label_set_text(cl, \"取消\");\n990:   lv_obj_center(cl);\n991: \n992:   lv_obj_t *ok = lv_btn_create(row);\n993:   lv_obj_set_size(ok, 110, 34);\n994:   lv_obj_set_style_bg_color(ok, color_hex(C_PRIMARY), 0);\n995:   lv_obj_set_style_bg_color(ok, color_hex(0x1D4ED8), LV_STATE_PRESSED);\n996:   lv_obj_set_style_shadow_width(ok, 0, 0);\n997:   lv_obj_add_event_cb(ok, pwd_connect_cb, LV_EVENT_CLICKED, NULL);\n998:   lv_obj_t *ol = lv_label_create(ok);\n999:   lv_obj_set_style_text_color(ol, color_hex(C_HOME_TEXT), 0);\n1000:   set_cn_font(ol);\n1001:   lv_label_set_text(ol, \"连接\");\n1002:   lv_obj_center(ol);\n1003: \n1004:   /* 键盘整屏宽贴底：宽度=SCREEN_W，不手动 set_pos，\n1005:      依赖键盘构造函数自带的 LV_ALIGN_BOTTOM_MID 贴底居中，左右自然齐平 */\n1006:   lv_obj_t *kb = lv_keyboard_create(cont);\n1007:   lv_obj_set_size(kb, SCREEN_W, 180);\n1008:   lv_obj_set_style_pad_all(kb, 0, 0);\n1009:   lv_keyboard_set_textarea(kb, g_pwd_textarea);\n1010: }\n1011: \n1012: /****************************************************************************\n1013:  * Page navigation (tap to switch: home <-> settings)\n1014:  ****************************************************************************/\n1015: \n1016: static void show_page(page_id_t p)\n1017: {\n1018:   g_page = p;\n1019: \n1020:   lv_obj_add_flag(g_home_page, LV_OBJ_FLAG_HIDDEN);\n1021:   lv_obj_add_flag(g_settings_page, LV_OBJ_FLAG_HIDDEN);\n1022:   lv_obj_add_flag(g_wifi_page, LV_OBJ_FLAG_HIDDEN);\n1023: \n1024:   lv_obj_t *show = (p == PAGE_HOME)     ? g_home_page\n1025:                   : (p == PAGE_SETTINGS) ? g_settings_page\n1026:                   :                        g_wifi_page;\n1027:   lv_obj_clear_flag(show, LV_OBJ_FLAG_HIDDEN);\n1028: \n1029:   /* 底部按钮图标随目标页切换：目标为设置页显示齿轮，目标为主页显示房子 */\n1030:   bool to_settings = (p == PAGE_HOME || p == PAGE_WIFI);\n1031:   lv_label_set_text(g_set_btn_lbl,\n1032:                     to_settings ? LV_SYMBOL_SETTINGS : LV_SYMBOL_HOME);\n1033: }\n1034: \n1035: static void bottom_btn_cb(lv_event_t *e)\n1036: {\n1037:   LV_UNUSED(e);\n1038:   printf(\"bottom_btn_cb: g_page=%d\\n\", g_page);\n1039:   if (g_page == PAGE_HOME)\n1040:     show_page(PAGE_SETTINGS);\n1041:   else if (g_page == PAGE_WIFI)\n1042:     show_page(PAGE_SETTINGS);   /* 从 WiFi 页返回设置页 */\n1043:   else\n1044:     show_page(PAGE_HOME);\n1045: }\n1046: \n1047: static void enter_wifi_cb(lv_event_t *e)\n1048: {\n1049:   LV_UNUSED(e);\n1050:   /* 进入 WiFi 页时重新扫描，刷新热点列表 */\n1051:   if (g_wifi_list_cont)\n1052:     {\n1053:       lv_obj_clean(g_wifi_list_cont);\n1054:       wifi_scan_real();\n1055:       build_wifi_list(g_wifi_list_cont);\n1056:     }\n1057:   show_page(PAGE_WIFI);\n1058: }\n1059: \n1060: /****************************************************************************\n1061:  * NuttX main entry\n1062:  ****************************************************************************/\n1063: \n1064: int main(int argc, FAR char *argv[])\n1065: {\n1066:   LV_UNUSED(argc);\n1067:   LV_UNUSED(argv);\n1068: \n1069:   printf(\"OpenVela Kanban starting...\\n\");\n1070: \n1071: #ifdef CONFIG_BOARDCTL\n1072:   boardctl(BOARDIOC_INIT, 0);\n1073: #endif\n1074: \n1075:   /* 生成或加载设备码 */\n1076:   generate_device_code();\n1077: \n1078:   lv_init();\n1079: \n1080:   /* Load Chinese font from board filesystem */\n1081:   g_font_cn = lv_binfont_create(\"/etc/fonts/font_puhui_20_4.bin\");\n1082:   if (g_font_cn == NULL)\n1083:     {\n1084:       printf(\"Warning: Chinese font not found, using default\\n\");\n1085:       g_font_cn = &lv_font_montserrat_16;\n1086:     }\n1087:   else\n1088:     {\n1089:       printf(\"Chinese font loaded successfully\\n\");\n1090:     }\n1091: \n1092:   lv_nuttx_dsc_t info;\n1093:   lv_nuttx_result_t result;\n1094: \n1095:   lv_nuttx_dsc_init(&info);\n1096: \n1097: #ifdef CONFIG_LV_USE_NUTTX_LCD\n1098:   info.fb_path = \"/dev/lcd0\";\n1099: #endif\n1100: \n1101:   info.input_path = \"/dev/input0\";\n1102: \n1103:   lv_nuttx_init(&info, &result);\n1104: \n1105:   if (result.disp == NULL)\n1106:     {\n1107:       printf(\"LVGL init failed!\\n\");\n1108:       return 1;\n1109:     }\n1110: \n1111:   lv_obj_t *scr = lv_screen_active();\n1112:   lv_obj_set_style_bg_color(scr, color_hex(C_BG_BOT), 0);\n1113: \n1114:   build_home_page(scr);\n1115:   build_settings_page(scr);\n1116:   build_wifi_page(scr);\n1117:   build_password_sheet(scr);\n1118:   build_bottom_nav(scr);\n1119: \n1120:   lv_timer_create(update_time_cb, 1000, NULL);\n1121:   update_time_cb(NULL);\n1122: \n1123:   /* 云端轮询：定时拉取后端画面配置 */\n1124:   lv_timer_create(fetch_screen_cb, POLL_INTERVAL, NULL);\n1125: \n1126:   /* 心跳：每 30 秒上报一次 */\n1127:   lv_timer_create(heartbeat_cb, 30000, NULL);\n1128: \n1129:   /* NTP 时间同步：每 10 秒尝试一次，成功后自动停止 */\n1130:   lv_timer_create(ntp_sync_cb, 10000, NULL);\n1131: \n1132:   printf(\"OpenVela Kanban ready! Device code: %s\\n\", g_device_code);\n1133: \n1134:   while (1)\n1135:     {\n1136:       uint32_t idle = lv_timer_handler();\n1137:       idle = idle ? idle : 1;\n1138:       usleep(idle * 1000);\n1139:     }\n1140: \n1141:   lv_nuttx_deinit(&result);\n1142:   lv_deinit();\n1143:   return 0;\n1144: }\n\n(End of file - total 1144 lines)\n</content>"}
{"schema_version":"1.0","session_id":"ses_f9f53f420ffeLBEK8wMpYbMiwQ","team_id":"contest2026_193_FirstNext","github_login":"mfskys","tool":"opencode","seq":26,"role":"tool","ts":"2026-09-02T05:54:15.197Z","tool_name":"read","tool_call_id":"call_8409e031efd04addbac622cd","input":{"filePath":"D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app\\eye_main.c"},"output":"<path>D:\\openvela\\contest2026_193_FirstNext\\app\\hello_app\\eye_main.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * eye_main.c - OpenVela 桌面机器人头 · 极简眼睛 (Team 193 FirstNext)\n3:  *\n4:  * 板端版本 (R528 / NuttX)。UI 与表情逻辑与 PC 模拟器\n5:  * (d:\\openvela\\lvgl_sim\\main\\src\\main.c) 保持一致。\n6:  *\n7:  * 板端差异:\n8:  *   - 显示/输入 : lv_nuttx_init()  (/dev/lcd0 + /dev/input0)\n9:  *   - 中文字体  : 运行时加载 /etc/fonts/font_puhui_20_4.bin\n10:  *   - 网络      : BSD socket + pthread (应用内置极简 HTTP 服务)\n11:  *   - 获取本机IP: ioctl(SIOCGIFADDR) on wlan0\n12:  *\n13:  * 形态: 纯黑全屏 + 两只白色\"竖椭圆方块\", 无瞳孔/高光/渐变/光晕。\n14:  *       表情完全由形状参数(半宽/半高/圆角/旋转/位移)表达。\n15:  *\n16:  * 交互:\n17:  *   - 顶部下滑          : 打开设置页(二维码)\n18:  *   - 设置页内下滑/返回 : 关闭设置页\n19:  *   - 点击屏幕          : 切换下一个表情\n20:  *   - 拖动              : 眼睛跟随手指\n21:  *   - 手机扫码          : 打开板内管理页, 可切换表情\n22:  ****************************************************************************/\n23: \n24: #include <nuttx/config.h>\n25: #include <nuttx/compiler.h>\n26: \n27: #include <stdio.h>\n28: #include <stdlib.h>\n29: #include <stdint.h>\n30: #include <string.h>\n31: #include <math.h>\n32: #include <time.h>\n33: #include <unistd.h>\n34: #include <pthread.h>\n35: \n36: #include <sys/socket.h>\n37: #include <sys/ioctl.h>\n38: #include <sys/boardctl.h>\n39: #include <netinet/in.h>\n40: #include <arpa/inet.h>\n41: #include <net/if.h>\n42: #include <errno.h>\n43: #include <nuttx/wireless/wireless.h>\n44: #include <wireless/wapi.h>     /* wapi_make_socket / wapi_scan_* C API */\n45: \n46: #include <lvgl/lvgl.h>\n47: \n48: /****************************************************************************\n49:  * 常量 (与 R528 DshanPi 屏幕一致)\n50:  ****************************************************************************/\n51: \n52: #define SCR_W       320\n53: #define SCR_H       480\n54: #define PI          3.14159265f\n55: \n56: #define EYE_CY      198.0f\n57: #define EYE_GAP     60.0f\n58: #define HTTP_PORT   8080\n59: #define TOP_BAR_H   30          /* 顶部下拉手势区(隐形) */\n60: \n61: #ifndef IFNAMSIZ\n62: #define IFNAMSIZ    16\n63: #endif\n64: \n65: #if defined(__cplusplus) || defined(__bool_true_false_are_defined)\n66: #else\n67: typedef int bool;\n68: #define true  1\n69: #define false 0\n70: #endif\n71: \n72: /****************************************************************************\n73:  * 全局状态\n74:  ****************************************************************************/\n75: \n76: static uint32_t   scr_buf[SCR_W * SCR_H];\n77: static lv_obj_t  *scr_cv      = NULL;\n78: static const lv_font_t *g_font = NULL;\n79: \n80: /* 单只眼睛: 半宽/半高/圆角/旋转角(度)/位移 */\n81: typedef struct { float hw, hh, r, rot, dx, dy; } shape_t;\n82: typedef struct { const char *name; shape_t L, R; } expr_t;\n83: \n84: enum { EX_NEUTRAL, EX_HAPPY, EX_LAUGH, EX_SQUINT, EX_LOVE, EX_SURPRISED,\n85:        EX_FEAR, EX_SAD, EX_CRY, EX_ANGRY, EX_THINKING, EX_CONFUSED,\n86:        EX_SMIRK, EX_SPEECHLESS, EX_SLEEPY, EX_SLEEP, EX_LISTENING,\n87:        EX_SPEAKING, EX_SCAN, EX_LOADING, EX_N };\n88: \n89: static const expr_t EXPRS[EX_N] = {\n90:     [EX_NEUTRAL]    = {\"平静\", {28,62,28,  0,0,  0}, {28,62,28,  0,0,  0}},\n91:     [EX_HAPPY]      = {\"开心\", {30,34,28,  0,0,-10}, {30,34,28,  0,0,-10}},\n92:     [EX_LAUGH]      = {\"大笑\", {32,26,28,  0,0,-14}, {32,26,28,  0,0,-14}},\n93:     [EX_SQUINT]     = {\"眯眼\", {28,20,24,  0,0, -6}, {28,20,24,  0,0, -6}},\n94:     [EX_LOVE]       = {\"喜欢\", {30,30,26,  0,0, -8}, {30,30,26,  0,0, -8}},\n95:     [EX_SURPRISED]  = {\"惊讶\", {36,44,34,  0,0, -6}, {36,44,34,  0,0, -6}},\n96:     [EX_FEAR]       = {\"惊恐\", {22,34,20,  0,0,  0}, {22,34,20,  0,0,  0}},\n97:     [EX_SAD]        = {\"难过\", {28,52,24, 20,0,  8}, {28,52,24,-20,0,  8}},\n98:     [EX_CRY]        = {\"哭泣\", {26,44,22, 26,0, 12}, {26,44,22,-26,0, 12}},\n99:     [EX_ANGRY]      = {\"生气\", {28,46,18,-24,0, -6}, {28,46,18, 24,0, -6}},\n100:     [EX_THINKING]   = {\"思考\", {28,60,28,  0,0,  0}, {24,38,20, 28,0, -6}},\n101:     [EX_CONFUSED]   = {\"疑惑\", {26,54,26,  0,0,  0}, {30,44,28,-14,0, -4}},\n102:     [EX_SMIRK]      = {\"得意\", {28,58,28,  0,0,  0}, {26,22,22, 18,0, -8}},\n103:     [EX_SPEECHLESS] = {\"无语\", {28, 8, 4,  0,0,  6}, {28, 8, 4,  0,0,  6}},\n104:     [EX_SLEEPY]     = {\"困倦\", {28,34,26,  0,0,  4}, {28,34,26,  0,0,  4}},\n105:     [EX_SLEEP]      = {\"睡觉\", {26, 5, 3,  0,0, 10}, {26, 5, 3,  0,0, 10}},\n106:     [EX_LISTENING]  = {\"聆听\", {30,68,30,  0,0,  0}, {30,68,30,  0,0,  0}},\n107:     [EX_SPEAKING]   = {\"说话\", {28,58,28,  0,0,  0}, {28,58,28,  0,0,  0}},\n108:     [EX_SCAN]       = {\"扫描\", {26,54,26,  0,0,  0}, {26,54,26,  0,0,  0}},\n109:     [EX_LOADING]    = {\"加载\", {24,50,24,  0,0,  0}, {24,50,24,  0,0,  0}},\n110: };\n111: \n112: /* 眨眼: 压成一条细横线 */\n113: static const shape_t BLINK = {26, 4, 3, 0, 0, 0};\n114: \n115: static int       g_expr = EX_NEUTRAL;\n116: static shape_t   g_curL = {28,62,28,0,0,0};\n117: static shape_t   g_curR = {28,62,28,0,0,0};\n118: static float     g_lookx = 0, g_looky = 0;\n119: static float     g_lookx_t = 0, g_looky_t = 0;\n120: static uint32_t  g_blink_until = 0, g_next_blink = 0;\n121: static volatile int g_pending_expr = -1;   /* HTTP线程 -> LVGL主线程 */\n122: \n123: /* 设置页 / 二维码 / 管理链接 */\n124: static int       g_set_open = 0;\n125: static lv_obj_t *g_set_cont = NULL;\n126: static lv_obj_t *g_qr       = NULL;\n127: static lv_obj_t *g_url_lbl  = NULL;\n128: static lv_obj_t *g_net_lbl  = NULL;\n129: static lv_obj_t *g_offline_lbl = NULL;\n130: static lv_obj_t *g_btn_lbl  = NULL;\n131: static char      g_url[96]  = \"\";\n132: \n133: /* WiFi 连接 UI (设置页 -> 选网 -> 输密码 -> 连接) */\n134: static lv_obj_t       *g_conn_btn     = NULL;  /* 设置页\"连接WiFi\"按钮 */\n135: static lv_obj_t       *g_wifi_page    = NULL;  /* 选网页 */\n136: static lv_obj_t       *g_wifi_list    = NULL;  /* 选网页列表容器 */\n137: static lv_obj_t       *g_wifi_state   = NULL;  /* 选网页状态标签 */\n138: static lv_obj_t       *g_pwd_sheet    = NULL;  /* 密码面板 */\n139: static lv_obj_t       *g_pwd_ssid_lbl = NULL;\n140: static lv_obj_t       *g_pwd_ta       = NULL;\n141: static lv_obj_t       *g_open_btn     = NULL;  /* \"无密码\"开关 */\n142: static lv_obj_t       *g_open_lbl     = NULL;\n143: static int             g_open_net     = 0;     /* 1: 开放网络, 不设密码 */\n144: \n145: /* 前置声明 */\n146: static void open_wifi_cb(lv_event_t *e);\n147: static void open_wifi_page(void);\n148: static void close_wifi_page(void);\n149: static void wifi_connect(const char *ssid, const char *pwd);\n150: static char            g_pending_ssid[64] = \"\";\n151: static char            g_ap_names[64][33] = { {0} };\n152: static int             g_ap_count   = 0;\n153: static lv_timer_t     *g_wifi_timer = NULL;\n154: static int             g_wifi_tick  = 0;\n155: \n156: /* 扫描异步化: wapi scan 最长要等 5 秒, 同步执行会冻结 LVGL。\n157:    扫描放到独立线程, 主线程用定时器轮询完成标志。 */\n158: static pthread_t       g_scan_tid;\n159: static volatile int    g_scan_done  = 0;\n160: static lv_timer_t     *g_scan_timer = NULL;\n161: static int             g_scan_wait  = 0;\n162: \n163: static void open_settings(void);\n164: static void close_settings(void);\n165: static void refresh_net_ui(void);\n166: static void refresh_net_cb(lv_event_t *e);\n167: \n168: /****************************************************************************\n169:  * 像素绘制 (圆角矩形 SDF + 1px 抗锯齿)\n170:  ****************************************************************************/\n171: \n172: static inline uint8_t U8(uint32_t c, int s) { return (c >> s) & 0xFF; }\n173: \n174: static void px_blend(int x, int y, uint8_t a, uint32_t rgb)\n175: {\n176:   if (x < 0 || y < 0 || x >= SCR_W || y >= SCR_H || a == 0) return;\n177: \n178:   uint32_t bg  = scr_buf[y * SCR_W + x];\n179:   uint8_t  br  = U8(bg, 16);\n180:   uint8_t  bgn = U8(bg, 8);\n181:   uint8_t  bb  = U8(bg, 0);\n182:   uint8_t  fr  = U8(rgb, 16);\n183:   uint8_t  fg  = U8(rgb, 8);\n184:   uint8_t  fb  = U8(rgb, 0);\n185: \n186:   uint8_t r = (uint8_t)((fr * a + br  * (255 - a)) / 255);\n187:   uint8_t g = (uint8_t)((fg * a + bgn * (255 - a)) / 255);\n188:   uint8_t b = (uint8_t)((fb * a + bb  * (255 - a)) / 255);\n189: \n190:   scr_buf[y * SCR_W + x] = (255u << 24) | (r << 16) | (g << 8) | b;\n191: }\n192: \n193: static void fill_rrect(float cx, float cy, const shape_t *s, uint32_t rgb)\n194: {\n195:   float hw = s->hw;\n196:   float hh = s->hh;\n197:   float r  = s->r;\n198:   int   x;\n199:   int   y;\n200: \n201:   if (r > hw) r = hw;\n202:   if (r > hh) r = hh;\n203:   if (hw < 1.0f || hh < 1.0f) return;\n204: \n205:   float th = s->rot * PI / 180.0f;\n206:   float cs = cosf(th);\n207:   float sn = sinf(th);\n208:   float ext = sqrtf(hw * hw + hh * hh) + 3.0f;\n209: \n210:   int x0 = (int)(cx - ext);\n211:   int x1 = (int)(cx + ext) + 1;\n212:   int y0 = (int)(cy - ext);\n213:   int y1 = (int)(cy + ext) + 1;\n214: \n215:   if (x0 < 0)     x0 = 0;\n216:   if (y0 < 0)     y0 = 0;\n217:   if (x1 > SCR_W) x1 = SCR_W;\n218:   if (y1 > SCR_H) y1 = SCR_H;\n219: \n220:   for (y = y0; y < y1; y++)\n221:     {\n222:       for (x = x0; x < x1; x++)\n223:         {\n224:           float dx = (x + 0.5f) - cx;\n225:           float dy = (y + 0.5f) - cy;\n226: \n227:           /* 屏幕 -> 局部(逆旋转) */\n228:           float lx =  dx * cs + dy * sn;\n229:           float ly = -dx * sn + dy * cs;\n230: \n231:           float qx = fabsf(lx) - (hw - r);\n232:           float qy = fabsf(ly) - (hh - r);\n233:           float mx = (qx > 0) ? qx : 0;\n234:           float my = (qy > 0) ? qy : 0;\n235:           float outside = sqrtf(mx * mx + my * my);\n236:           float inside  = (qx > qy) ? qx : qy;\n237: \n238:           if (inside > 0) inside = 0;\n239: \n240:           float d = outside + inside - r;\n241:           float a = 0.5f - d;\n242: \n243:           if (a <= 0) continue;\n244:           if (a > 1) a = 1;\n245: \n246:           px_blend(x, y, (uint8_t)(a * 255), rgb);\n247:         }\n248:     }\n249: }\n250: \n251: /****************************************************************************\n252:  * 表情状态与渲染\n253:  ****************************************************************************/\n254: \n255: static void lerp_shape(shape_t *c, const shape_t *t, float f)\n256: {\n257:   c->hw  += (t->hw  - c->hw ) * f;\n258:   c->hh  += (t->hh  - c->hh ) * f;\n259:   c->r   += (t->r   - c->r  ) * f;\n260:   c->rot += (t->rot - c->rot) * f;\n261:   c->dx  += (t->dx  - c->dx ) * f;\n262:   c->dy  += (t->dy  - c->dy ) * f;\n263: }\n264: \n265: static void update_btn_label(void)\n266: {\n267:   if (g_btn_lbl) lv_label_set_text(g_btn_lbl, EXPRS[g_expr].name);\n268: }\n269: \n270: static void set_expr(int i)\n271: {\n272:   g_expr = i % EX_N;\n273:   update_btn_label();\n274: }\n275: \n276: static void compute_target(int idx, uint32_t tick, shape_t *L, shape_t *R,\n277:                            int *blinking)\n278: {\n279:   float t = tick / 1000.0f;\n280: \n281:   *blinking = (tick < g_blink_until);\n282:   if (*blinking)\n283:     {\n284:       *L = BLINK;\n285:       *R = BLINK;\n286:       return;\n287:     }\n288: \n289:   *L = EXPRS[idx].L;\n290:   *R = EXPRS[idx].R;\n291: \n292:   switch (idx)\n293:     {\n294:       case EX_LISTENING:\n295:         {\n296:           float p = sinf(t * 2.2f);\n297:           L->hw += 2.0f * p; L->hh += 3.5f * p;\n298:           R->hw += 2.0f * p; R->hh += 3.5f * p;\n299:           break;\n300:         }\n301:       case EX_SPEAKING:\n302:         {\n303:           float p = sinf(t * 9.0f);\n304:           L->dy += 6.0f * p; R->dy += 6.0f * p;\n305:           break;\n306:         }\n307:       case EX_LAUGH:\n308:         {\n309:           float p = sinf(t * 10.0f);\n310:           L->dy += 5.0f * p; R->dy += 5.0f * p;\n311:           break;\n312:         }\n313:       case EX_LOVE:\n314:         {\n315:           float p = fabsf(sinf(t * 3.0f));\n316:           L->hw += 3.0f * p; L->hh += 3.0f * p;\n317:           R->hw += 3.0f * p; R->hh += 3.0f * p;\n318:           break;\n319:         }\n320:       case EX_FEAR:\n321:         {\n322:           float jx = (float)(rand() % 5 - 2);\n323:           float jy = (float)(rand() % 5 - 2);\n324:           L->dx += jx; L->dy += jy;\n325:           R->dx += jx; R->dy += jy;\n326:           break;\n327:         }\n328:       case EX_CRY:\n329:         {\n330:           float p = sinf(t * 12.0f);\n331:           L->dy += 1.5f * p; R->dy += 1.5f * p;\n332:           break;\n333:         }\n334:       case EX_SLEEPY:\n335:         {\n336:           float p = sinf(t * 0.7f);\n337:           L->hh += 12.0f * p; R->hh += 12.0f * p;\n338:           break;\n339:         }\n340:       case EX_SCAN:\n341:         {\n342:           float p = sinf(t * 1.2f);\n343:           L->dx += 30.0f * p; R->dx += 30.0f * p;\n344:           break;\n345:         }\n346:       case EX_LOADING:\n347:         {\n348:           float p = 0.35f + 0.65f * fabsf(sinf(t * 2.5f));\n349:           L->hw *= p; R->hw *= p;\n350:           break;\n351:         }\n352:       default:\n353:         {\n354:           float p = sinf(t * 1.5f);\n355:           L->hh += 2.0f * p; R->hh += 2.0f * p;\n356:           break;\n357:         }\n358:     }\n359: }\n360: \n361: /****************************************************************************\n362:  * 脏矩形局部刷新\n363:  * 眼睛只占屏幕约 1/10 的面积, 每帧只清/只画/只刷这一小块,\n364:  * 避免全屏 153600 像素的重绘与 SPI 全屏传输。\n365:  ****************************************************************************/\n366: \n367: static lv_area_t g_dirty_prev;\n368: static int       g_dirty_valid = 0;\n369: static int       g_need_full   = 1;   /* 首帧或设置页关闭后需要整屏重绘 */\n370: \n371: static void clear_area(const lv_area_t *a)\n372: {\n373:   int x;\n374:   int y;\n375: \n376:   for (y = a->y1; y <= a->y2; y++)\n377:     {\n378:       uint32_t *row = &scr_buf[y * SCR_W];\n379: \n380:       for (x = a->x1; x <= a->x2; x++) row[x] = 0xFF000000;\n381:     }\n382: }\n383: \n384: /* 把一只眼睛的外接矩形并入脏区(用外接圆, 覆盖任意旋转) */\n385: static void union_eye_area(lv_area_t *a, float cx, float cy,\n386:                            const shape_t *s)\n387: {\n388:   float ext = sqrtf(s->hw * s->hw + s->hh * s->hh) + 4.0f;\n389:   int   x1 = (int)(cx - ext);\n390:   int   y1 = (int)(cy - ext);\n391:   int   x2 = (int)(cx + ext) + 1;\n392:   int   y2 = (int)(cy + ext) + 1;\n393: \n394:   if (x1 < 0)         x1 = 0;\n395:   if (y1 < 0)         y1 = 0;\n396:   if (x2 > SCR_W - 1) x2 = SCR_W - 1;\n397:   if (y2 > SCR_H - 1) y2 = SCR_H - 1;\n398: \n399:   if (x1 < a->x1) a->x1 = x1;\n400:   if (y1 < a->y1) a->y1 = y1;\n401:   if (x2 > a->x2) a->x2 = x2;\n402:   if (y2 > a->y2) a->y2 = y2;\n403: }\n404: \n405: static void anim_cb(lv_timer_t *tm)\n406: {\n407:   (void)tm;\n408:   uint32_t tick = lv_tick_get();\n409:   int      i;\n410: \n411:   /* 来自 HTTP 线程的表情切换请求(必须在 LVGL 主线程应用) */\n412:   if (g_pending_expr >= 0)\n413:     {\n414:       set_expr(g_pending_expr);\n415:       g_pending_expr = -1;\n416:     }\n417: \n418:   /* 设置页打开时眼睛被完全遮挡, 跳过渲染省算力 */\n419:   if (g_set_open)\n420:     {\n421:       g_need_full = 1;\n422:       return;\n423:     }\n424: \n425:   if (!g_need_full)\n426:     {\n427:       /* 局部模式: 只清上一帧的脏区, 不整屏清 */\n428:       if (g_dirty_valid) clear_area(&g_dirty_prev);\n429:     }\n430:   else\n431:     {\n432:       /* 整屏模式 */\n433:       for (i = 0; i < SCR_W * SCR_H; i++) scr_buf[i] = 0xFF000000;\n434:     }\n435: \n436:   /* 眨眼调度 */\n437:   if (tick > g_next_blink && tick > g_blink_until)\n438:     {\n439:       g_blink_until = tick + 160;\n440:       g_next_blink  = tick + 2200 + (rand() % 2800);\n441:     }\n442: \n443:   shape_t L;\n444:   shape_t R;\n445:   int     blinking;\n446: \n447:   compute_target(g_expr, tick, &L, &R, &blinking);\n448:   if (blinking)\n449:     {\n450:       g_curL = BLINK;\n451:       g_curR = BLINK;\n452:     }\n453:   else\n454:     {\n455:       lerp_shape(&g_curL, &L, 0.22f);\n456:       lerp_shape(&g_curR, &R, 0.22f);\n457:     }\n458: \n459:   g_lookx += (g_lookx_t - g_lookx) * 0.18f;\n460:   g_looky += (g_looky_t - g_looky) * 0.18f;\n461: \n462:   float cxL = SCR_W / 2.0f - EYE_GAP + g_lookx * 26.0f + g_curL.dx;\n463:   float cxR = SCR_W / 2.0f + EYE_GAP + g_lookx * 26.0f + g_curR.dx;\n464:   float cyL = EYE_CY + g_looky * 20.0f + g_curL.dy;\n465:   float cyR = EYE_CY + g_looky * 20.0f + g_curR.dy;\n466: \n467:   fill_rrect(cxL, cyL, &g_curL, 0xFFFFFF);\n468:   fill_rrect(cxR, cyR, &g_curR, 0xFFFFFF);\n469: \n470:   /* 只把眼睛占用的这块区域标脏 —— LVGL 会只刷这一块,\n471:      SPI 屏驱动支持窗口寻址(LCD_SetWindows), 传输量随之大减 */\n472:   lv_area_t dirty;\n473: \n474:   dirty.x1 = SCR_W - 1;\n475:   dirty.y1 = SCR_H - 1;\n476:   dirty.x2 = 0;\n477:   dirty.y2 = 0;\n478:   union_eye_area(&dirty, cxL, cyL, &g_curL);\n479:   union_eye_area(&dirty, cxR, cyR, &g_curR);\n480: \n481:   if (g_need_full)\n482:     {\n483:       lv_obj_invalidate(scr_cv);\n484:       g_need_full = 0;\n485:     }\n486:   else\n487:     {\n488:       if (g_dirty_valid) lv_obj_invalidate_area(scr_cv, &g_dirty_prev);\n489:       lv_obj_invalidate_area(scr_cv, &dirty);\n490:     }\n491: \n492:   g_dirty_prev  = dirty;\n493:   g_dirty_valid = 1;\n494: }\n495: \n496: /****************************************************************************\n497:  * 网络: 获取本机 IP + 连接状态\n498:  ****************************************************************************/\n499: \n500: static int get_local_ip(char *out, int n)\n501: {\n502:   int            fd;\n503:   struct ifreq   ifr;\n504:   struct sockaddr_in *sin;\n505:   int            rc;\n506: \n507:   fd = socket(AF_INET, SOCK_DGRAM, 0);\n508:   if (fd < 0) return 0;\n509: \n510:   memset(&ifr, 0, sizeof(ifr));\n511:   strncpy(ifr.ifr_name, \"wlan0\", IFNAMSIZ - 1);\n512: \n513:   rc = ioctl(fd, SIOCGIFADDR, &ifr);\n514:   close(fd);\n515:   if (rc < 0) return 0;\n516: \n517:   sin = (struct sockaddr_in *)&ifr.ifr_addr;\n518:   if (sin->sin_addr.s_addr == 0) return 0;\n519: \n520:   return inet_ntop(AF_INET, &sin->sin_addr, out, n) != NULL;\n521: }\n522: \n523: /* 真实关联检测: wlan0 是否关联了 AP。\n524:    用 SIOCGIWAP ioctl 直接取已关联的 AP MAC, 全 0 表示未连上任何路由器。\n525:    不再用 system(\"wapi show wlan0\"): 那会每秒 fork/exec 一次 shell,\n526:    开销大且会打断 SPI 屏刷新(曾导致触摸间歇失灵)。 */\n527: static int wifi_associated(void)\n528: {\n529:   struct iwreq   iwr;\n530:   const uint8_t *mac;\n531:   int            fd;\n532:   int            ret;\n533:   int            i;\n534: \n535:   fd = socket(AF_INET, SOCK_DGRAM, 0);\n536:   if (fd < 0) return 0;\n537: \n538:   memset(&iwr, 0, sizeof(iwr));\n539:   strncpy(iwr.ifr_name, \"wlan0\", IFNAMSIZ - 1);\n540: \n541:   ret = ioctl(fd, SIOCGIWAP, (unsigned long)&iwr);\n542:   close(fd);\n543:   if (ret < 0) return 0;\n544: \n545:   /* ap_addr.sa_data 前 6 字节是 AP 的 MAC */\n546:   mac = (const uint8_t *)iwr.u.ap_addr.sa_data;\n547:   for (i = 0; i < 6; i++)\n548:     {\n549:       if (mac[i] != 0) return 1;\n550:     }\n551: \n552:   return 0;\n553: }\n554: \n555: static int net_connected(void)\n556: {\n557:   char ip[64];\n558: \n559:   memset(ip, 0, sizeof(ip));\n560: \n561:   /* 必须先真正关联上路由器 */\n562:   if (!wifi_associated()) return 0;\n563: \n564:   if (!get_local_ip(ip, (int)sizeof(ip))) return 0;\n565:   if (strncmp(ip, \"127.\", 4) == 0 || strcmp(ip, \"0.0.0.0\") == 0) return 0;\n566: \n567:   snprintf(g_url, sizeof(g_url), \"http://%s:%d\", ip, HTTP_PORT);\n568:   return 1;\n569: }\n570: \n571: /****************************************************************************\n572:  * 设置页 (二维码)\n573:  ****************************************************************************/\n574: \n575: static void close_settings_cb(lv_event_t *e) { (void)e; close_settings(); }\n576: \n577: static lv_obj_t *mk_label(lv_obj_t *parent, const char *txt, uint32_t color,\n578:                           int y, lv_text_align_t align)\n579: {\n580:   lv_obj_t *l = lv_label_create(parent);\n581: \n582:   lv_label_set_text(l, txt);\n583:   if (g_font) lv_obj_set_style_text_font(l, g_font, 0);\n584:   lv_obj_set_style_text_color(l, lv_color_hex(color), 0);\n585:   if (align != LV_TEXT_ALIGN_LEFT)\n586:     {\n587:       lv_obj_set_width(l, SCR_W - 60);\n588:       lv_obj_set_style_text_align(l, align, 0);\n589:     }\n590: \n591:   lv_obj_align(l, LV_ALIGN_TOP_MID, 0, y);\n592:   return l;\n593: }\n594: \n595: static void build_settings_page(lv_obj_t *parent)\n596: {\n597:   lv_obj_t *b;\n598:   lv_obj_t *bl;\n599:   lv_obj_t *rb;\n600:   lv_obj_t *rl;\n601: \n602:   g_set_cont = lv_obj_create(parent);\n603:   lv_obj_remove_style_all(g_set_cont);\n604:   lv_obj_set_size(g_set_cont, SCR_W, SCR_H);\n605:   lv_obj_align(g_set_cont, LV_ALIGN_CENTER, 0, 0);\n606:   lv_obj_set_style_bg_color(g_set_cont, lv_color_hex(0x000000), 0);\n607:   lv_obj_set_style_bg_opa(g_set_cont, LV_OPA_COVER, 0);\n608: \n609:   mk_label(g_set_cont, \"扫码进入管理页\", 0x9FB2CC, 44, LV_TEXT_ALIGN_CENTER);\n610: \n611:   /* 二维码(白底黑码) */\n612:   g_qr = lv_qrcode_create(g_set_cont);\n613:   lv_qrcode_set_size(g_qr, 176);\n614:   lv_qrcode_set_dark_color(g_qr, lv_color_hex(0x000000));\n615:   lv_qrcode_set_light_color(g_qr, lv_color_hex(0xFFFFFF));\n616:   lv_obj_align(g_qr, LV_ALIGN_TOP_MID, 0, 84);\n617:   lv_obj_remove_flag(g_qr, LV_OBJ_FLAG_CLICKABLE);   /* 触摸穿透到 canvas */\n618: \n619:   g_url_lbl = mk_label(g_set_cont, \"\", 0xDDE6F5, 280, LV_TEXT_ALIGN_CENTER);\n620: \n621:   /* 未连网时的居中提示(占据二维码位置) */\n622:   g_offline_lbl = mk_label(g_set_cont,\n623:                            \"WiFi 未连接\\n\\n请先连接网络\\n再打开本页扫码\",\n624:                            0x7A8AA5, 130, LV_TEXT_ALIGN_CENTER);\n625: \n626:   g_net_lbl = mk_label(g_set_cont, \"\", 0x5A6B85, 312, LV_TEXT_ALIGN_CENTER);\n627: \n628:   /* 刷新: 重新检测网络并重绘二维码 */\n629:   rb = lv_button_create(g_set_cont);\n630:   lv_obj_set_size(rb, 100, 44);\n631:   lv_obj_align(rb, LV_ALIGN_BOTTOM_LEFT, 0, -56);\n632:   lv_obj_set_style_bg_color(rb, lv_color_hex(0x1B2130), 0);\n633:   lv_obj_set_style_radius(rb, 22, 0);\n634:   rl = lv_label_create(rb);\n635:   lv_label_set_text(rl, \"刷新\");\n636:   if (g_font) lv_obj_set_style_text_font(rl, g_font, 0);\n637:   lv_obj_set_style_text_color(rl, lv_color_hex(0xDDE6F5), 0);\n638:   lv_obj_center(rl);\n639:   lv_obj_add_event_cb(rb, refresh_net_cb, LV_EVENT_CLICKED, NULL);\n640: \n641:   /* 连接 WiFi (仅未连网时显示) */\n642:   g_conn_btn = lv_button_create(g_set_cont);\n643:   lv_obj_set_size(g_conn_btn, 100, 44);\n644:   lv_obj_align(g_conn_btn, LV_ALIGN_BOTTOM_MID, 0, -56);\n645:   lv_obj_set_style_bg_color(g_conn_btn, lv_color_hex(0x1D4ED8), 0);\n646:   lv_obj_set_style_bg_color(g_conn_btn, lv_color_hex(0x2563EB), LV_STATE_PRESSED);\n647:   lv_obj_set_style_radius(g_conn_btn, 22, 0);\n648:   lv_obj_set_style_shadow_width(g_conn_btn, 0, 0);\n649:   rl = lv_label_create(g_conn_btn);\n650:   lv_label_set_text(rl, \"连接WiFi\");\n651:   if (g_font) lv_obj_set_style_text_font(rl, g_font, 0);\n652:   lv_obj_set_style_text_color(rl, lv_color_hex(0xFFFFFF), 0);\n653:   lv_obj_center(rl);\n654:   lv_obj_add_event_cb(g_conn_btn, open_wifi_cb, LV_EVENT_CLICKED, NULL);\n655: \n656:   /* 返回 */\n657:   b = lv_button_create(g_set_cont);\n658:   lv_obj_set_size(b, 100, 44);\n659:   lv_obj_align(b, LV_ALIGN_BOTTOM_RIGHT, 0, -56);\n660:   lv_obj_set_style_bg_color(b, lv_color_hex(0x1B2130), 0);\n661:   lv_obj_set_style_radius(b, 22, 0);\n662:   bl = lv_label_create(b);\n663:   lv_label_set_text(bl, \"返回\");\n664:   if (g_font) lv_obj_set_style_text_font(bl, g_font, 0);\n665:   lv_obj_set_style_text_color(bl, lv_color_hex(0xDDE6F5), 0);\n666:   lv_obj_center(bl);\n667:   lv_obj_add_event_cb(b, close_settings_cb, LV_EVENT_CLICKED, NULL);\n668: \n669:   lv_obj_add_flag(g_set_cont, LV_OBJ_FLAG_HIDDEN);\n670: }\n671: \n672: static void refresh_net_ui(void)\n673: {\n674:   if (net_connected())\n675:     {\n676:       if (g_qr)\n677:         {\n678:           lv_qrcode_update(g_qr, g_url, (uint32_t)strlen(g_url));\n679:           lv_obj_clear_flag(g_qr, LV_OBJ_FLAG_HIDDEN);\n680:         }\n681: \n682:       if (g_url_lbl)\n683:         {\n684:           lv_label_set_text(g_url_lbl, g_url);\n685:           lv_obj_clear_flag(g_url_lbl, LV_OBJ_FLAG_HIDDEN);\n686:         }\n687: \n688:       if (g_offline_lbl) lv_obj_add_flag(g_offline_lbl, LV_OBJ_FLAG_HIDDEN);\n689:       if (g_net_lbl)\n690:         lv_label_set_text(g_net_lbl, \"已连接 · 手机扫码或浏览器打开\");\n691:       if (g_conn_btn) lv_obj_add_flag(g_conn_btn, LV_OBJ_FLAG_HIDDEN);\n692:     }\n693:   else\n694:     {\n695:       if (g_qr)      lv_obj_add_flag(g_qr, LV_OBJ_FLAG_HIDDEN);\n696:       if (g_url_lbl) lv_obj_add_flag(g_url_lbl, LV_OBJ_FLAG_HIDDEN);\n697:       if (g_offline_lbl)\n698:         lv_obj_clear_flag(g_offline_lbl, LV_OBJ_FLAG_HIDDEN);\n699:       if (g_net_lbl) lv_label_set_text(g_net_lbl, \"未连接 · 可点下方连接WiFi\");\n700:       if (g_conn_btn) lv_obj_clear_flag(g_conn_btn, LV_OBJ_FLAG_HIDDEN);\n701:     }\n702: }\n703: \n704: static void refresh_net_cb(lv_event_t *e) { (void)e; refresh_net_ui(); }\n705: \n706: static void open_settings(void)\n707: {\n708:   if (g_set_open) return;\n709: \n710:   g_set_open = 1;\n711:   refresh_net_ui();\n712:   lv_obj_clear_flag(g_set_cont, LV_OBJ_FLAG_HIDDEN);\n713:   lv_obj_move_foreground(g_set_cont);\n714: }\n715: \n716: static void close_settings(void)\n717: {\n718:   g_set_open = 0;\n719:   if (g_set_cont) lv_obj_add_flag(g_set_cont, LV_OBJ_FLAG_HIDDEN);\n720: }\n721: \n722: /****************************************************************************\n723:  * WiFi 连接 (选网 + 输密码 + 连接, 扫码前的网络设置)\n724:  ****************************************************************************/\n725: \n726: /* 解析 /tmp/wifi_scan_result.txt, 提取 SSID 列表。\n727:    格式: bssid / frequency / signal level / encode / ssid\n728:    第1行是标题需跳过; SSID 是前4个空格分隔字段之后的剩余部分\n729:    (SSID 本身可能含空格, 不能用 strtok 简单切分)。 */\n730: static int get_wifi_ssids(char ap_names[][33], int max_count)\n731: {\n732:   FILE *fp = fopen(\"/tmp/wifi_scan_result.txt\", \"r\");\n733:   if (fp == NULL) return 0;\n734: \n735:   char line[256];\n736:   int  count = 0;\n737:   int  first = 1;\n738: \n739:   while (count < max_count && fgets(line, sizeof(line), fp))\n740:     {\n741:       if (first) { first = 0; continue; }        /* 跳过标题行 */\n742: \n743:       char *nl = strchr(line, '\\n');\n744:       if (nl) *nl = '\\0';\n745: \n746:       /* 跳过前4个字段 (bssid freq signal encode) */\n747:       char *p = line;\n748:       int   field = 0;\n749:       while (field < 4)\n750:         {\n751:           while (*p == ' ' || *p == '\\t') p++;\n752:           if (*p == '\\0') break;\n753:           while (*p != ' ' && *p != '\\t' && *p != '\\0') p++;\n754:           field++;\n755:         }\n756:       while (*p == ' ' || *p == '\\t') p++;       /* p 指向 SSID 起点 */\n757: \n758:       /* 去掉 SSID 尾部空白 */\n759:       char *end = p + strlen(p);\n760:       while (end > p && (end[-1] == ' ' || end[-1] == '\\t')) end--;\n761:       *end = '\\0';\n762: \n763:       if (*p != '\\0')                            /* 隐藏 SSID 的行跳过 */\n764:         {\n765:           strncpy(ap_names[count], p, 32);\n766:           ap_names[count][32] = '\\0';\n767:           count++;\n768:         }\n769:     }\n770: \n771:   fclose(fp);\n772:   return count;\n773: }\n774: \n775: /* 扫描线程: 用 wapi C API 发起 wlan0 扫描并收集结果, 绝不触碰任何 LVGL 对象。\n776:  * 之前用 system(\"sh /data/get_wifi.sh ...\") + 解析文件, 但 NuttX 的 system()\n777:  * 走 posix_spawn, 从 pthread 调用会破坏任务结构, 导致 IDLE 栈损坏 + Prefetch\n778:  * abort(PC 跳到非法地址, 双核 panic)。改用库调用后无线程 spawn, 与 113 队\n779:  * wifi_manager 的 \"不使用 system()\" 原则一致。\n780:  */\n781: static void *wifi_scan_thread(void *arg)\n782: {\n783:   struct wapi_list_s list;\n784:   struct wapi_scan_info_s *info;\n785:   int sock;\n786:   int tries;\n787:   int count = 0;\n788: \n789:   LV_UNUSED(arg);\n790: \n791:   memset(&list, 0, sizeof(list));\n792: \n793:   sock = wapi_make_socket();\n794:   if (sock < 0)\n795:     {\n796:       printf(\"[eye] wapi_make_socket: %d\\n\", errno);\n797:       g_scan_done = 1;\n798:       return NULL;\n799:     }\n800: \n801:   /* 主动扫描(NULL essid = 扫描所有); 等价于 wapi scan wlan0 */\n802:   if (wapi_scan_init(sock, \"wlan0\", NULL) < 0)\n803:     {\n804:       printf(\"[eye] wapi_scan_init: %d\\n\", errno);\n805:       close(sock);\n806:       g_scan_done = 1;\n807:       return NULL;\n808:     }\n809: \n810:   /* 等待驱动异步扫描完成, 最多 25 * 200ms = 5s(与 wapi 工具默认一致) */\n811:   for (tries = 0; tries < 25; tries++)\n812:     {\n813:       int stat = wapi_scan_stat(sock, \"wlan0\");\n814:       if (stat < 0)\n815:         break;\n816:       if (stat == 0)\n817:         break;\n818:       usleep(200 * 1000);\n819:     }\n820: \n821:   if (wapi_scan_coll(sock, \"wlan0\", &list) >= 0)\n822:     {\n823:       for (info = list.head.scan; info && count < 64; info = info->next)\n824:         {\n825:           if (info->has_essid == 0 || info->essid[0] == '\\0')\n826:             continue;   /* 隐藏 SSID 跳过 */\n827:           strncpy(g_ap_names[count], info->essid, 32);\n828:           g_ap_names[count][32] = '\\0';\n829:           count++;\n830:         }\n831:     }\n832: \n833:   wapi_scan_coll_free(&list);\n834:   close(sock);\n835: \n836:   g_ap_count = count;\n837:   g_scan_done = 1;\n838:   return NULL;\n839: }\n840: \n841: /* 写配置文件。注意: 与固件 wifi_manager 的解析一致, 不带引号 */\n842: static int save_wifi_config(const char *ssid, const char *password)\n843: {\n844:   FILE *fp = fopen(\"/data/wifi.cfg\", \"w\");\n845:   if (fp == NULL)\n846:     {\n847:       printf(\"[eye] Failed to open /data/wifi.cfg for writing\\n\");\n848:       return -1;\n849:     }\n850: \n851:   fprintf(fp, \"SSID=%s\\n\", ssid ? ssid : \"\");\n852:   fprintf(fp, \"PASSWORD=%s\\n\", password ? password : \"\");\n853:   fclose(fp);\n854: \n855:   printf(\"[eye] WiFi config saved: SSID=%s\\n\", ssid ? ssid : \"\");\n856:   return 0;\n857: }\n858: \n859: /* ---- 密码面板 ---- */\n860: \n861: static void pwd_cancel_cb(lv_event_t *e)\n862: {\n863:   LV_UNUSED(e);\n864:   if (g_pwd_sheet) lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n865: }\n866: \n867: /* 切换\"无密码\"(开放网络) 模式 */\n868: static void open_net_cb(lv_event_t *e)\n869: {\n870:   LV_UNUSED(e);\n871:   g_open_net = !g_open_net;\n872: \n873:   if (g_open_btn)\n874:     lv_obj_set_style_bg_color(g_open_btn,\n875:                               lv_color_hex(g_open_net ? 0x1D4ED8 : 0x2A3A5A), 0);\n876:   if (g_open_lbl)\n877:     lv_obj_set_style_text_color(g_open_lbl,\n878:                                 lv_color_hex(g_open_net ? 0xFFFFFF : 0xDDE6F5), 0);\n879: \n880:   /* 开放网络不需要输入密码, 灰掉输入框 */\n881:   if (g_pwd_ta)\n882:     {\n883:       lv_textarea_set_text(g_pwd_ta, \"\");\n884:       if (g_open_net) lv_obj_add_state(g_pwd_ta, LV_STATE_DISABLED);\n885:       else            lv_obj_clear_state(g_pwd_ta, LV_STATE_DISABLED);\n886:     }\n887: }\n888: \n889: static void pwd_connect_cb(lv_event_t *e)\n890: {\n891:   LV_UNUSED(e);\n892:   const char *pwd = lv_textarea_get_text(g_pwd_ta);\n893: \n894:   /* 开放网络: 直接以空密码连接 */\n895:   if (g_open_net)\n896:     {\n897:       wifi_connect(g_pending_ssid, \"\");\n898:       return;\n899:     }\n900: \n901:   /* 固件 wifi_manager 要求密码至少 8 位, 不足则提示, 不写入配置 */\n902:   if (pwd == NULL || strlen(pwd) < 8)\n903:     {\n904:       if (g_wifi_state)\n905:         lv_label_set_text(g_wifi_state, \"密码至少 8 位, 请重新输入\");\n906:       return;\n907:     }\n908: \n909:   wifi_connect(g_pending_ssid, pwd);\n910: }\n911: \n912: /* ---- 选网页 ---- */\n913: \n914: static void wifi_item_cb(lv_event_t *e)\n915: {\n916:   int idx = (int)(intptr_t)lv_event_get_user_data(e);\n917:   if (idx < 0 || idx >= g_ap_count) return;\n918: \n919:   strncpy(g_pending_ssid, g_ap_names[idx], sizeof(g_pending_ssid) - 1);\n920:   g_pending_ssid[sizeof(g_pending_ssid) - 1] = '\\0';\n921: \n922:   lv_label_set_text(g_pwd_ssid_lbl, g_ap_names[idx]);\n923:   lv_textarea_set_text(g_pwd_ta, \"\");\n924: \n925:   /* 每次选网重置\"无密码\"开关, 避免沿用上一次的状态 */\n926:   g_open_net = 0;\n927:   if (g_open_btn)\n928:     lv_obj_set_style_bg_color(g_open_btn, lv_color_hex(0x2A3A5A), 0);\n929:   if (g_open_lbl)\n930:     lv_obj_set_style_text_color(g_open_lbl, lv_color_hex(0xDDE6F5), 0);\n931:   if (g_pwd_ta) lv_obj_clear_state(g_pwd_ta, LV_STATE_DISABLED);\n932:   lv_obj_clear_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n933:   lv_obj_move_foreground(g_pwd_sheet);          /* 提到最上层, 避免被键盘遮挡 */\n934: }\n935: \n936: static void build_wifi_list(lv_obj_t *parent)\n937: {\n938:   if (g_ap_count <= 0)\n939:     {\n940:       lv_obj_t *ph = lv_label_create(parent);\n941:       lv_obj_set_width(ph, SCR_W - 32);\n942:       lv_obj_set_style_text_color(ph, lv_color_hex(0x7A8AA5), 0);\n943:       if (g_font) lv_obj_set_style_text_font(ph, g_font, 0);\n944:       lv_label_set_long_mode(ph, LV_LABEL_LONG_WRAP);\n945:       lv_label_set_text(ph, \"未找到 WiFi\\n请确认路由器已开启 2.4G\\n然后返回重进本页\");\n946:       return;\n947:     }\n948: \n949:   for (int i = 0; i < g_ap_count; i++)\n950:     {\n951:       lv_obj_t *item = lv_obj_create(parent);\n952:       lv_obj_set_width(item, SCR_W - 24);\n953:       lv_obj_set_height(item, 54);\n954:       lv_obj_set_style_bg_color(item, lv_color_hex(0x141A26), 0);\n955:       lv_obj_set_style_bg_opa(item, LV_OPA_COVER, 0);\n956:       lv_obj_set_style_bg_color(item, lv_color_hex(0x2A3A5A), LV_STATE_PRESSED);\n957:       lv_obj_set_style_border_width(item, 0, 0);\n958:       lv_obj_set_style_radius(item, 12, 0);\n959:       lv_obj_set_style_pad_left(item, 16, 0);\n960:       lv_obj_set_style_pad_right(item, 16, 0);\n961:       lv_obj_clear_flag(item, LV_OBJ_FLAG_SCROLLABLE);\n962:       lv_obj_set_flex_flow(item, LV_FLEX_FLOW_ROW);\n963:       lv_obj_set_flex_align(item, LV_FLEX_ALIGN_SPACE_BETWEEN,\n964:                             LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n965:       lv_obj_add_event_cb(item, wifi_item_cb, LV_EVENT_CLICKED,\n966:                           (void *)(intptr_t)i);\n967: \n968:       lv_obj_t *name = lv_label_create(item);\n969:       lv_obj_set_width(name, SCR_W - 24 - 32 - 30);  /* 容器内边距+右侧图标 */\n970:       lv_label_set_long_mode(name, LV_LABEL_LONG_DOT);  /* 长SSID截断, 不撑爆行 */\n971:       lv_obj_set_style_text_color(name, lv_color_hex(0xDDE6F5), 0);\n972:       if (g_font) lv_obj_set_style_text_font(name, g_font, 0);  /* 中英混排 */\n973:       lv_label_set_text(name, g_ap_names[i]);\n974: \n975:       lv_obj_t *ico = lv_label_create(item);\n976:       lv_obj_set_style_text_color(ico, lv_color_hex(0x5A6B85), 0);\n977:       lv_obj_set_style_text_font(ico, &lv_font_montserrat_16, 0);\n978:       lv_label_set_text(ico, LV_SYMBOL_WIFI);\n979:     }\n980: }\n981: \n982: static void close_wifi_page_cb(lv_event_t *e) { (void)e; close_wifi_page(); }\n983: \n984: static void open_wifi_cb(lv_event_t *e) { (void)e; open_wifi_page(); }\n985: \n986: static void build_wifi_page(lv_obj_t *parent)\n987: {\n988:   lv_obj_t *back;\n989:   lv_obj_t *bl;\n990: \n991:   g_wifi_page = lv_obj_create(parent);\n992:   lv_obj_remove_style_all(g_wifi_page);\n993:   lv_obj_set_size(g_wifi_page, SCR_W, SCR_H);\n994:   lv_obj_align(g_wifi_page, LV_ALIGN_CENTER, 0, 0);\n995:   lv_obj_set_style_bg_color(g_wifi_page, lv_color_hex(0x000000), 0);\n996:   lv_obj_set_style_bg_opa(g_wifi_page, LV_OPA_COVER, 0);\n997:   lv_obj_add_flag(g_wifi_page, LV_OBJ_FLAG_HIDDEN);\n998: \n999:   mk_label(g_wifi_page, \"选择 WiFi\", 0x9FB2CC, 24, LV_TEXT_ALIGN_CENTER);\n1000:   g_wifi_state = mk_label(g_wifi_page, \"\", 0x7A8AA5, 62, LV_TEXT_ALIGN_CENTER);\n1001: \n1002:   /* 可滚动热点列表 */\n1003:   g_wifi_list = lv_obj_create(g_wifi_page);\n1004:   lv_obj_remove_style_all(g_wifi_list);\n1005:   lv_obj_set_size(g_wifi_list, SCR_W - 16, 300);\n1006:   lv_obj_align(g_wifi_list, LV_ALIGN_TOP_MID, 0, 92);\n1007:   lv_obj_set_style_pad_all(g_wifi_list, 6, 0);\n1008:   lv_obj_set_style_pad_row(g_wifi_list, 10, 0);\n1009:   lv_obj_set_scroll_dir(g_wifi_list, LV_DIR_VER);\n1010:   lv_obj_set_flex_flow(g_wifi_list, LV_FLEX_FLOW_COLUMN);\n1011:   lv_obj_set_flex_align(g_wifi_list, LV_FLEX_ALIGN_START,\n1012:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n1013: \n1014:   /* 返回 */\n1015:   back = lv_button_create(g_wifi_page);\n1016:   lv_obj_set_size(back, 110, 44);\n1017:   lv_obj_align(back, LV_ALIGN_BOTTOM_MID, 0, -30);\n1018:   lv_obj_set_style_bg_color(back, lv_color_hex(0x1B2130), 0);\n1019:   lv_obj_set_style_radius(back, 22, 0);\n1020:   bl = lv_label_create(back);\n1021:   lv_label_set_text(bl, \"返回\");\n1022:   if (g_font) lv_obj_set_style_text_font(bl, g_font, 0);\n1023:   lv_obj_set_style_text_color(bl, lv_color_hex(0xDDE6F5), 0);\n1024:   lv_obj_center(bl);\n1025:   lv_obj_add_event_cb(back, close_wifi_page_cb, LV_EVENT_CLICKED, NULL);\n1026: \n1027:   /* 注意: 不在启动时扫描。wapi scan 会与固件 wifi_manager 的开机扫描并发,\n1028:      触发 RTL8723F 驱动 panic; 扫描只在用户打开本页(open_wifi_page)时进行 */\n1029: }\n1030: \n1031: /* ---- 密码输入面板 ---- */\n1032: \n1033: static void build_pwd_sheet(lv_obj_t *parent)\n1034: {\n1035:   lv_obj_t *cont, *t, *row, *cancel, *ok, *cl, *ol, *kb;\n1036: \n1037:   g_pwd_sheet = lv_obj_create(parent);\n1038:   lv_obj_remove_style_all(g_pwd_sheet);\n1039:   lv_obj_set_size(g_pwd_sheet, SCR_W, SCR_H);\n1040:   lv_obj_align(g_pwd_sheet, LV_ALIGN_CENTER, 0, 0);\n1041:   lv_obj_set_style_bg_color(g_pwd_sheet, lv_color_hex(0x000000), 0);\n1042:   lv_obj_set_style_bg_opa(g_pwd_sheet, LV_OPA_60, 0);\n1043:   lv_obj_clear_flag(g_pwd_sheet, LV_OBJ_FLAG_SCROLLABLE);\n1044:   lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n1045: \n1046:   cont = lv_obj_create(g_pwd_sheet);\n1047:   lv_obj_remove_style_all(cont);\n1048:   lv_obj_set_size(cont, SCR_W - 24, 190);\n1049:   lv_obj_align(cont, LV_ALIGN_TOP_MID, 0, 20);\n1050:   lv_obj_set_style_bg_color(cont, lv_color_hex(0x0E1420), 0);\n1051:   lv_obj_set_style_bg_opa(cont, LV_OPA_COVER, 0);\n1052:   lv_obj_set_style_radius(cont, 16, 0);\n1053:   lv_obj_clear_flag(cont, LV_OBJ_FLAG_SCROLLABLE);\n1054: \n1055:   t = lv_label_create(cont);\n1056:   if (g_font) lv_obj_set_style_text_font(t, g_font, 0);\n1057:   lv_obj_set_style_text_color(t, lv_color_hex(0x9FB2CC), 0);\n1058:   lv_label_set_text(t, \"输入 WiFi 密码\");\n1059:   lv_obj_set_pos(t, 16, 14);\n1060: \n1061:   g_pwd_ssid_lbl = lv_label_create(cont);\n1062:   lv_obj_set_width(g_pwd_ssid_lbl, SCR_W - 56);\n1063:   lv_label_set_long_mode(g_pwd_ssid_lbl, LV_LABEL_LONG_DOT);\n1064:   if (g_font) lv_obj_set_style_text_font(g_pwd_ssid_lbl, g_font, 0);\n1065:   lv_obj_set_style_text_color(g_pwd_ssid_lbl, lv_color_hex(0xDDE6F5), 0);\n1066:   lv_label_set_text(g_pwd_ssid_lbl, \"\");\n1067:   lv_obj_set_pos(g_pwd_ssid_lbl, 16, 44);\n1068: \n1069:   g_pwd_ta = lv_textarea_create(cont);\n1070:   lv_obj_set_size(g_pwd_ta, SCR_W - 56, 40);\n1071:   lv_obj_set_pos(g_pwd_ta, 16, 76);\n1072:   lv_textarea_set_password_mode(g_pwd_ta, true);\n1073:   lv_textarea_set_one_line(g_pwd_ta, true);\n1074:   lv_obj_set_style_text_font(g_pwd_ta, &lv_font_montserrat_16, 0);\n1075: \n1076:   row = lv_obj_create(cont);\n1077:   lv_obj_remove_style_all(row);\n1078:   lv_obj_set_size(row, SCR_W - 24, 48);\n1079:   lv_obj_set_pos(row, 0, 130);\n1080:   lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);\n1081:   lv_obj_set_flex_align(row, LV_FLEX_ALIGN_SPACE_EVENLY,\n1082:                         LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);\n1083:   lv_obj_clear_flag(row, LV_OBJ_FLAG_SCROLLABLE);\n1084: \n1085:   cancel = lv_button_create(row);\n1086:   lv_obj_set_size(cancel, 88, 36);\n1087:   lv_obj_set_style_bg_color(cancel, lv_color_hex(0x2A3A5A), 0);\n1088:   lv_obj_set_style_shadow_width(cancel, 0, 0);\n1089:   lv_obj_add_event_cb(cancel, pwd_cancel_cb, LV_EVENT_CLICKED, NULL);\n1090:   cl = lv_label_create(cancel);\n1091:   if (g_font) lv_obj_set_style_text_font(cl, g_font, 0);\n1092:   lv_obj_set_style_text_color(cl, lv_color_hex(0xDDE6F5), 0);\n1093:   lv_label_set_text(cl, \"取消\");\n1094:   lv_obj_center(cl);\n1095: \n1096:   g_open_btn = lv_button_create(row);\n1097:   lv_obj_set_size(g_open_btn, 88, 36);\n1098:   lv_obj_set_style_bg_color(g_open_btn, lv_color_hex(0x2A3A5A), 0);\n1099:   lv_obj_set_style_shadow_width(g_open_btn, 0, 0);\n1100:   lv_obj_add_event_cb(g_open_btn, open_net_cb, LV_EVENT_CLICKED, NULL);\n1101:   g_open_lbl = lv_label_create(g_open_btn);\n1102:   if (g_font) lv_obj_set_style_text_font(g_open_lbl, g_font, 0);\n1103:   lv_obj_set_style_text_color(g_open_lbl, lv_color_hex(0xDDE6F5), 0);\n1104:   lv_label_set_text(g_open_lbl, \"无密码\");\n1105:   lv_obj_center(g_open_lbl);\n1106: \n1107:   ok = lv_button_create(row);\n1108:   lv_obj_set_size(ok, 88, 36);\n1109:   lv_obj_set_style_bg_color(ok, lv_color_hex(0x1D4ED8), 0);\n1110:   lv_obj_set_style_shadow_width(ok, 0, 0);\n1111:   lv_obj_add_event_cb(ok, pwd_connect_cb, LV_EVENT_CLICKED, NULL);\n1112:   ol = lv_label_create(ok);\n1113:   if (g_font) lv_obj_set_style_text_font(ol, g_font, 0);\n1114:   lv_obj_set_style_text_color(ol, lv_color_hex(0xFFFFFF), 0);\n1115:   lv_label_set_text(ol, \"连接\");\n1116:   lv_obj_center(ol);\n1117: \n1118:   /* 虚拟键盘整屏宽贴底 */\n1119:   kb = lv_keyboard_create(g_pwd_sheet);\n1120:   lv_obj_set_size(kb, SCR_W, 180);\n1121:   lv_obj_set_style_pad_all(kb, 0, 0);\n1122:   lv_keyboard_set_textarea(kb, g_pwd_ta);\n1123: }\n1124: \n1125: /* ---- 连接与状态轮询 ---- */\n1126: \n1127: static void close_wifi_after_ok_cb(lv_timer_t *t)\n1128: {\n1129:   lv_timer_del(t);\n1130:   close_wifi_page();   /* 内部会 refresh_net_ui, 此时已连上, 直接显示二维码 */\n1131: }\n1132: \n1133: static void wifi_check_status_cb(lv_timer_t *t)\n1134: {\n1135:   g_wifi_tick++;\n1136: \n1137:   /* 必须等到真正联网(已关联 AP 且拿到 IP):\n1138:      只判断关联就收尾的话, 此时 DHCP 往往还没完成,\n1139:      关闭页面后 refresh_net_ui() 会因拿不到 IP 又显示\"未连接\"。 */\n1140:   if (net_connected())\n1141:     {\n1142:       lv_timer_del(t);\n1143:       g_wifi_timer = NULL;\n1144: \n1145:       if (g_wifi_state) lv_label_set_text(g_wifi_state, \"已连接\");\n1146:       printf(\"[eye] WiFi connected\\n\");\n1147: \n1148:       lv_timer_create(close_wifi_after_ok_cb, 1500, NULL);\n1149:       return;\n1150:     }\n1151: \n1152:   if (g_wifi_tick >= 30)\n1153:     {\n1154:       lv_timer_del(t);\n1155:       g_wifi_timer = NULL;\n1156:       if (g_wifi_state)\n1157:         lv_label_set_text(g_wifi_state, \"连接失败, 请检查密码后重试\");\n1158:       printf(\"[eye] WiFi connect timeout\\n\");\n1159:     }\n1160: }\n1161: \n1162: static void wifi_connect(const char *ssid, const char *pwd)\n1163: {\n1164:   if (g_pwd_sheet) lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n1165: \n1166:   if (g_wifi_state)\n1167:     {\n1168:       char buf[96];\n1169:       snprintf(buf, sizeof(buf), \"正在连接 %s ...\", ssid);\n1170:       lv_label_set_text(g_wifi_state, buf);\n1171:     }\n1172: \n1173:   /* 写入配置, 固件 wifi_manager 检测到后自动执行连接 */\n1174:   save_wifi_config(ssid, pwd);\n1175: \n1176:   /* 每秒轮询真实联网状态(关联 + IP), 最多 30 秒 */\n1177:   g_wifi_tick = 0;\n1178: \n1179:   /* BUG-1 修复: 先删旧 timer, 再创建新的, 避免重连时旧 timer 干扰 */\n1180:   if (g_wifi_timer != NULL)\n1181:     {\n1182:       lv_timer_del(g_wifi_timer);\n1183:       g_wifi_timer = NULL;\n1184:     }\n1185:   g_wifi_timer = lv_timer_create(wifi_check_status_cb, 1000, NULL);\n1186: }\n1187: \n1188: /* 主线程侧等待扫描结果, 期间 UI 保持刷新(眼睛动画/触摸不中断)。 */\n1189: static void wifi_scan_wait_cb(lv_timer_t *t)\n1190: {\n1191:   if (!g_scan_done)\n1192:     {\n1193:       if (++g_scan_wait > 75)            /* 200ms * 75 = 15s 硬超时 */\n1194:         {\n1195:           lv_timer_del(t);\n1196:           g_scan_timer = NULL;\n1197:           g_ap_count   = 0;\n1198: \n1199:           /* BUG-3 修复: 超时分支也要等 pthread 退出, 避免它继续写 g_ap_names */\n1200:           pthread_join(g_scan_tid, NULL);\n1201: \n1202:           build_wifi_list(g_wifi_list);\n1203:           if (g_wifi_state)\n1204:             lv_label_set_text(g_wifi_state, \"扫描超时, 请返回重进\");\n1205:         }\n1206:       return;\n1207:     }\n1208: \n1209:   lv_timer_del(t);\n1210:   g_scan_timer = NULL;\n1211:   pthread_join(g_scan_tid, NULL);\n1212: \n1213:   build_wifi_list(g_wifi_list);\n1214:   if (g_wifi_state) lv_label_set_text(g_wifi_state, \"\");\n1215:   lv_obj_invalidate(g_wifi_list);\n1216:   lv_refr_now(NULL);\n1217: }\n1218: \n1219: static void open_wifi_page(void)\n1220: {\n1221:   pthread_attr_t attr;\n1222: \n1223:   if (g_wifi_page == NULL) return;\n1224: \n1225:   /* BUG-2 修复: 先等旧扫描线程退出, 避免两个 pthread 同时写 g_ap_names */\n1226:   if (g_scan_timer != NULL)\n1227:     {\n1228:       lv_timer_del(g_scan_timer);\n1229:       g_scan_timer = NULL;\n1230:     }\n1231:   pthread_join(g_scan_tid, NULL);\n1232: \n1233:   /* 先显示页面与\"正在扫描\", 扫描转后台线程, UI 不再冻结 */\n1234:   if (g_wifi_state) lv_label_set_text(g_wifi_state, \"正在扫描...\");\n1235:   lv_obj_clear_flag(g_wifi_page, LV_OBJ_FLAG_HIDDEN);\n1236:   lv_obj_move_foreground(g_wifi_page);\n1237:   lv_refr_now(NULL);\n1238: \n1239:   lv_obj_clean(g_wifi_list);\n1240: \n1241:   g_scan_done = 0;\n1242:   g_scan_wait = 0;\n1243:   g_ap_count  = 0;\n1244: \n1245:   /* system() 会拉起 shell, 默认线程栈偏小, 显式加大 */\n1246:   pthread_attr_init(&attr);\n1247:   pthread_attr_setstacksize(&attr, 16384);\n1248:   if (pthread_create(&g_scan_tid, &attr, wifi_scan_thread, NULL) != 0)\n1249:     {\n1250:       pthread_attr_destroy(&attr);\n1251:       if (g_wifi_state) lv_label_set_text(g_wifi_state, \"扫描启动失败\");\n1252:       return;\n1253:     }\n1254:   pthread_attr_destroy(&attr);\n1255: \n1256:   if (g_scan_timer == NULL)\n1257:     g_scan_timer = lv_timer_create(wifi_scan_wait_cb, 200, NULL);\n1258: }\n1259: \n1260: static void close_wifi_page(void)\n1261: {\n1262:   if (g_wifi_page) lv_obj_add_flag(g_wifi_page, LV_OBJ_FLAG_HIDDEN);\n1263:   if (g_pwd_sheet) lv_obj_add_flag(g_pwd_sheet, LV_OBJ_FLAG_HIDDEN);\n1264:   refresh_net_ui();\n1265: }\n1266: \n1267: /****************************************************************************\n1268:  * 交互\n1269:  ****************************************************************************/\n1270: \n1271: static uint32_t down_t = 0;\n1272: static int      down_x = 0;\n1273: static int      down_y = 0;\n1274: static int      pressing = 0;\n1275: \n1276: static void touch_cb(lv_event_t *e)\n1277: {\n1278:   lv_event_code_t code = lv_event_get_code(e);\n1279:   lv_point_t      p;\n1280:   uint32_t        dt;\n1281:   int             dx;\n1282:   int             dy;\n1283: \n1284:   lv_indev_get_point(lv_indev_active(), &p);\n1285: \n1286:   if (code == LV_EVENT_PRESSED)\n1287:     {\n1288:       pressing = 1;\n1289:       down_t   = lv_tick_get();\n1290:       down_x   = p.x;\n1291:       down_y   = p.y;\n1292:     }\n1293:   else if (code == LV_EVENT_PRESSING)\n1294:     {\n1295:       if (!pressing) return;\n1296: \n1297:       /* 眼睛跟随手指 */\n1298:       g_lookx_t = ((float)p.x - SCR_W / 2.0f) / (SCR_W / 2.0f) * 0.9f;\n1299:       g_looky_t = ((float)p.y - EYE_CY) / (SCR_H / 2.0f) * 0.9f;\n1300:     }\n1301:   else if (code == LV_EVENT_RELEASED)\n1302:     {\n1303:       if (!pressing) return;\n1304: \n1305:       pressing = 0;\n1306:       dt = lv_tick_get() - down_t;\n1307:       dx = p.x - down_x;\n1308:       dy = p.y - down_y;\n1309: \n1310:       /* 顶部下滑 -> 打开设置页; 设置页内下滑 -> 关闭 */\n1311:       if (down_y < TOP_BAR_H && dy > 45 && !g_set_open)\n1312:         {\n1313:           g_lookx_t = 0; g_looky_t = 0;\n1314:           open_settings();\n1315:           return;\n1316:         }\n1317: \n1318:       if (g_set_open && dy > 45)\n1319:         {\n1320:           g_lookx_t = 0; g_looky_t = 0;\n1321:           close_settings();\n1322:           return;\n1323:         }\n1324: \n1325:       if (dt < 320 && abs(dx) < 12 && abs(dy) < 12)\n1326:         {\n1327:           set_expr((g_expr + 1) % EX_N);      /* 短按: 下一个表情 */\n1328:         }\n1329: \n1330:       g_lookx_t = 0; g_looky_t = 0;           /* 松手回正 */\n1331:     }\n1332: }\n1333: \n1334: static void btn_cb(lv_event_t *e)\n1335: {\n1336:   (void)e;\n1337:   set_expr((g_expr + 1) % EX_N);\n1338: }\n1339: \n1340: /****************************************************************************\n1341:  * 网页端管理页 (应用内置极简 HTTP 服务)\n1342:  ****************************************************************************/\n1343: \n1344: static const char *PAGE =\n1345: \"HTTP/1.1 200 OK\\r\\nContent-Type: text/html; charset=utf-8\\r\\nConnection: close\\r\\n\\r\\n\"\n1346: \"<!doctype html><meta name=viewport content='width=device-width,initial-scale=1'>\"\n1347: \"<title>OpenVela 机器人管理</title>\"\n1348: \"<body style=\\\"background:#0b0e14;color:#e6edf5;font-family:sans-serif;padding:18px;max-width:520px;margin:auto\\\">\"\n1349: \"<h2>OpenVela 机器人管理</h2>\"\n1350: \"<p>当前表情：<b id=cur>-</b></p>\"\n1351: \"<div id=btns style='display:flex;flex-wrap:wrap;gap:8px'></div>\"\n1352: \"<script>\"\n1353: \"const N=['平静','开心','大笑','眯眼','喜欢','惊讶','惊恐','难过','哭泣','生气','思考','疑惑','得意','无语','困倦','睡觉','聆听','说话','扫描','加载'];\"\n1354: \"const b=document.getElementById('btns');\"\n1355: \"N.forEach((n,i)=>{const e=document.createElement('button');e.textContent=n;\"\n1356: \"e.style.cssText='padding:9px 14px;border-radius:20px;border:1px solid #2a3a5a;background:#16203a;color:#dbe6f7;font-size:14px;cursor:pointer';\"\n1357: \"e.onclick=()=>fetch('/api/expr?i='+i).then(up);b.appendChild(e);});\"\n1358: \"function up(){fetch('/api/state').then(r=>r.json()).then(d=>{document.getElementById('cur').textContent=d.name;});}\"\n1359: \"up();setInterval(up,1000);\"\n1360: \"</script></body>\";\n1361: \n1362: static void *http_thread(void *arg)\n1363: {\n1364:   int                srv;\n1365:   int                opt = 1;\n1366:   struct sockaddr_in a;\n1367: \n1368:   (void)arg;\n1369: \n1370:   srv = socket(AF_INET, SOCK_STREAM, 0);\n1371:   if (srv < 0) return NULL;\n1372: \n1373:   setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));\n1374: \n1375:   memset(&a, 0, sizeof(a));\n1376:   a.sin_family      = AF_INET;\n1377:   a.sin_port        = htons(HTTP_PORT);\n1378:   a.sin_addr.s_addr = htonl(INADDR_ANY);\n1379: \n1380:   if (bind(srv, (struct sockaddr *)&a, sizeof(a)) < 0)\n1381:     {\n1382:       close(srv);\n1383:       return NULL;\n1384:     }\n1385: \n1386:   if (listen(srv, 4) < 0)\n1387:     {\n1388:       close(srv);\n1389:       return NULL;\n1390:     }\n1391: \n1392:   printf(\"[eye] HTTP server on port %d\\n\", HTTP_PORT);\n1393: \n1394:   while (1)\n1395:     {\n1396:       int  c = accept(srv, NULL, NULL);\n1397:       char buf[2048];\n1398:       int  n;\n1399: \n1400:       if (c < 0) continue;\n1401: \n1402:       n = recv(c, buf, (int)sizeof(buf) - 1, 0);\n1403:       if (n > 0)\n1404:         {\n1405:           buf[n] = 0;\n1406: \n1407:           if (strncmp(buf, \"GET /api/expr?i=\", 16) == 0)\n1408:             {\n1409:               const char *ok = \"HTTP/1.1 200 OK\\r\\nContent-Type: text/plain\\r\\n\"\n1410:                                \"Connection: close\\r\\n\\r\\nok\";\n1411:               g_pending_expr = atoi(buf + 16);\n1412:               send(c, ok, strlen(ok), 0);\n1413:             }\n1414:           else if (strncmp(buf, \"GET /api/state\", 14) == 0)\n1415:             {\n1416:               char body[128];\n1417:               char head[160];\n1418:               int  bl;\n1419: \n1420:               snprintf(body, sizeof(body), \"{\\\"name\\\":\\\"%s\\\"}\",\n1421:                        EXPRS[g_expr].name);\n1422:               bl = (int)strlen(body);\n1423:               snprintf(head, sizeof(head),\n1424:                        \"HTTP/1.1 200 OK\\r\\nContent-Type: application/json\\r\\n\"\n1425:                        \"Content-Length: %d\\r\\nConnection: close\\r\\n\\r\\n\", bl);\n1426:               send(c, head, strlen(head), 0);\n1427:               send(c, body, bl, 0);\n1428:             }\n1429:           else\n1430:             {\n1431:               send(c, PAGE, strlen(PAGE), 0);\n1432:             }\n1433:         }\n1434: \n1435:       close(c);\n1436:     }\n1437: \n1438:   return NULL;\n1439: }\n1440: \n1441: /****************************************************************************\n1442:  * main\n1443:  ****************************************************************************/\n1444: \n1445: int main(int argc, FAR char *argv[])\n1446: {\n1447:   lv_nuttx_dsc_t    info;\n1448:   lv_nuttx_result_t result;\n1449:   lv_obj_t         *scr;\n1450:   lv_obj_t         *btn;\n1451:   lv_obj_t         *bl;\n1452:   pthread_t         th;\n1453:   pthread_attr_t    attr;\n1454: \n1455:   (void)argc;\n1456:   (void)argv;\n1457: \n1458: #ifdef CONFIG_BOARDCTL\n1459:   boardctl(BOARDIOC_INIT, 0);\n1460: #endif\n1461: \n1462:   lv_init();\n1463: \n1464:   /* 中文字体(运行时从文件系统加载) */\n1465:   g_font = lv_binfont_create(\"/etc/fonts/font_puhui_20_4.bin\");\n1466:   if (g_font == NULL)\n1467:     {\n1468:       printf(\"[eye] Chinese font not found, using default\\n\");\n1469:       g_font = &lv_font_montserrat_16;\n1470:     }\n1471:   else\n1472:     {\n1473:       printf(\"[eye] Chinese font loaded\\n\");\n1474:     }\n1475: \n1476:   /* 显示 + 触摸 */\n1477:   lv_nuttx_dsc_init(&info);\n1478: \n1479: #ifdef CONFIG_LV_USE_NUTTX_LCD\n1480:   info.fb_path = \"/dev/lcd0\";\n1481: #endif\n1482: \n1483:   info.input_path = \"/dev/input0\";\n1484: \n1485:   lv_nuttx_init(&info, &result);\n1486:   if (result.disp == NULL)\n1487:     {\n1488:       printf(\"[eye] LVGL init failed!\\n\");\n1489:       return 1;\n1490:     }\n1491: \n1492:   scr = lv_screen_active();\n1493:   lv_obj_set_style_bg_color(scr, lv_color_hex(0x000000), 0);\n1494:   lv_obj_set_style_bg_opa(scr, LV_OPA_COVER, 0);\n1495: \n1496:   /* 眼睛画布 */\n1497:   scr_cv = lv_canvas_create(scr);\n1498:   lv_canvas_set_buffer(scr_cv, scr_buf, SCR_W, SCR_H,\n1499:                        LV_COLOR_FORMAT_ARGB8888);\n1500:   lv_obj_align(scr_cv, LV_ALIGN_CENTER, 0, 0);\n1501:   lv_obj_add_flag(scr_cv, LV_OBJ_FLAG_CLICKABLE);\n1502:   lv_obj_add_event_cb(scr_cv, touch_cb, LV_EVENT_ALL, NULL);\n1503: \n1504:   /* 底部唯一的测试按钮 */\n1505:   btn = lv_button_create(scr);\n1506:   lv_obj_set_size(btn, 140, 44);\n1507:   lv_obj_align(btn, LV_ALIGN_BOTTOM_MID, 0, -40);\n1508:   lv_obj_set_style_bg_color(btn, lv_color_hex(0x1B2130), 0);\n1509:   lv_obj_set_style_radius(btn, 22, 0);\n1510:   g_btn_lbl = lv_label_create(btn);\n1511:   lv_label_set_text(g_btn_lbl, EXPRS[g_expr].name);\n1512:   if (g_font) lv_obj_set_style_text_font(g_btn_lbl, g_font, 0);\n1513:   lv_obj_set_style_text_color(g_btn_lbl, lv_color_hex(0xDDE6F5), 0);\n1514:   lv_obj_center(g_btn_lbl);\n1515:   lv_obj_add_event_cb(btn, btn_cb, LV_EVENT_CLICKED, NULL);\n1516: \n1517:   build_settings_page(scr);\n1518:   build_wifi_page(scr);\n1519:   build_pwd_sheet(scr);\n1520: \n1521:   /* HTTP 服务线程 */\n1522:   pthread_attr_init(&attr);\n1523:   pthread_attr_setstacksize(&attr, 16384);\n1524:   if (pthread_create(&th, &attr, http_thread, NULL) != 0)\n1525:     {\n1526:       printf(\"[eye] failed to create http thread\\n\");\n1527:     }\n1528: \n1529:   lv_timer_create(anim_cb, 33, NULL);\n1530: \n1531:   srand((unsigned int)time(NULL));\n1532:   printf(\"[eye] Robot Eye ready (320x480)\\n\");\n1533: \n1534:   while (1)\n1535:     {\n1536:       uint32_t idle = lv_timer_handler();\n1537: \n1538:       idle = idle ? idle : 1;\n1539:       usleep(idle * 1000);\n1540:     }\n1541: \n1542:   lv_nuttx_deinit(&result);\n1543:   lv_deinit();\n1544:   return 0;\n1545: }\n\n(End of file - total 1545 lines)\n</content>"}
